*
* Low-key event-monitor for debugging purposes.
*
* %D
* Simple, low-key event-monitor for debugging purposes. No propagation and
* no MPI support; the saved rows use the standard McCode event-list path.
*
* %P
* INPUT PARAMETERS:
*
* nevents:  [1]   Number of events to store and save
*
* %E
*******************************************************************************/
DEFINE COMPONENT Event_monitor_simple

SETTING PARAMETERS (nevents=1e6)

DECLARE
%{
  DArray2d Events;
  long Nevents;
%}
INITIALIZE
%{
  Nevents = (long)ceil (nevents);
  if (Nevents < 0) Nevents = 0;
  Events = Nevents ? create_darr2d (Nevents, 12) : NULL;
%}

TRACE
%{

  unsigned long i = _particle->_uid;
  if (i < Nevents) {
    #pragma acc atomic write
    Events[i][1] = x;
    #pragma acc atomic write
    Events[i][2] = y;
    #pragma acc atomic write
    Events[i][3] = z;
    #pragma acc atomic write
    Events[i][4] = kx;
    #pragma acc atomic write
    Events[i][5] = ky;
    #pragma acc atomic write
    Events[i][6] = kz;
    #pragma acc atomic write
    Events[i][7] = t;
    #pragma acc atomic write
    Events[i][8] = Ex;
    #pragma acc atomic write
    Events[i][9] = Ey;
    #pragma acc atomic write
    Events[i][10] = Ez;
    #pragma acc atomic write
    Events[i][11] = p;
  }
%}

SAVE
%{
  long i;
  for (i = 0; i < Nevents; i++) Events[i][0] = i;
  DETECTOR_OUT_LIST("Event monitor events",
                    "id x y z kx ky kz t Ex Ey Ez p",
                    Nevents, 12, Nevents ? Events[0] : NULL,
                    NAME_CURRENT_COMP);
  if (Nevents) destroy_darr2d (Events);
%}

MCDISPLAY
%{
%}

END
