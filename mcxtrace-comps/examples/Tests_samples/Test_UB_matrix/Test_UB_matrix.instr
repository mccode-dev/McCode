/*******************************************************************************
* Instrument: Test_UB_matrix
*
* %I
* Written by: Peter Willendrup
* Date: October 2026
* Origin: DTU
* %INSTRUMENT_SITE: Tests_samples
*
* Test of the UB_matrix component injecting a UB matrix into Single_crystal and FluoCrystal
*
* %D
* A Si single crystal with (1,1,0) along the beam and (0,0,1) up is oriented
* in several equivalent ways, and illuminated by a white beam:
* SAMPLE=0: reference, direct lattice vectors given to Single_crystal
* SAMPLE=1: UB_matrix with a UB matrix as 9 numbers (UBin)
* SAMPLE=2: UB_matrix with the cell and two reflections
* SAMPLE=3: FluoCrystal reference, direct lattice vectors given
* SAMPLE=4: FluoCrystal, UB_matrix with UBin
* SAMPLE=5: Single_crystal, UB_matrix reading a Mantid SaveIsawUB file (UB_Si.mat)
* SAMPLE=6: Single_crystal, UB_matrix reading a UB_matrix output file (UB_Si.txt)
* SAMPLE=0-2 and 5-6 give the same Laue pattern and intensity, as do SAMPLE=3-4.
* The goniometer angle A3 rotates all samples about the vertical axis.
*
* %Test: SAMPLE=0 Detector: Laue_I=1.8306e-10
* %Test: SAMPLE=1 Detector: Laue_I=1.8306e-10
* %Test: SAMPLE=2 Detector: Laue_I=1.8306e-10
* %Test: SAMPLE=3 Detector: Laue_I=8.848e-11
* %Test: SAMPLE=4 Detector: Laue_I=8.848e-11
* %Test: SAMPLE=5 Detector: Laue_I=1.8306e-10
* %Test: SAMPLE=6 Detector: Laue_I=1.8306e-10
*
* %P
* SAMPLE: [1]  Orientation input: 0-2 Single_crystal (reference, UBin, cell + reflections), 3-4 FluoCrystal (reference, UBin), 5-6 Single_crystal (ISAW file, mccode file)
* A3: [deg]    Goniometer rotation about the vertical axis
*
* %L
* A. T. Savici, Introduction to the use of the UB matrix (ORNL, 2011)
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT Test_UB_matrix(int SAMPLE=1, A3=0)

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

COMPONENT Source = Source_flat(radius=0.0001, dist=1, focus_xw=0.0002, focus_yh=0.0002, E0=15, dE=10)
  AT (0,0,0) RELATIVE Origin

COMPONENT gonio = Arm()
  AT (0,0,1) RELATIVE Origin
  ROTATED (0,A3,0) RELATIVE Origin

COMPONENT UB_numbers = UB_matrix(target="Sample_UBin", filename="UB_numbers.txt",
    UBin={-0.130209534095, 0.130209534095, 0, 0, 0, 0.184144089067, 0.130209534095, 0.130209534095, 0})
  AT (0,0,0) RELATIVE gonio

COMPONENT UB_cell = UB_matrix(target="Sample_cell", filename="UB_cell.txt",
    lattice_a=5.43053, lattice_b=5.43053, lattice_c=5.43053,
    hkl1={1,1,0}, dir1={0,0,1}, hkl2={0,0,1}, dir2={0,1,0})
  AT (0,0,0) RELATIVE gonio

COMPONENT UB_fluo = UB_matrix(target="Sample_fluo", filename="UB_fluo.txt",
    UBin={-0.130209534095, 0.130209534095, 0, 0, 0, 0.184144089067, 0.130209534095, 0.130209534095, 0})
  AT (0,0,0) RELATIVE gonio

COMPONENT UB_isaw = UB_matrix(target="Sample_isaw", filename="UB_isaw.txt", file="UB_Si.mat", format="isaw",
    lattice_a=5.43053, lattice_b=5.43053, lattice_c=5.43053)
  AT (0,0,0) RELATIVE gonio

COMPONENT UB_mccode = UB_matrix(target="Sample_mccode", filename="UB_mccode.txt", file="UB_Si.txt", format="mccode",
    lattice_a=5.43053, lattice_b=5.43053, lattice_c=5.43053)
  AT (0,0,0) RELATIVE gonio

COMPONENT Sample_ref = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5,
    ax=-3.83996459, ay=0, az=3.83996459, bx=3.83996459, by=0, bz=3.83996459, cx=0, cy=5.43053, cz=0)
  WHEN (SAMPLE==0) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_UBin = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==1) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_cell = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==2) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_fluo_ref = FluoCrystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, material="Si.lau", mosaic=5,
    ax=-3.83996458844, ay=0, az=3.83996458844, bx=3.83996458844, by=0, bz=3.83996458844, cx=0, cy=5.43053, cz=0)
  WHEN (SAMPLE==3) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_fluo = FluoCrystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, material="Si.lau", mosaic=5)
  WHEN (SAMPLE==4) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_isaw = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==5) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_mccode = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==6) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Laue = PSD_monitor_4PI(radius=0.5, nx=180, ny=90, filename="Laue")
  AT (0,0,0) RELATIVE gonio

END
