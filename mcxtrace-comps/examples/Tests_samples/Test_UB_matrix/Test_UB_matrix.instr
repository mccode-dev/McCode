/*******************************************************************************
* Instrument: Test_UB_matrix
*
* %I
* Written by: Peter Willendrup
* Date: October 2026
* Origin: DTU
* %INSTRUMENT_SITE: Tests_samples
*
* Test of the UB_matrix component injecting a UB matrix into Single_crystal
*
* %D
* A Si single crystal with (1,1,0) along the beam and (0,0,1) up is oriented
* in three equivalent ways, and illuminated by a white beam:
* SAMPLE=0: reference, direct lattice vectors given to Single_crystal
* SAMPLE=1: UB_matrix with a UB matrix as 9 numbers (UBin)
* SAMPLE=2: UB_matrix with the cell and two reflections
* All three give the same Laue pattern and intensity. The goniometer angle A3
* rotates all samples about the vertical axis.
*
* %Example: SAMPLE=0 Detector: Laue_I=1.8484e-11
* %Example: SAMPLE=1 Detector: Laue_I=1.8484e-11
* %Example: SAMPLE=2 Detector: Laue_I=1.8484e-11
*
* %P
* SAMPLE: [1]  Orientation input: 0 reference, 1 UBin, 2 cell + reflections
* A3: [deg]    Goniometer rotation about the vertical axis
*
* %L
* A. T. Savici, Introduction to the use of the UB matrix (ORNL, 2011)
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT Test_UB_matrix(int SAMPLE=1, A3=0)

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

COMPONENT Source = Source_flat(radius=0.0001, dist=1, focus_xw=0.0002, focus_yh=0.0002, E0=15, dE=10)
  AT (0,0,0) RELATIVE Origin

COMPONENT gonio = Arm()
  AT (0,0,1) RELATIVE Origin
  ROTATED (0,A3,0) RELATIVE Origin

COMPONENT UB_numbers = UB_matrix(target="Sample_UBin", filename="UB_numbers.txt",
    UBin={-0.130209534095, 0.130209534095, 0, 0, 0, 0.184144089067, 0.130209534095, 0.130209534095, 0})
  AT (0,0,0) RELATIVE gonio

COMPONENT UB_cell = UB_matrix(target="Sample_cell", filename="UB_cell.txt",
    lattice_a=5.43053, lattice_b=5.43053, lattice_c=5.43053,
    hkl1={1,1,0}, dir1={0,0,1}, hkl2={0,0,1}, dir2={0,1,0})
  AT (0,0,0) RELATIVE gonio

COMPONENT Sample_ref = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5,
    ax=-3.83996459, ay=0, az=3.83996459, bx=3.83996459, by=0, bz=3.83996459, cx=0, cy=5.43053, cz=0)
  WHEN (SAMPLE==0) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_UBin = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==1) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample_cell = Single_crystal(xwidth=0.0005, yheight=0.0005, zdepth=0.0005, reflections="Si.lau", mosaic=5)
  WHEN (SAMPLE==2) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Laue = PSD_monitor_4PI(radius=0.5, nx=180, ny=90, filename="Laue")
  AT (0,0,0) RELATIVE gonio

END
