/*******************************************************************************
* Instrument: PUMA beam-line at SOLEIL
*
* %Identification
* Written by: Uxue Saez Fernandez
* Date: 09/2026
* Origin: SOLEIL
* %INSTRUMENT_SITE: SOLEIL
* 
* PUMA beam-line at SOLEIL
*
* %Description
* PUMA (an acronym for “Photons Used for Ancient Materials”) 
* is a hard X-ray beamline optimized for the heritage 
* science community, though not exclusively reserved for it.
* Our microbeam terminal station offers a beam size of 
* 5 (v) x 7 (PUMA_h) µm², in an energy range from 4 to 22 keV.
* Available experimental techniques include X-ray 
* fluorescence spectroscopy (XRF), X-ray absorption 
* spectroscopy (XANES), X-ray diffraction (XRD), and 
* X-ray-excited optical luminescence spectroscopy (XEOL)
*
* %Example: PUMA_E0=10 Detector: PUMA_mon_sample_e_I=1.82885e+12
*
* %Parameters
* PUMA_E0:         [keV]  Central energy selected by the DCM. Set to 0 to derive it from PUMA_DCM_theta.
* PUMA_dE:         [keV]  Half-width of the energy band emitted by the source. Reset to 3% of PUMA_E0 if PUMA_dE/PUMA_E0 > 0.1.
* PUMA_DCM_theta:  [deg]  Bragg angle of the Si DCM. Set to 0 to derive it from PUMA_E0 and (hkl).
* PUMA_HFM_angle:  [mrad] Total deflection angle of the fixed horizontally focusing mirror (HFM, Ir coating) at 21 m. The grazing incidence angle is PUMA_HFM_angle/2.
* PUMA_HFM_focal:  [m]    Image distance of the HFM, used for its bending radius. The source distance is fixed at 21 m.
* PUMA_KB_angle:   [mrad] Total deflection angle of each KB mirror (VFM and HFM). The grazing incidence angle is PUMA_KB_angle/2.
* PUMA_KB_coating: [str]  Reflectivity file for the KB mirror coating, e.g. "Rh.txt" (Rh or B4C).
* PUMA_h:          [1]    Miller index PUMA_h of the Si DCM reflection.
* PUMA_k:          [1]    Miller index PUMA_k of the Si DCM reflection.
* PUMA_l:          [1]    Miller index PUMA_l of the Si DCM reflection.
*
* %L
* <put here any reference/HTML link>
*
* %End
*******************************************************************************/


DEFINE INSTRUMENT SOLEIL_PUMA(PUMA_E0=10, PUMA_dE=0.1, PUMA_DCM_theta=0,
PUMA_HFM_angle = 1.3, PUMA_HFM_focal = 40, PUMA_KB_angle=2.9, string PUMA_KB_coating="Rh.txt",
int PUMA_h = 1, int PUMA_k = 1, int PUMA_l =1)

DECLARE
%{
    double PUMA_HFM_radius;
    double PUMA_DCM_gap;
    double PUMA_d_hkl;
    double PUMA_KB_VFM_radius;
    double PUMA_KB_HFM_radius;
%}

USERVARS
%{
    int PUMA_scat_before_VFM;
%}

INITIALIZE
%{
    PUMA_HFM_angle *= RAD2DEG/1000;
    PUMA_KB_angle *= RAD2DEG/1000;

    {
      // HFM mirror
      double p_HFM = 21.0;
      PUMA_HFM_radius = 2*p_HFM*PUMA_HFM_focal / ((p_HFM+PUMA_HFM_focal) * (sin(PUMA_HFM_angle*DEG2RAD)));

      // DCM
      double DM = 5.4309;
      PUMA_d_hkl = DM/sqrt((PUMA_h*PUMA_h) + (PUMA_k*PUMA_k) + (PUMA_l*PUMA_l));
      PUMA_DCM_gap = 0.02;

      if(!PUMA_DCM_theta && PUMA_E0){
          double sin_theta = 2 * PI/E2K/PUMA_E0 /2 /PUMA_d_hkl;
          if(fabs(sin_theta) < 1)
              PUMA_DCM_theta = asin(sin_theta)*RAD2DEG;
      }
      else if (PUMA_DCM_theta && !PUMA_E0)
          PUMA_E0 = 2*PI/E2K / (2*PUMA_d_hkl*sin(PUMA_DCM_theta*DEG2RAD));

      if(!PUMA_DCM_theta || !PUMA_E0 || PUMA_dE <= 0)
          exit(fprintf(stderr, "%s: ERROR: Monochromator can't reflect PUMA_E0=%g +/- %g [Kev].\n",
              NAME_INSTRUMENT, PUMA_E0, PUMA_dE));

      MPI_MASTER(printf("%s: PUMA_E0=%g [keV] PUMA_DCM_theta=%g [deg] (hkl)=(%d %d %d) d=%g [A]\n",
              NAME_INSTRUMENT, PUMA_E0, PUMA_DCM_theta, PUMA_h,PUMA_k,PUMA_l, PUMA_d_hkl));
      
      if (fabs(PUMA_dE/PUMA_E0) > 0.1)
          PUMA_dE = 3e-2*PUMA_E0;

      // KB VFM
      double p_KB_VFM = 62.515, q_KB_VFM = 0.785;
      PUMA_KB_VFM_radius = 2*p_KB_VFM*q_KB_VFM / ((p_KB_VFM+q_KB_VFM) * (sin(PUMA_KB_angle*DEG2RAD)));

      // KB HFM
      double p_KB_HFM = 62.975, q_KB_HFM = 0.325;
      PUMA_KB_HFM_radius = 2*p_KB_HFM*q_KB_HFM / ((p_KB_HFM+q_KB_HFM) * (sin(PUMA_KB_angle*DEG2RAD)));
    }
%}

TRACE

REMOVABLE COMPONENT PUMA_origin = Progress_bar()
AT (0, 0, 0) RELATIVE ABSOLUTE

/* -------------------------------------------------- Source */
COMPONENT PUMA_Source =Wiggler(
    E0 = PUMA_E0, dE = PUMA_dE, Ee = 2.75, Ie = 0.5,
    B = 1.8, Nper = 20, sigey = 8.5e-6/*21.5e-6*/,
    sigex = 206.5e-6/*9.3e-6*/, length = 0.1642, K = 1.37,
    focus_xw = 1.5e-3, focus_yh = 3e-3, dist = 19.4292
)
AT (0, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Vertical slit 1 */
COMPONENT PUMA_slit1 = Slit(
    xwidth=0.02, 
    yheight=3e-3//0.04
)
AT (0, 0, 19.4292) RELATIVE PREVIOUS

/* -------------------------------------------------- Horizontal slit 2 */
COMPONENT PUMA_slit2 = Slit(
    xwidth=1.5e-3,//0.02,
    yheight=0.01
)
AT (0, 0, (19.433-19.4292)) RELATIVE PREVIOUS

// Monitors
COMPONENT PUMA_mon_src_e = E_monitor(
    Emin=4, Emax=60, nE=100, restore_xray=1
)
AT (0, 0, 0) RELATIVE PREVIOUS

COMPONENT PUMA_mon_src_xy = PSD_monitor(
    xwidth=0.02, yheight=0.01, nx=100, ny=100, restore_xray=1
)
AT (0, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Mirror HFM fixed */   
COMPONENT PUMA_HFM_location = Arm()
AT (0, 0, (21 - 19.433)) RELATIVE PREVIOUS

COMPONENT PUMA_HFM_rotated = Arm()
AT(0, 0, 0) RELATIVE PUMA_HFM_location
ROTATED (0, PUMA_HFM_angle/2, 0) RELATIVE PUMA_HFM_location

/*
COMPONENT PUMA_mirror_HFM = Mirror_elliptic(
    x_a = 0, y_b = 0.0377, z_c = 30.5,
    zdepth = 1.1, xwidth = 0.01, coating = "Ir.txt"
)
AT(0, -0.0377, 0)RELATIVE PUMA_HFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_HFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}
*/
COMPONENT PUMA_mirror_HFM = Mirror_curved(
    radius = PUMA_HFM_radius, length = 1.1, 
    width = 0.01, coating = "Ir.txt"
)
AT(0, 0, 0)RELATIVE PUMA_HFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_HFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

/*
COMPONENT PUMA_mon_HFM_ellip_test_xy = COPY(PUMA_mon_src_xy)
AT (0, 0, 0.01) RELATIVE PUMA_HFM_rotated
*/
COMPONENT PUMA_HFM_out = Arm()
AT(0, 0, 0) RELATIVE PUMA_HFM_rotated
ROTATED (0, PUMA_HFM_angle/2, 0) RELATIVE PUMA_HFM_rotated

// Monitor
COMPONENT PUMA_mon_HFM_out_xy = PSD_monitor(
    xwidth=0.02, yheight=0.01, 
    nx=100, ny=100, restore_xray=1,
    filename="PUMA_Position_after_HFM_fixed_mirror"
)
AT (0, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Monochromator DCM */   
COMPONENT PUMA_DCM_location = Arm()
AT (0, 0, 22.5 - 21) RELATIVE PREVIOUS
ROTATED (0, 0, 90) RELATIVE PREVIOUS

COMPONENT PUMA_DCM_xtal1 = Bragg_crystal(
    length=0.09, width=0.025, 
    h=PUMA_h, k=PUMA_k, l=PUMA_l, material="Si.txt", V=160.1826
)
AT(0, 0, 0) RELATIVE PREVIOUS
ROTATED (-PUMA_DCM_theta, 0,  0) RELATIVE PREVIOUS
/*EXTEND %{
  if (!SCATTERED) ABSORB;
%}*/

COMPONENT PUMA_DCM_xtal1_out= Arm()
AT(0, 0, 0)RELATIVE PREVIOUS
ROTATED (-PUMA_DCM_theta, 0, 0) RELATIVE PREVIOUS

// Monitor
COMPONENT PUMA_mon_DCM_xtal1_only_xy = COPY(PUMA_mon_src_xy)
AT (0, 0, 0.01) RELATIVE PUMA_DCM_xtal1_out

COMPONENT PUMA_DCM_xtal2 = COPY(PUMA_DCM_xtal1)
AT(0, PUMA_DCM_gap, PUMA_DCM_theta ? PUMA_DCM_gap/tan(PUMA_DCM_theta*DEG2RAD) : 0) RELATIVE PUMA_DCM_xtal1
ROTATED (PUMA_DCM_theta, 0, 0)  RELATIVE PREVIOUS
/*EXTEND %{
  if (!SCATTERED) ABSORB;
%}*/

COMPONENT PUMA_DCM_xtal2_out= Arm()
AT(0, 0, 0) RELATIVE PREVIOUS
ROTATED (PUMA_DCM_theta, 0, 0)  RELATIVE PREVIOUS 

COMPONENT PUMA_mon_DCM_out_e = COPY(PUMA_mon_src_e)
AT (0, 0, 0.5) RELATIVE PREVIOUS

// Monitor
COMPONENT PUMA_mon_DCM_out_xy = PSD_monitor(
    xwidth=0.07, yheight=0.05,
    nx=100, ny=100, restore_xray=1, 
    filename="PUMA_Position_after_Mono_DCM"
)
AT (0, 0, 0) RELATIVE PREVIOUS
/* -------------------------------------------------- Vertical slit 3 */
COMPONENT PUMA_slit3 = Slit(
    xwidth=0.02, 
    yheight=3e-3
)
AT (0, 0, (23.535 - 22.5)) RELATIVE PREVIOUS

/* -------------------------------------------------- Horizontal slit 4 */
COMPONENT PUMA_slit4 = Slit(
    xwidth=1.5e-3, 
    yheight=0.01
)
AT (0, 0, (23.658 - 23.535)) RELATIVE PREVIOUS

/* -------------------------------------------------- Horizontal slit  5 */
COMPONENT PUMA_slit5 = Slit(
    xwidth=1.5e-3, 
    yheight=3e-3
)
AT (0, 0, (40 - 23.658)) RELATIVE PREVIOUS

/* -------------------------------------------------- Mirror KB VFM */   
COMPONENT PUMA_KB_VFM_location = Arm()
AT (0, 0, (62.515 - 40)) RELATIVE PREVIOUS

// Monitor
COMPONENT PUMA_mon_KB_in_xy = PSD_monitor(
    xwidth=0.05, yheight=0.03,
    nx=100, ny=100, restore_xray=1
)
AT (0, 0, 0) RELATIVE PREVIOUS

COMPONENT PUMA_KB_VFM_rotated = Arm()
AT(0, 0, 0) RELATIVE PUMA_KB_VFM_location
ROTATED (PUMA_KB_angle/2, 0, 0) RELATIVE PUMA_KB_VFM_location

/*
COMPONENT PUMA_mirror_KB_VFM = Mirror_elliptic(
    x_a = 0, y_b = 0.0203, z_c = 31.65,
    zdepth = 0.3, xwidth= 0.04,
    coating = PUMA_KB_coating // Rh or B4C
)
AT(0, 0.0203, 0)RELATIVE PUMA_KB_VFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_KB_VFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}*/


COMPONENT PUMA_mirror_KB_VFM = Mirror_curved(
    radius = PUMA_KB_VFM_radius, length = 0.3,
    width = 0.04, coating = PUMA_KB_coating // Rh or B4C
)
AT(0, 0, 0)RELATIVE PUMA_KB_VFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_KB_VFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT PUMA_KB_VFM_out = Arm()
AT(0, 0, 0) RELATIVE PUMA_KB_VFM_rotated
ROTATED (PUMA_KB_angle/2, 0, 0) RELATIVE PUMA_KB_VFM_rotated

// Monitor
COMPONENT PUMA_mon_KB_VFM_out_xy = PSD_monitor(
    xwidth=0.05, yheight=0.03,
    nx=100, ny =100, restore_xray=1,
    filename="PUMA_Position_after_KB_VFM_Mirror"
)
AT (0, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Mirror KB HFM */   
COMPONENT PUMA_KB_HFM_location = Arm()
AT (0, 0, (62.975 - 62.515)) RELATIVE PREVIOUS

COMPONENT PUMA_KB_HFM_rotated = Arm()
AT(0, 0, 0) RELATIVE PUMA_KB_HFM_location
ROTATED (0, PUMA_KB_angle/2, 0) RELATIVE PUMA_KB_HFM_location

/*
COMPONENT PUMA_mirror_KB_HFM = Mirror_elliptic(
    x_a = 0, y_b = 0.0131, z_c = 31.65,
    zdepth = 0.3, xwidth = 0.04,
    coating = PUMA_KB_coating // Rh or B4C
)
AT(0, 0, 0)RELATIVE PUMA_KB_HFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_KB_HFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}
*/

COMPONENT PUMA_mirror_KB_HFM = Mirror_curved(
    radius = PUMA_KB_HFM_radius, length = 0.3,
    width = 0.04, coating = PUMA_KB_coating // Rh or B4C
)
AT(0, 0, 0)RELATIVE PUMA_KB_HFM_rotated
ROTATED (0, 0, 0) RELATIVE PUMA_KB_HFM_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT PUMA_KB_HFM_out = Arm()
AT(0, 0, 0) RELATIVE PUMA_KB_HFM_rotated
ROTATED (0, PUMA_KB_angle/2, 0) RELATIVE PUMA_KB_HFM_rotated

// Monitor
COMPONENT PUMA_mon_KB_HFM_out_xy = PSD_monitor(
    xwidth=0.01, yheight=0.01,
    nx=100, ny=100, restore_xray=1
)
AT (0, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Sample */
COMPONENT PUMA_sample_location = Arm()
AT (-7.88e-5, 0.002366 , (63.3 - 62.975)) RELATIVE PREVIOUS

// Monitors
COMPONENT PUMA_mon_sample_xy = PSD_monitor(
    xwidth=5e-4, 
    yheight=5e-4, 
    nx=200, ny=200, restore_xray=1
)
AT (0, 0, 0) RELATIVE PREVIOUS

COMPONENT PUMA_mon_sample_e = E_monitor(
    Emin=PUMA_E0-PUMA_dE*1.1, Emax=PUMA_E0+PUMA_dE*1.1, nE=200,
    filename="PUMA_Energy_before_sample"
)
AT (0, 0, 0) RELATIVE PREVIOUS

//Sample

FINALLY
%{
%}

END
