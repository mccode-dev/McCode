/*******************************************************************************
*         McXtrace instrument definition for SIRIUS (SOLEIL)
*
* Instrument: SOLEIL_SIRIUS
*
* %Identification
* Written by: FARHI Emmanuel
* Date: September 2026
* Origin: SOLEIL
* Version: 0.1
* %INSTRUMENT_SITE: SOLEIL
*
* SOLEIL SIRIUS beamline: Soft Interfaces and Resonant Investigation on Undulator Source
*
* %Description
* SIRIUS is designed for Soft Matter research (1.4 - 13 keV). 
* It features vertical focusing primary mirrors, a fixed-exit Si(111) 
* monochromator, and a deflection mirror to enable grazing incidence 
* measurements on liquid/solid interfaces.
*
* Position | Element
* ---------|-------------------------------------------------------------
* 0        | Source: Undulator (U26)
* 14       | M1: Primary Mirror (Pd coated, vertical focusing)
* 16       | MDC1: 1st Crystal (Flat, Si 111)
* 16.01    | MDC2: 2nd Crystal (Sagittally bent, Si 111)
* 18       | Deflection Mirror (for grazing incidence)
* 30       | Sample Stage (XAS configuration)
* 35       | Sample Stage (SEXAFS configuration)
*
* %Example: SIRIUS_E0=8 Detector: SIRIUS_def_loc_I=2.14522e+10
*
* %Parameters
* SIRIUS_E0:               [keV]  Central energy (1.4 - 13 keV)
* SIRIUS_dE:               [keV]  Energy spread
* SIRIUS_M1_angle:         [mrad] Incidence angle of M1
* SIRIUS_M2_angle:         [mrad] Incidence angle of M2
* SIRIUS_def_angle:        [mrad] Deflection mirror tilt (for grazing incidence)
* SIRIUS_sample_pos:       [m]    Distance to sample (30 for XAS, 35 for SEXAFS)
* SIRIUS_sample:           [str]  Sample structure file
*
* %Link
* Documentation: APS_BL20.pdf
*******************************************************************************/

DEFINE INSTRUMENT SOLEIL_SIRIUS(SIRIUS_E0=8, SIRIUS_dE=0.1, 
  SIRIUS_M1_angle=3, SIRIUS_M2_angle=3, SIRIUS_def_angle=2.0,
  SIRIUS_sample_pos=30,
  string SIRIUS_sample="LaB6.cif", int splits=10)

DECLARE
%{
  double SIRIUS_DCM_theta;
  double SIRIUS_d_si;
  double SIRIUS_M1_radius;
  double SIRIUS_M2_radius;
  double SIRIUS_def_mirror_radius;
  double SIRIUS_dcm_gap;
%}

INITIALIZE
%{
  {
  // 1. Monochromator Setup (Si 111)
  double DM= 5.4909;     // Si d-spacing
  double d = DM/sqrt(3); // <111> reflection |<111>|=3
  double sin_theta = 2*PI/E2K/SIRIUS_E0 / 2 / d;
  SIRIUS_DCM_theta = asin(sin_theta)*RAD2DEG;
  SIRIUS_dcm_gap  = 0.01;       // gap between the 2 monochromator crystals

  // 2. Mirror Radii (Approximation based on typical vertical focusing)
  SIRIUS_M1_radius = 1000.0; 
  SIRIUS_M2_radius = 1000.0;
  SIRIUS_def_mirror_radius = 1000.0;

  MPI_MASTER(
    printf("%s: SIRIUS_E0=%g [keV] SIRIUS_DCM_theta=%g [deg]\n", NAME_INSTRUMENT, SIRIUS_E0, SIRIUS_DCM_theta);
    printf("%s: SIRIUS_M1_angle=%g [mrad] SIRIUS_M2_angle=%g [mrad] Deflect=%g [mrad]\n", NAME_INSTRUMENT, SIRIUS_M1_angle, SIRIUS_M2_angle, SIRIUS_def_angle);
  );
  
  SIRIUS_M1_angle *= RAD2DEG/1000;
  SIRIUS_M2_angle *= RAD2DEG/1000;
  SIRIUS_def_angle *= RAD2DEG/1000;
  }
%}

TRACE

REMOVABLE COMPONENT SIRIUS_origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

// -----------------------------------------------------------------------------
// SOURCE: Undulator (U26 type)
// -----------------------------------------------------------------------------
COMPONENT SIRIUS_source = Bending_magnet(
    E0 = SIRIUS_E0, dE = SIRIUS_dE,
    Ee = 2.75, Ie = 0.5, B = 1.72, sigex=60e-6, sigey=25e-6)
AT (0, 0, 0) RELATIVE PREVIOUS

// -----------------------------------------------------------------------------
// OPTICS 1: Primary Mirrors (M1 & M2 - Vertically Focusing)
// -----------------------------------------------------------------------------
COMPONENT SIRIUS_M1_loc = Monitor_nD(
  xwidth=0.02, yheight=0.02, options="x y", restore_xray=1)
AT (0, 0, 14) RELATIVE SIRIUS_source

COMPONENT SIRIUS_M1_rot = Arm()
AT (0, 0, 0) RELATIVE SIRIUS_M1_loc
ROTATED (-SIRIUS_M1_angle, 0, 0) RELATIVE SIRIUS_M1_loc

COMPONENT SIRIUS_M1 = Mirror_curved(
    length=1.3, width=0.1,
    coating="Pd.txt", radius=SIRIUS_M1_radius)
AT (0, 0, 0) RELATIVE SIRIUS_M1_rot
ROTATED (0, 0, 90) RELATIVE SIRIUS_M1_rot
EXTEND %{ 
  if (!SCATTERED) ABSORB; 
%}

COMPONENT SIRIUS_M1_out = Arm()
AT (0, 0, 0) RELATIVE SIRIUS_M1_rot
ROTATED (-SIRIUS_M1_angle, 0, 0) RELATIVE SIRIUS_M1_loc

// -----------------------------------------------------------------------------
// OPTICS 2: Fixed-exit Double Crystal Monochromator (DCM)
// -----------------------------------------------------------------------------

COMPONENT SIRIUS_DCM_location = COPY(SIRIUS_M1_loc)
AT (0, 0, 2) RELATIVE SIRIUS_M1_out // 14 + 2 = 16m

// the M1 mirror should reduce the divergence so that the beam is parallel
// when hitting the monochromators, to reduce the energy spread
COMPONENT SIRIUS_bragg_crystal = Bragg_crystal(
    length=0.2, 
    width=0.1,
    material = "Si.txt",
    h = 1, k = 1, l = 1,
    crystal_type = 2
)
AT (0, 0, 0)               RELATIVE SIRIUS_DCM_location
ROTATED (-SIRIUS_DCM_theta, 0, 0) RELATIVE SIRIUS_DCM_location
EXTEND
%{ 
	if (!SCATTERED) ABSORB;
%}

COMPONENT SIRIUS_arm_crystal1 = Arm()
AT (0, 0, 0)               RELATIVE PREVIOUS
ROTATED (-SIRIUS_DCM_theta, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- CC crystal 2 */
COMPONENT SIRIUS_bragg_crystal_two = COPY(SIRIUS_bragg_crystal)(
    length=0.2) 
AT (0, SIRIUS_dcm_gap, SIRIUS_DCM_theta ? SIRIUS_dcm_gap/tan(SIRIUS_DCM_theta*DEG2RAD) : 0) RELATIVE SIRIUS_bragg_crystal
ROTATED (SIRIUS_DCM_theta, 0, 0) RELATIVE SIRIUS_arm_crystal1
EXTEND
%{ 
	if (!SCATTERED) ABSORB;
%}

COMPONENT SIRIUS_arm_crystal2 = Arm()
AT (0, 0, 0) RELATIVE PREVIOUS
ROTATED (SIRIUS_DCM_theta, 0, 0) RELATIVE PREVIOUS

/* -------------------------------------------------- Horizontal slit 5 */
// the beam is positioned at Y=+dy*sin(2*SIRIUS_DCM_theta*DEG2RAD)/sin(SIRIUS_DCM_theta*DEG2RAD) 
// with dy=0.01 (CC gap) wrt the CC entry
COMPONENT SIRIUS_DCM_out = COPY(SIRIUS_DCM_location)(yheight=0.02)
AT (0, 0, 0.2) RELATIVE SIRIUS_arm_crystal2
ROTATED (0,0,0) RELATIVE SIRIUS_arm_crystal2          // TODO: small rotation to move beam at 0 divergence

COMPONENT SIRIUS_DCM_out_div = COPY(SIRIUS_DCM_location)(options="dx limits=[-0.5 0.5], dy limits=[-0.5 0.5]", yheight=0.2)
AT (0, 0,0) RELATIVE SIRIUS_DCM_out

COMPONENT SIRIUS_DCM_out_e = Monitor_nD(
   options="energy", xwidth=0.1, yheight=0.2, bins=512, min=SIRIUS_E0-SIRIUS_dE, max=SIRIUS_E0+SIRIUS_dE)
AT (0, 0,0) RELATIVE SIRIUS_DCM_out

// -----------------------------------------------------------------------------
// OPTICS 3: Deflection Mirror (for Grazing Incidence)
// -----------------------------------------------------------------------------
COMPONENT SIRIUS_def_loc = COPY(SIRIUS_M1_loc)
AT (0, 0, 2) RELATIVE SIRIUS_DCM_out // 16 + 2 = 18m

COMPONENT SIRIUS_def_rot = Arm()
AT (0, 0, 0) RELATIVE SIRIUS_def_loc
ROTATED (-SIRIUS_def_angle, 0, 0) RELATIVE SIRIUS_def_loc

COMPONENT SIRIUS_def_mirror = Mirror(
    xwidth=0.1, yheight=0.05)
AT (0, 0, 0) RELATIVE SIRIUS_def_rot
EXTEND %{ 
  if (!SCATTERED) ABSORB; 
%}

COMPONENT SIRIUS_def_out = Arm()
AT (0, 0, 0) RELATIVE SIRIUS_def_rot
ROTATED (-SIRIUS_def_angle, 0, 0) RELATIVE SIRIUS_def_loc

// -----------------------------------------------------------------------------
// SAMPLE STAGE
// -----------------------------------------------------------------------------
COMPONENT SIRIUS_sample_stage = COPY(SIRIUS_M1_loc)
AT (0, 0, SIRIUS_sample_pos - 18) RELATIVE SIRIUS_def_out 
EXTEND
%{ 
	if (!SCATTERED) ABSORB;
%}

SPLIT splits COMPONENT SIRIUS_fluo = FluoPowder(
    material=SIRIUS_sample,
    xwidth=0.002, yheight=0.002, zdepth=1e-5,
    p_interact=1, target_z=1)
AT (0, 0, 0) RELATIVE SIRIUS_sample_stage

// -----------------------------------------------------------------------------
// DETECTORS
// -----------------------------------------------------------------------------
// 2D Detector (CCD/Pilatus style)
COMPONENT SIRIUS_det_2d = Monitor_nD(
    radius=0.5, xwidth=0.1, yheight=0.1,
    options="theta bins=256, phi bins=256")
AT (0, 0, 1.0) RELATIVE SIRIUS_sample_stage

// Fluorescence Monitor
COMPONENT SIRIUS_det_fluo = Monitor_nD(
    radius=0.1, options="energy", bins=128)
AT (0, 0, 1.0) RELATIVE SIRIUS_sample_stage

END

