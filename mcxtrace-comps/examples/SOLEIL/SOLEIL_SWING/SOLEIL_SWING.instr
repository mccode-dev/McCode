/*******************************************************************************
* Instrument: SOLEIL_SWING
*
* %Identification
* Written by: E. Farhi, S. Bac
* Date: 2025
* Origin: SOLEIL
* Version: 0.1
* %INSTRUMENT_SITE: SOLEIL
*
* A simple model for the SWING beam-line at SOLEIL (small angle scattering, SAXS).
*
* %Description
* The SWING beamline targets soft condensed matter, conformation of
* macro-molecules in solution (BioSAXS) and material sciences. Our experimental
* set up allows simultaneous small-angle X-ray scattering (SAXS) and wide-angle
* X-ray scattering measurements (WAXS) in the 5-16 keV energy range. Anomalous
* scattering experiments can also be performed. A very large variety of types of
* samples can be studied, e.g., solutions, gels, amorphous solids, crystallized
* solids, thanks to the diversity of the proposed sample environments.
*
* This model may use any PDB file as sample, or an ideal sphere colloid for testing.
*
* Position | Element
* ---------|--------------------------------------------------------------------
* 0        | U20 undulator
* 11.7     | Diaphragm providing HxV=1x0.5 mm beam
* 20       | Si(111) DCM, 40x40x10 mm^3 SWING_E0=5-16 keV
* 22.5     | Focusing KB (HFM + VFM)
* 31       | Linear H-CRL (f=81 cm): 31 m
* 32       | Sample location
* 32.5-39  | Detector 162.5 x 155.2 mm
*
* %Example: SWING_E0=13 Detector: SWING_Eiger4M_I=128310
*
* %Parameters
* SWING_E0:             [keV]  Nominal energy at the Wiggler.
* SWING_dE:             [keV]  Energy half-bandwidth at the Wiggler
* SWING_dcm_theta:      [deg]  Rotation angle of the DCM. 0=set from energy SWING_E0
* SWING_mirror_grazing_angle: [deg] Tilt angle of the mirrors.
* SWING_hfm_radius:       [m]  Horizontally focusing mirror radius.
* SWING_vfm_radius:       [m]  Vertically focusing mirror radius.
* SWING_sample:         [str]  Sample given as a PDB file, or NULL for a 100A dilute Sphere model.
* SWING_sample_det:       [m]  Sample to detector distance in m.
*
* %Link
* https://www.synchrotron-soleil.fr/en/beamlines/swing
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT SOLEIL_SWING(SWING_E0=13, SWING_dE=0.1, SWING_dcm_theta=0,
  SWING_hfm_radius=495, SWING_vfm_radius=859, SWING_mirror_grazing_angle=4e-3,
  string SWING_sample="6lyz.pdb", SWING_sample_det=2, int splits=10)

DECLARE
%{
  double SWING_dcm_gap;
  double SWING_Lambda;
  double SWING_Ki;
  int    SWING_flag_sample_sphere;
%}

USERVARS
%{
  int    SWING_flag_hfm;
  int    SWING_flag_vfm;
%}

INITIALIZE
%{
  {
  double DM= 5.4909;     // Si d-spacing for the Monochromator
  double d = DM/sqrt(3); // <111> reflection |<111>|=3
  SWING_dcm_gap  = 0.02;       // gap between the 2 monochromator crystals
   
  if (!SWING_dcm_theta && SWING_E0) {
    // n.lambda = 2 d sin(SWING_dcm_theta) = 2*PI/E2K / SWING_E0 with n=ORDER=1
    double sin_theta = 2*PI/E2K/SWING_E0 / 2 / d;
    if (fabs(sin_theta) < 1)
      SWING_dcm_theta = asin(sin_theta)*RAD2DEG;
  } else if (SWING_dcm_theta && !SWING_E0)
    SWING_E0 = 2*PI/E2K / (2*d*sin(SWING_dcm_theta*DEG2RAD));
  if (!SWING_dcm_theta || !SWING_E0 || SWING_dE <=0)
    exit(fprintf(stderr, "%s: ERROR: Monochromator can not reflect SWING_E0=%g +/- %g [keV]. Aborting.\n", NAME_INSTRUMENT, SWING_E0, SWING_dE));
  SWING_Ki     = SWING_E0*E2K;
  SWING_Lambda = 2*PI/SWING_Ki;
  MPI_MASTER(
    printf("%s: SWING_E0=%g [keV] SWING_Ki=%g [1/Angs] SWING_Lambda=%g [Angs] Monochromator SWING_dcm_theta=%g [deg]\n", 
      NAME_INSTRUMENT, SWING_E0, SWING_dcm_theta, SWING_Ki, SWING_Lambda);
    if (!strlen(SWING_sample) || !strcmp(SWING_sample,"0") || !strcmp(SWING_sample,"NULL")) {
      SWING_flag_sample_sphere=1;
      printf("%s: Using ideal sample %s\n", NAME_INSTRUMENT, "Sphere colloid");
      strcpy(SWING_sample, "6lyz.pdb"); // avoid stop at init of SAXSPDBFast
    } else {
      SWING_flag_sample_sphere=0;
      printf("%s: Using PDB sample %s\n", NAME_INSTRUMENT, SWING_sample);
    }
  );
  if (fabs(SWING_dE/SWING_E0)>0.1) SWING_dE = 3e-2*SWING_E0;
  }
%}

TRACE

// electronic beam spec along storage ring 354m diameter
// BeamLineName| Long_Pos(m)| RMS_H_Size(µm)| RMS_V_Size(µm)| RMS_H_div(µrad)| RMS_V_div(µrad)
// -----|--------|---|---|--|--
// SWING|232,5058|321|9,4|17|3,5
REMOVABLE COMPONENT SWING_origin = Progress_bar()
AT (0, 0, 0) RELATIVE ABSOLUTE

// the photon source -----------------------------------------------------------
COMPONENT SWING_Source_U20 = Undulator(
    E0 = SWING_E0,
    dE = SWING_dE,
    Ee = 2.75,
    Ie = 0.5,
    K = 5,
    sigex = 388e-6,
    sigey = 8.1e-6,
    sigepx = 14.5e-6,
    sigepy = 4.61e-6)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT SWING_mon_src_xy = Monitor_nD(
  options="x y", xwidth=2e-3, yheight=2e-3, bins=128)
AT (0,0,11.7) RELATIVE SWING_Source_U20

COMPONENT SWING_mon_src_e = Monitor_nD(options="energy", xwidth=2e-3, yheight=2e-3, bins=128,
  min=SWING_E0-SWING_dE*1.1, max=SWING_E0+SWING_dE*1.1)
AT (0,0,0) RELATIVE PREVIOUS

// Diaphragm
COMPONENT SWING_slit = Slit(xwidth=1e-3, yheight=0.5e-3)
AT (0,0,0.1) RELATIVE PREVIOUS

COMPONENT SWING_slit_mon_xy = COPY(SWING_mon_src_xy)
AT (0,0,0) RELATIVE PREVIOUS

// The double monochromator ----------------------------------------------------
COMPONENT SWING_DCM_location = Arm()
AT (0,0,20) RELATIVE SWING_Source_U20

COMPONENT SWING_dcm_xtal0 = Bragg_crystal(
    length=0.04,      width=0.04, 
    h=1, k=1, l=1, material="Si.txt", V=160.1826)
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (-SWING_dcm_theta,0,0) RELATIVE PREVIOUS
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SWING_dcm0      = Arm()
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (-SWING_dcm_theta,0,0) RELATIVE PREVIOUS

COMPONENT SWING_dcm_xtal1 = COPY(SWING_dcm_xtal0)
AT(0,SWING_dcm_gap, SWING_dcm_theta ? SWING_dcm_gap/tan(SWING_dcm_theta*DEG2RAD) : 0)    RELATIVE SWING_dcm_xtal0
ROTATED (SWING_dcm_theta,0,0)  RELATIVE PREVIOUS
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SWING_dcm1      = Arm()
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (SWING_dcm_theta,0,0)  RELATIVE PREVIOUS 

COMPONENT SWING_mon_dcm_e = COPY(SWING_mon_src_e)
AT (0,0,0.5) RELATIVE PREVIOUS

COMPONENT SWING_mon_dcm_xy = COPY(SWING_mon_src_xy)
AT (0,0,0) RELATIVE PREVIOUS

// KB pair ---------------------------------------------------------------------
// could use Mirror_elliptic
// incidence angle 4 mrad

// KB 1st mirror (XZ plane) at 1.6m from sample
// must be shifted by -2 mm  on Y else beam flies underneath the mirror.
COMPONENT SWING_vfm_location = COPY(SWING_mon_src_xy)
AT (0,0,22.5-20.5) RELATIVE SWING_mon_dcm_xy

COMPONENT SWING_vfm_in_xz_plane = Arm()
AT (0,0,0) RELATIVE SWING_vfm_location
ROTATED(0,0,-90) RELATIVE SWING_vfm_location // YZ -> XZ

COMPONENT SWING_vfm = Mirror_curved(
  coating="Rh.txt",
  length=450e-3,
  width=0.1,
  radius=SWING_vfm_radius)
AT (0,0,0) RELATIVE SWING_vfm_location
ROTATED(0,-SWING_mirror_grazing_angle,0) RELATIVE SWING_vfm_in_xz_plane
EXTEND %{
  SWING_flag_vfm=SCATTERED;
%}

COMPONENT SWING_vfm_takeoff = COPY(SWING_vfm_location)
AT (0,0,0) RELATIVE SWING_vfm_in_xz_plane
ROTATED (-2*SWING_mirror_grazing_angle, 0, 0) RELATIVE SWING_vfm_location

// KB 2nd mirror (YZ) at 1m from sample, shift height=4.8 mm 
COMPONENT SWING_hfm_location = COPY(SWING_vfm_location)
AT (0,0,34.5-33.9) RELATIVE SWING_vfm_takeoff

// 859 m tangential; sagital > 1 km, in YZ plane
COMPONENT SWING_hfm = Mirror_curved(
  coating="Rh.txt",
  length=450e-3,
  width=0.1,
  radius=SWING_hfm_radius)
AT (0,0,0) RELATIVE SWING_hfm_location
ROTATED (0,-SWING_mirror_grazing_angle,0) RELATIVE SWING_hfm_location
EXTEND %{
  SWING_flag_hfm=SCATTERED;
%}

COMPONENT SWING_hfm_takeoff = COPY(SWING_vfm_location)
AT (0,0,0) RELATIVE SWING_hfm_location
ROTATED (0,-2*SWING_mirror_grazing_angle,0) RELATIVE SWING_hfm_location
EXTEND %{
  if (!SWING_flag_hfm || !SWING_flag_vfm) ABSORB;
%}


// The sample area -------------------------------------------------------------
// align surface so that the beam hits its centre (shift along Y axis)
SPLIT splits COMPONENT SWING_sample_stage = COPY(SWING_mon_src_xy)(xwidth=0.01, yheight=0.01,
  restore_xray=1)
AT (1e-3,-1.54e-3,32-22.5) RELATIVE SWING_hfm_takeoff

COMPONENT SWING_sample_test = Saxs_spheres(
    R = 100, Phi = 0.1, Delta_rho = 1.6,
    yheight = 1e-3, radius = 0.25e-3, focus_xw = 1,
    focus_yh = 1, sphere_mtrl="Be.txt")
WHEN( SWING_flag_sample_sphere )
AT (0,0,0) RELATIVE SWING_sample_stage
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SWING_sample = SAXSPDBFast(
  xwidth  = 0.01,
  yheight = 0.01,
  zdepth  = 0.01,
  SampleToDetectorDistance = SWING_sample_det,
  DetectorRadius = 0.16*1.41, 
  PDBFilepath = SWING_sample,
  NumberOfQBins=2000,
  qMax = 0.9)
WHEN( !SWING_flag_sample_sphere )
AT (0,0,0) RELATIVE SWING_sample_stage
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SWING_sample_out = Arm()
AT (0,0,0)       RELATIVE SWING_sample_stage

COMPONENT SWING_Eiger4M = Monitor_nD(xwidth=0.5, yheight=0.5, bins=1024,
  options="x y")
AT (0,0,SWING_sample_det) RELATIVE SWING_sample_stage

COMPONENT SWING_QMonitor = SAXSQMonitor(
  RadiusDetector     = 0.22,
  DistanceFromSample = SWING_sample_det,
  LambdaMin          = SWING_Lambda,
  Lambda0            = SWING_Lambda,
  NumberOfBins       = 2000
)
AT (0,0,SWING_sample_det) RELATIVE SWING_sample_stage


END
