/*******************************************************************************
* Instrument: CASSIOPEE beamline at SOLEIL
*
* %Identification
* Written by: François Bertran
* Date: 11/03/2022
* Origin: SOLEIL
* Version: 0.2
* %INSTRUMENT_SITE: SOLEIL
*
* CASSIOPEE beamline at SOLEIL
*
* %Description
* CASSIOPEE : Combined Angle- and Spin-resolved SpectroscopIes Of PhotoEmitted Electrons
*
* The CASSIOPEE beamline is dedicated to photoemission experiments in the 8 eV -
* 1500 eV photon energy range. The beamline uses two undulators, and the main
* optical elements are the entrance optics and the monochromator. After the
* monochromator, the beamline is divided into two branches, supplying photons to
* two endstations (Spin-resolved Photoemission, and High Resolution Angle-resolved
* Photoemission), both connected to a Molecular Beam Epitaxy chamber.
*
* Position | Element
* ---------|--------------------------------------------------------------------
* 0        | Undulator HU60 / HU256
* 21.83    | Plane mirror M1a
* 22.18    | Spherical mirror M1b
* 28.83    | Plane grating (reflection)
* 29.02    | Plane mirror M2
* 30.83    | Slit
*
* %Example: CASSIOPEE_E0=0 Detector: CASSIOPEE_PSD_M1out_I=2.74309e+15
*
* %Parameters
* CASSIOPEE_E0:              [keV] Undulator emission energy, e.g. 40e-3 or 300e-3 keV. 0=auto
* CASSIOPEE_lambda:          [Ang] Undulator emission wavelength. Used when CASSIOPEE_E0=0.
* CASSIOPEE_dE:              [keV] Undulator energy bandwidth, e.g. 1e-3.
* CASSIOPEE_mirror_material: [str] Mirror M1 coating (e.g. Pt.dat)
* CASSIOPEE_undulator_index: [1-2] Undulator 1=HU60; 2=HU256
* CASSIOPEE_M1_angle:        [deg] M1 mirror angle. 0=auto
* CASSIOPEE_PG_angle:        [deg] Reflective grating monochromator. 0=auto
* CASSIOPEE_PM_angle:        [deg] M2 mirror angle. 0=auto
* CASSIOPEE_beta_mono:       [deg] Monochromator angle. 0=auto
* CASSIOPEE_r_rho:           [/mm] Grating number of lines/mm. 0=auto.
* 
* %L
* https://www.synchrotron-soleil.fr/en/beamlines/cassiopee
* %Link
* https://www.researchgate.net/deref/https%3A%2F%2Ftel.archives-ouvertes.fr%2Ftel-01064523
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT SOLEIL_CASSIOPEE (
  string CASSIOPEE_mirror_material = "Pt.dat", 
  int CASSIOPEE_undulator_index =1, 
  CASSIOPEE_M1_angle = 0,
  CASSIOPEE_PG_angle = 0, 
  CASSIOPEE_PM_angle = 0, 
  CASSIOPEE_E0 = 0, CASSIOPEE_dE=1e-3,
  CASSIOPEE_lambda = 0, 
  CASSIOPEE_beta_mono = 0, 
  CASSIOPEE_r_rho = 0)


INITIALIZE
%{
#define sqr(x) ((x)*(x))

double cos_alpha= 0;
double c        = 0.2;  // Petersen law coefficient sin(b) / sin(a) = c = 0.2 */
double order    = 1;

{ // use block to protect local variables
  // source choice
  if (!CASSIOPEE_E0 && !CASSIOPEE_lambda) {
    if (CASSIOPEE_undulator_index == 1)      CASSIOPEE_E0 = 300e-3;
    else if (CASSIOPEE_undulator_index == 2) CASSIOPEE_E0 = 40e-3;
  }

  if (CASSIOPEE_lambda && !CASSIOPEE_E0) CASSIOPEE_E0     = 1.24125e-6/CASSIOPEE_lambda;
  else if (!CASSIOPEE_lambda && CASSIOPEE_E0) CASSIOPEE_lambda = 1.24125e-6/CASSIOPEE_E0;

  if (!CASSIOPEE_M1_angle) CASSIOPEE_M1_angle = (CASSIOPEE_undulator_index == 1 ? 2.44 : 5.02); // degrees
  if (!CASSIOPEE_r_rho)    CASSIOPEE_r_rho    = (CASSIOPEE_undulator_index == 1 ? 1600 : 400 ); // lines/mm

  /* grating deviation angles */
  cos_alpha = (-CASSIOPEE_r_rho*CASSIOPEE_lambda + sqrt( sqr(c*CASSIOPEE_r_rho*CASSIOPEE_lambda) + sqr(1 - sqr(c)) ))/(1 - sqr(c) );

  if (!CASSIOPEE_PG_angle)  // alpha angle = incoming, order = 0
    CASSIOPEE_PG_angle  = RAD2DEG*acos( cos_alpha );
    
  if (!CASSIOPEE_beta_mono) // beta angle  = outging,  order = 1
    CASSIOPEE_beta_mono = RAD2DEG*acos( cos_alpha + order*CASSIOPEE_r_rho*CASSIOPEE_lambda );

  if (!CASSIOPEE_PM_angle) 
    CASSIOPEE_PM_angle = (CASSIOPEE_PG_angle + CASSIOPEE_beta_mono)/2;
}

MPI_MASTER(
printf("%s: Undulator %s CASSIOPEE_E0=%g [eV] CASSIOPEE_lambda=%g [Angs] CASSIOPEE_M1_angle=%g [deg] CASSIOPEE_PG_angle=%g [deg] CASSIOPEE_PM_angle=%g [deg]\n", 
  NAME_INSTRUMENT,
  CASSIOPEE_undulator_index == 1 ? "HU60":"HU256",
  CASSIOPEE_E0, CASSIOPEE_lambda, 
  CASSIOPEE_M1_angle, CASSIOPEE_PG_angle, CASSIOPEE_PM_angle);
);

%}


TRACE

// electronic beam spec along storage ring 354m diameter
// BeamLineName| Long_Pos(m)| RMS_H_Size(µm)| RMS_V_Size(µm)| RMS_H_div(µrad)| RMS_V_div(µrad)
// -----------|--------|-----|----|----|--
// CASSIOPEE_1|308,0047|217,4|10,6|31,4|4,2
// CASSIOPEE_2|310,6492|214,7|8,2 |31,4|4,2
REMOVABLE COMPONENT CASSIOPEE_Origin = Progress_bar() 
AT (0, 0, 0) ABSOLUTE

/* -------------------------------------------------- Source HU60 */
COMPONENT CASSIOPEE_Source_HU60 = Undulator(
    E0 = CASSIOPEE_E0,
    dE = 1e-3,
    Ee = 2.75,
    Ie = 0.5,
    K = 5,
    sigex = 217.4e-6,
    sigey = 10.6e-6,
    sigepx = 31.4e-6,
    sigepy = 4.2e-6)
WHEN CASSIOPEE_undulator_index == 1
AT (0, 0, 0) RELATIVE PREVIOUS



/* -------------------------------------------------- Source HU256 */

COMPONENT CASSIOPEE_Source_HU256 = Undulator(
    E0 = CASSIOPEE_E0,
    dE = 1e-3,
    Ee = 2.75,
    Ie = 0.5,
    K = 5,
    sigex = 214.7e-6,
    sigey = 8.2e-6,
    sigepx = 31.4e-6,
    sigepy = 4.2e-6)
WHEN CASSIOPEE_undulator_index == 2
AT (0, 0, 2.727) RELATIVE PREVIOUS

/* -------------------------------------------------- Plane mirror M1a */
/* dimensions 130x25 mm (e=60 mm) */

COMPONENT CASSIOPEE_M1a_location = Arm()
AT (0, 0, 21.83)          RELATIVE CASSIOPEE_Source_HU60

COMPONENT CASSIOPEE_M1a = Mirror_curved( // in YZ plane
  coating = CASSIOPEE_mirror_material,
  zdepth  = 0.130,
  yheight = 0.025,
  radius  = 0                 // flat
)
AT (0, 0, 0)             RELATIVE CASSIOPEE_M1a_location
ROTATED (0, CASSIOPEE_M1_angle, 0) RELATIVE CASSIOPEE_M1a_location

COMPONENT CASSIOPEE_M1a_out = Arm()
AT (0,0,0)                 RELATIVE CASSIOPEE_M1a_location
ROTATED (0, 2*CASSIOPEE_M1_angle, 0) RELATIVE CASSIOPEE_M1a_location

/* -------------------------------------------------- Spherical mirror M1b */
/* dimensions 150x25 mm (e=60 mm) radius 108.4 m */

COMPONENT CASSIOPEE_M1b = Mirror_curved(
    coating = CASSIOPEE_mirror_material,
    radius  = -108.4,
    length  = 0.150,
    width   = 0.025
)    
WHEN CASSIOPEE_undulator_index == 2
AT (0, 0, 0.352)         RELATIVE CASSIOPEE_M1a_out
ROTATED (0, -CASSIOPEE_M1_angle, 0) RELATIVE CASSIOPEE_M1a_out


/* -------------------------------------------------- Spherical mirror M1c */
/* dimensions 160x25 mm (e=60 mm) radius 120 m */

COMPONENT CASSIOPEE_M1c = Mirror_curved(
    coating = CASSIOPEE_mirror_material,
    radius  = -120,
    length  = 0.160,
    width   = 0.025
)  
WHEN CASSIOPEE_undulator_index == 1  
AT (0, 0, 0.352+0.357)   RELATIVE CASSIOPEE_M1a_out
ROTATED (0, -CASSIOPEE_M1_angle, 0) RELATIVE CASSIOPEE_M1a_out

COMPONENT CASSIOPEE_M1bc_out = Arm()
AT (0,0,0) RELATIVE PREVIOUS
ROTATED (0, -CASSIOPEE_M1_angle, 0) RELATIVE PREVIOUS

/* --------------------------------------------------- Grating 1
/* dimensions 95x40 mm, 400 lines/mm, horizontal, 6 m de M1a */

COMPONENT CASSIOPEE_PSD_M1out = Monitor_nD(xwidth=1e-3, yheight=1e-3, bins=512,
  options = "x y")
AT (0,0,3) RELATIVE PREVIOUS

COMPONENT CASSIOPEE_PG_location = Arm()
AT (0,0, 6 - 0.352 - 0.357) RELATIVE CASSIOPEE_M1bc_out

/* Monochromator grating ---------------------------------------------------- */
/* cos(a) - cos(b) = N.k.CASSIOPEE_lambda ; N=CASSIOPEE_r_rho; k=order; a=incident; b=outgoing    */
/* we use the Petersen law: sin(b) / sin(a) = 0.2                             */
/* beam deviation is alpha+beta                                               */
/* Grating_reflect(d_phi=1,order=0,rho_l=100,zdepth=102e-3,xwidth=102e-3)     */

COMPONENT CASSIOPEE_PG = Grating_reflect(
   zdepth = 0.095,
   xwidth = 0.040,
   d_phi  = 2,
   order  = 1,
   rho_l  = CASSIOPEE_r_rho
)
AT (0,0, 0) RELATIVE CASSIOPEE_PG_location
ROTATED (CASSIOPEE_PG_angle, 0, 0) RELATIVE CASSIOPEE_PG_location



/* --------------------------------------------------- Grating 2
/* dimensions 95x40 mm, 800 lines/mm, horizontal, 6 m from M1a */

/* --------------------------------------------------- Grating 3
/* dimensions 95x40 mm, 1600 lines/mm, horizontal, 6 m from M1a */

/* -------------------------------------------------- Plane mirror M2 */
/* dimensions 320x30 mm (e=60 mm)
 * rotation axis is 10 mm under the grating, 20 mm under the surface mirror
 * (which is face down) and 190 mm before the mirror centre
 * => the beam is deflected by 20 mm upwards
 */

COMPONENT CASSIOPEE_M2_rotation_axis = Monitor_nD(xwidth=1e-2, yheight=1e-2,
  options="x y", bins=512)
AT (0, -0.01, 0) RELATIVE CASSIOPEE_PG_location

COMPONENT CASSIOPEE_M2 = Mirror(
coating = CASSIOPEE_mirror_material,
zdepth = 0.320,
xwidth = 0.030
    )
AT (0, 0.02, .190) RELATIVE CASSIOPEE_M2_rotation_axis
ROTATED (-CASSIOPEE_PM_angle, 0, 0) RELATIVE CASSIOPEE_M2_rotation_axis

COMPONENT CASSIOPEE_PM_takeoff = Arm()
AT (0,0,0) RELATIVE CASSIOPEE_M2
ROTATED (0,0,0) RELATIVE CASSIOPEE_Source_HU256

/* -------------------------------------------------- Horizontal slit */
/* 2 microns aperture at 2 mm
 * located 3 m from the grating, i.e. 9 m from M1a 
 */

COMPONENT CASSIOPEE_slit = Slit(
    )
AT (-0.062, 0, 30.83) RELATIVE CASSIOPEE_Source_HU256	

/* Refocalisation branche 1 */

/* --------------------------------------------------- Toroidal mirror M3 */
/* dimensions 300x35 mm (e=60 mm)
 * located 3 m from the slit  and at 7.5 m from experimental station CX1
 * R = 180 m, r = 0.15 m, déviation 4° 
 */


/* Refocalisation branche 2 */

/* ---------------------------------------------------- Spherical mirror M4 */
/* dimensions 320x35 mm (e=40 mm)
 * located à 7 m after the slit, radius = 94.88 m, deviation 5.8 deg 
 */

COMPONENT CASSIOPEE_M4 = Mirror_curved(
    coating = CASSIOPEE_mirror_material)    
AT (0, 0, 0) RELATIVE PREVIOUS	
ROTATED (0, 0, 0) RELATIVE CASSIOPEE_Source_HU256

/* -------------------------------------------------- Toroidal mirror M5 */
/* dimensions 300x35 mm (e=40 mm)
 * located 0.4 m from M4 and 2 m from experimental station CX2
 * R = 263.65 m, r = 0.165 m, deviation 6 deg 
 */

COMPONENT CASSIOPEE_PSD = Monitor_nD(xwidth=1e-2, yheight=1e-2,
  options = "x y")
AT (0,0,0.5) RELATIVE PREVIOUS

END
