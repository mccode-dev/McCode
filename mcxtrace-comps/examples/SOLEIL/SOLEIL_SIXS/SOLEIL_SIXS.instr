/*******************************************************************************
* Instrument: SOLEIL_SIXS
*
* %Identification
* Written by: E. Farhi, A. Resta, A. Coati
* Date: 2023
* Origin: SOLEIL
* Version: 0.1
* %INSTRUMENT_SITE: SOLEIL
*
* A simple model for the SIXS beam-line at SOLEIL (surface diffraction).
*
* %Description
*
* SixS (Surface Interface X-ray Scattering) is a beamline dedicated to the study
* of X-ray scattering from surfaces and interfaces of hard and soft matter in
* various environments in the 5-20 keV energy range. To be sensitive to the
* surface all the studies are performed in grazing-incidence geometry. The
* beamline is equipped with two experimental hutches, which ae dedicated to the
* study of surfaces, interfaces and nano-objets prepared:
*
* - in-situ under UHV (Ultra High Vacuum, i.e. 10-10 mbar) conditions. A 
*   diffractometer allows to measure X-ray scattering from samples under UHV;
* - in various environments (catalysis chambers, soft matter, electrochemical
*   cells). A diffractometer coupled with exchangeable chambers will be able to
*   measure X-ray scattering from sample surfaces both in vertical or horizontal
*   geometries.
*
* Grazing Incidence X-ray Diffraction (GIXD), Grazing Incidence Small Angle
* X-ray Scattering (GISAXS), anomalous surface X-ray scattering, X-Ray
* Reflectivity (XRR), magnetic surface X-ray scattering and coherent scattering
* experiments are performed on both the facilities.
*
* In this implementation, the multipurpose diffractometer is used, with a thin
* single crystal layer on top of a Si bulk.
*
* Position | Element
* ---------|--------------------------------------------------------------------
* 0        | the U20 undulator
* 15       | Slit S1 2x0.7 mm^2
* 16.5     | a Si(111) DCM, 40x40x10 mm^3 SIXS_E0=5-20 keV
* 26       | Mirror M1 Si coated with Pd, elliptically vertical focusing 20x350x20 mm^3 Incident angle 0.175 deg (3 mrad)
* 28       | Mirror M2 at 20x550x20mm^3. (tilted 45 deg exchange horz/vert components for UHV)
* 33       | multipurpose diffractometer
* 42       | UHV diffractometer (not modelled here)
*
* Example: SIXS_E0=13 Detector: SIXS_detector_bulk_I=3.37342e+09
*
* %Parameters
* SIXS_E0:             [keV]  Nominal energy at the Wiggler.
* SIXS_dE:             [keV]  Energy half-bandwidth at the Wiggler
* SIXS_dcm_theta:      [deg]  Rotation angle of the DCM. 0=set from energy SIXS_E0
* SIXS_M1_angle:       [mrad] Rotation angle of M1/M2 mirrors. When left as 0, it is set automatically from SIXS_E0.
* SIXS_M1_radius:      [m]    Curvature radius of M1 mirror (Rh, 1300x100) longitudinal. Positive=mirror is focusing. 0=flat.
* SIXS_M2_radius:      [m]    Curvature radius of M2 mirror (Rh, 1300x100) sagittal. Positive=mirror is focusing. 0=flat.
* SIXS_sample_coating: [str]  Reflection/structure data file for the single crystal thin layer coating
* SIXS_sample_bulk:    [str]  Reflection/structure data file for the single crystal bulk
* SIXS_sample_thickness: [m]  The single crystal thin layer coating thickness
* SIXS_sample_angle:   [deg]  The sample tilt angle (around X axis)
*
* %Link
* https://www.synchrotron-soleil.fr/en/beamlines/sixs
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT SOLEIL_SIXS(SIXS_E0=13, SIXS_dE=0.1, SIXS_dcm_theta=0, 
  SIXS_M1_angle=3, SIXS_M1_radius=1400, SIXS_M2_radius=1400,
  string SIXS_sample_coating="Mo.lau", string SIXS_sample_bulk="Si.lau", 
  SIXS_sample_thickness=50e-10, SIXS_sample_angle=0.175, int splits=10)

DECLARE
%{
  double SIXS_dcm_gap;
%}

USERVARS
%{
  int    SIXS_flag_scatt;
%}

INITIALIZE
%{
  {
    double DM= 5.4909;     // Si d-spacing for the Monochromator
    double d = DM/sqrt(3); // <111> reflection |<111>|=3
    SIXS_dcm_gap  = 0.02;       // gap between the 2 monochromator crystals
     
    if (!SIXS_dcm_theta && SIXS_E0) {
      // n.lambda = 2 d sin(SIXS_dcm_theta) = 2*PI/E2K / SIXS_E0 with n=ORDER=1
      double sin_theta = 2*PI/E2K/SIXS_E0 / 2 / d;
      if (fabs(sin_theta) < 1)
        SIXS_dcm_theta = asin(sin_theta)*RAD2DEG;
    } else if (SIXS_dcm_theta && !SIXS_E0)
      SIXS_E0 = 2*PI/E2K / (2*d*sin(SIXS_dcm_theta*DEG2RAD));
    if (!SIXS_dcm_theta || !SIXS_E0 || SIXS_dE <=0)
      exit(fprintf(stderr, "%s: ERROR: Monochromator can not reflect SIXS_E0=%g +/- %g [keV]. Aborting.\n", NAME_INSTRUMENT, SIXS_E0, SIXS_dE));
    MPI_MASTER(
    printf("%s: SIXS_E0=%g [keV] Monochromator SIXS_dcm_theta=%g [deg] \n", NAME_INSTRUMENT, SIXS_E0, SIXS_dcm_theta);
    );
    if (fabs(SIXS_dE/SIXS_E0)>0.1) SIXS_dE = 3e-2*SIXS_E0;
    SIXS_M1_angle *= RAD2DEG/1000;
    
    if (!strlen(SIXS_sample_coating) || strcmp(SIXS_sample_coating,"0") || strcmp(SIXS_sample_coating,"NULL")) {
      SIXS_sample_thickness=0;
    }
  }
%}

TRACE

// electronic beam spec along storage ring 354m diameter
// BeamLineName| Long_Pos(m)| RMS_H_Size(µm)| RMS_V_Size(µm)| RMS_H_div(µrad)| RMS_V_div(µrad)
// ----|--------|-----|---|----|--
// SIXS|298,7982|325,5|9,5|17,2|3,3
REMOVABLE COMPONENT SIXS_origin = Progress_bar()
AT (0, 0, 0) RELATIVE ABSOLUTE

// the photon source -----------------------------------------------------------
COMPONENT SIXS_Source_U20 = Undulator(
    E0 = SIXS_E0,
    dE = SIXS_dE,
    Ee = 2.75,
    Ie = 0.5,
    K = 5,
    sigex = 388e-6,
    sigey = 8.1e-6,
    sigepx = 14.5e-6,
    sigepy = 4.61e-6)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT SIXS_mon_src_xy = Monitor_nD(
  options="x y", xwidth=2e-3, yheight=2e-3, bins=128)
AT (0,0,14.9) RELATIVE SIXS_Source_U20

COMPONENT SIXS_mon_src_e = Monitor_nD(options="energy", xwidth=2e-3, yheight=2e-3, bins=128,
  min=SIXS_E0-SIXS_dE*1.1, max=SIXS_E0+SIXS_dE*1.1)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT SIXS_slit = Slit(xwidth=2e-3, yheight=0.7e-3)
AT (0,0,0.1) RELATIVE PREVIOUS

COMPONENT SIXS_slit_mon_xy = COPY(SIXS_mon_src_xy)
AT (0,0,0) RELATIVE PREVIOUS

// The double monochromator ----------------------------------------------------
COMPONENT SIXS_DCM_location = Arm()
AT (0,0,16.5) RELATIVE SIXS_Source_U20

COMPONENT SIXS_dcm_xtal0 = Bragg_crystal(
    length=0.04, width=0.04, 
    h=1, k=1, l=1, material="Si.txt", V=160.1826)
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (-SIXS_dcm_theta,0,0) RELATIVE PREVIOUS
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SIXS_dcm0      = Arm()
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (-SIXS_dcm_theta,0,0) RELATIVE PREVIOUS

COMPONENT SIXS_dcm_xtal1 = COPY(SIXS_dcm_xtal0)
AT(0,SIXS_dcm_gap, SIXS_dcm_theta ? SIXS_dcm_gap/tan(SIXS_dcm_theta*DEG2RAD) : 0)    RELATIVE SIXS_dcm_xtal0
ROTATED (SIXS_dcm_theta,0,0)  RELATIVE PREVIOUS
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SIXS_dcm1      = Arm()
AT(0,0,0)          RELATIVE PREVIOUS
ROTATED (SIXS_dcm_theta,0,0)  RELATIVE PREVIOUS 

COMPONENT SIXS_mon_dcm_e = COPY(SIXS_mon_src_e)
AT (0,0,0.5) RELATIVE PREVIOUS

COMPONENT SIXS_mon_dcm_xy = COPY(SIXS_mon_src_xy)
AT (0,0,0) RELATIVE PREVIOUS

// M1 location -----------------------------------------------------------------
COMPONENT SIXS_M1_location = Arm()
AT(0,0,26-16.5-0.5) RELATIVE SIXS_mon_dcm_e

COMPONENT SIXS_M1_rotated = Arm()  // rotation of the mirror
AT(0,0,0)               RELATIVE SIXS_M1_location
ROTATED (-SIXS_M1_angle,0,0) RELATIVE SIXS_M1_location

// should image the slit to get a parallel beam.
COMPONENT SIXS_M1 = Mirror_curved( // 90 deg brings it from YZ (vert) to XZ (horiz)
    length=.350, width=0.2,
    coating="Pd.txt", radius=SIXS_M1_radius)
AT(0,0,0)           RELATIVE SIXS_M1_rotated
ROTATED (0, 0, 90) RELATIVE SIXS_M1_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SIXS_M1_out = Arm()      // 2-theta direction
AT(0,0,0)               RELATIVE SIXS_M1_rotated
ROTATED (-SIXS_M1_angle,0,0) RELATIVE SIXS_M1_rotated

// M2 mirror -------------------------------------------------------------------

COMPONENT SIXS_M2_location = Arm()
AT (0,0,28-26) RELATIVE SIXS_M1_out

COMPONENT SIXS_M2_rotated = Arm()  // rotation of the mirror
AT(0,0,0)                      RELATIVE SIXS_M2_location
ROTATED (SIXS_M1_angle,0,0) RELATIVE SIXS_M2_location

COMPONENT SIXS_M2 = Mirror_curved( // bring it from YZ to XZ (horiz)
    length=0.550, width=.2,
    coating="Pd.txt", radius=SIXS_M2_radius)
AT(0,0,0)         RELATIVE SIXS_M2_rotated
ROTATED (0, 0, -90) RELATIVE SIXS_M2_rotated
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT SIXS_M2_out = Arm()      // 2-theta direction
AT(0,0,0) RELATIVE SIXS_M2_rotated
ROTATED (SIXS_M1_angle,0,0) RELATIVE SIXS_M2_rotated



// The sample area -------------------------------------------------------------
// align surface so that the beam hits its centre (shift along Y axis)
SPLIT splits COMPONENT SIXS_sample_stage = COPY(SIXS_mon_src_xy)
AT (0,0,33-28) RELATIVE PREVIOUS
EXTEND %{
  SIXS_flag_scatt = 0;
%}

COMPONENT SIXS_sx_layer = Single_crystal(
  reflections=SIXS_sample_coating, xwidth=2e-3, yheight=SIXS_sample_thickness, zdepth=0.01,
  surf_size=-1, mosaic=1e-4, sigma_inc=0, p_transmit = 0.1)
WHEN SIXS_sample_thickness>0
AT (0,-SIXS_sample_thickness/2,0) RELATIVE SIXS_sample_stage
ROTATED (SIXS_sample_angle,0,0)   RELATIVE SIXS_sample_stage
EXTEND %{
  if (SCATTERED) SIXS_flag_scatt++;
%}

COMPONENT SIXS_sx_bulk  = Single_crystal(
  reflections=SIXS_sample_bulk, xwidth=2e-3, yheight=1e-3, zdepth=0.01, 
  surf_size=-1, mosaic=1e-4, sigma_inc=0)
AT (0,-1e-3/2,0) RELATIVE PREVIOUS /* just below the thin layer */
EXTEND %{
  if (SCATTERED) SIXS_flag_scatt += 2;
%}

COMPONENT SIXS_sample_out = Arm()
AT (0,0,0)       RELATIVE SIXS_sample_stage
EXTEND %{
  if (!SIXS_flag_scatt) ABSORB;
%}

COMPONENT SIXS_det4pi = Monitor_nD(radius=1, options="theta phi", bins=2048)
AT (0,0,0) RELATIVE SIXS_sample_stage

COMPONENT SIXS_detector_layer = COPY(SIXS_det4pi)
WHEN (SIXS_flag_scatt == 1 || SIXS_flag_scatt == 3)
AT (0,0,0) RELATIVE SIXS_sample_stage

COMPONENT SIXS_detector_bulk  = COPY(SIXS_det4pi)
WHEN (SIXS_flag_scatt > 1)
AT (0,0,0) RELATIVE SIXS_sample_stage


END
