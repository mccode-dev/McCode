/*******************************************************************************
*         McXtrace instrument definition
*
* Instrument: Test the generic event-list output API with McXtrace
*
* %Identification
* Written by: McCode development
* Date: 18 September 2026
* Origin: DTU
* %INSTRUMENT_SITE: Tests_other
*
* %Description
* Minimal McXtrace companion for the flavor-neutral EventOutList component.
* The source is only needed to exercise McXtrace code generation; the fixture
* writes deterministic rows from SAVE.
*
* %Example: mcxtrace_test
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_EventOutList_mcxtrace()

TRACE

COMPONENT src = Source_pt(focus_xw=0.1, focus_yh=0.1, dist=1, lambda0=1)
  AT (0, 0, 0) ABSOLUTE

COMPONENT events = EventOutList(nevents=3, ncols=3, filename="ListMulti")
  AT (0, 0, 0.1) RELATIVE PREVIOUS

END
