/*******************************************************************************
*
* McXtrace, X-ray tracing package
*         Copyright, All rights reserved
*         DTU Physics, Kgs. Lyngby, Denmark
*         Synchrotron SOLEIL, Saint-Aubin, France
*
* Component: Source_lab_xrl
*
* %Identification
* Written by: Erik B. Knudsen (original Source_lab), xraylib port derived from it
* Date: May 2012 (original), 2026 (xraylib version)
* Version: 1.1
* Origin: Kgs. Lyngby
*
* Laboratory x-ray source, using xraylib for all material data.
*
* %Description
* Model of a laboratory x-ray tube, generating x-rays by bombarding a target by electrons.
* Given a input energy E0 of the electron beam, x-rays are emitted from the accessible emission lines
* The geometry of the tube is assumed to be:
* # The electron beam hits a slab of surface material surface at a right angle illuminating an area of width by height,
* # where width is measured along the component X-axis.
* # The centre of the electron beam at the anode surface is the origin of the component.
* # The Z-axis of the component points at the centre of the exit window (focus_xw by focus yh)
* placed at a distance dist from the origin.
* # The angle between the Z-axis and the anode surface is the take_off angle.
* For a detailed sketch of the geometry see the component manual.
*
* The Bremsstrahlung emitted is modelled using the model of Kramer (1923) as restated in International
* Tables of Crystallography C 4.1
*
* Characteristic radiation (K-lines Ka1, Ka2, Kb1, Kb3) is modelled by Lorentzian (default) or Gaussian
* energy profiles. Line energies, level widths (FWHM = K level width + final level width) and relative
* intensities (radiative rates, strongest line = 1) are obtained from xraylib for ANY mono-atomic anode;
* no datafile is needed. Lines that fall outside [Emin,Emax] are dropped.
*
* Absorption of emitted x-rays while travelling through the target anode is included, using the xraylib
* total mass attenuation coefficient (tabulated once in INITIALIZE on a log grid, with extra points
* on both sides of every absorption edge, and interpolated log-log in TRACE).
*
* Example: Source_lab(material="Cu",Emin=1, E0=80)
* Legacy:  Source_lab(material_datafile="Cu.txt",Emin=1, E0=80)
*
* %Parameters
* material:   [string] Anode element, symbol ("Cu", "W", ...) or atomic number as a string ("29").
* material_datafile: [string] Legacy parameter, kept for backward compatibility with Source_lab. Only the
*             file NAME is used: the element is taken from it ("Cu.txt", "../data/Mo.txt" -> "Cu", "Mo");
*             the file is not read. If set, it overrides 'material'.
* width:      [m]    Width of electron beam impinging on the anode.
* height:     [m]    Height of electron beam impinging on the anode.
* xwidth:     [m]    Width of the anode material slab (0: practically infinite).
* yheight:    [m]    Height of the anode material slab (0: practically infinite).
* thickness:  [m]    Thickness of the anode material slab.
* take_off:   [deg]  Take off angle of beam centre.
* dist:       [m]    Distance between centre of illuminated target and exit window.
* E0:         [kV]   Acceleration voltage of xray tube.
* tube_current: [A]  Electron beam current.
* Emax:       [keV]  Maximum energy to sample. Default (Emax=0) is to set it to E0.
* Emin:       [keV]  Minimum energy to sample.
* focus_xw:   [m]    Width of exit window.
* focus_yh:   [m]    Height of exit window.
* frac:       [0-1]  Fraction of statistic to use for Bremsstrahlung.
* lorentzian: [0/1]  If nonzero Lorentzian (more correct) line profiles are used.
* exit_window_refpt: [m] If set, the AT position and exit window will coincide (legacy behaviour).
*
* %End
*************************************************************************/

DEFINE COMPONENT Source_lab

SETTING PARAMETERS (string material="Cu", width=1e-3, height=1e-3, thickness=100e-6, 
    E0=20, Emax=0, Emin=1, focus_xw=5e-3, focus_yh=5e-3,
    take_off=6, dist=1, tube_current=1e-3, frac=0.1, lorentzian=1, 
    xwidth=0, yheight=0, exit_window_refpt=0, string material_datafile="" )

/* X-ray parameters: (x,y,z,kx,ky,kz,phi,t,Ex,Ey,Ez,p) */

DEPENDENCY " @XRLFLAGS@ -DUSE_OFF "
NOACC

SHARE
%{
  #ifndef MX_SOURCE_LAB_XRL
  #define MX_SOURCE_LAB_XRL
  #include <xraylib/xraylib.h>
  #include <ctype.h>
  #include <string.h>

  #define SLX_MAXLINES 8
  #define SLX_NGRID 1000

  /* returns 1 if the xraylib call succeeded; otherwise frees/resets the error and returns 0 */
  static int slx_ok (xrl_error** err) {
    if (*err) {
      xrl_error_free (*err);
      *err = NULL;
      return 0;
    }
    return 1;
  }

  static int slx_cmp (const void* a, const void* b) {
    double da = *(const double*)a, db = *(const double*)b;
    return (da > db) - (da < db);
  }

  /* log-log interpolation of mu [m^-1] at energy E [keV] on the table (lE=log(E), lmu=log(mu)) */
  static double slx_mu (const double* lE, const double* lmu, int n, double E) {
    double le = log (E);
    int lo = 0, hi = n - 1;
    double f;
    if (le <= lE[0]) return exp (lmu[0]);
    if (le >= lE[n - 1]) return exp (lmu[n - 1]);
    while (hi - lo > 1) {
      int mid = (lo + hi) / 2;
      if (lE[mid] > le) hi = mid; else lo = mid;
    }
    f = (le - lE[lo]) / (lE[hi] - lE[lo]);
    return exp (lmu[lo] + f * (lmu[hi] - lmu[lo]));
  }
  #endif // def MX_SOURCE_LAB_XRL
%}

DECLARE
%{
  Rotation R_xray_gen;
  Rotation R_xray_geni;
  Coords O_xray_gen;
  char mat_name[64]; /* resolved element symbol / atomic number */
  int Z;
  double rho;
  double Ek;
  double Icont;
  double Ichar;
  double p_continous;
  double pmul_c;
  double mu_electron;
  double BKRAMER;

  /* characteristic lines (per instance) */
  int nlines;
  double l_e[SLX_MAXLINES];    /* energy [keV] */
  double l_w[SLX_MAXLINES];    /* FWHM [keV] */
  double l_sig[SLX_MAXLINES];  /* gaussian sigma [keV] */
  double l_wgt[SLX_MAXLINES];  /* relative intensity x fraction of line inside [Emin,Emax] */
  double l_umin[SLX_MAXLINES]; /* lorentzian sampling limits */
  double l_umax[SLX_MAXLINES];

  /* tabulated attenuation */
  int nmu;
  double* mu_lE;
  double* mu_lmu;
%}

INITIALIZE
%{
  int ii, jj, s;
  xrl_error* err = NULL;

  BKRAMER = 2e-6; /*photons /keV /electron*/

  if (E0 <= 0) {
    fprintf (stderr, "Error %s: Impinging electron energy (E0) must be >0, was %g\n", NAME_CURRENT_COMP, E0);
    exit (-1);
  }
  if (!Emax) { /*if Emax is not set use the impinging electron energy*/
    Emax = E0;
  }
  if (Emin <= 0) {
    fprintf (stderr, "Error (%s): Emin must be > 0 (%g)\n", NAME_CURRENT_COMP, Emin);
    exit (-1);
  }
  if (Emax < Emin) {
    fprintf (stderr, "Error (%s): Nonsensical emission energy interval [Emin,Emax]=[%g %g] at E0=%g\n", NAME_CURRENT_COMP, Emin, Emax, E0);
    exit (-1);
  }

  /* ---- select the anode element ---- */
  mat_name[0] = '\0';
  if (material_datafile && strlen (material_datafile)) {
    /* backward compatibility: derive the element from a legacy datafile name,
       e.g. "Cu.txt" or "../data/Mo.txt" -> "Cu" / "Mo". The file itself is NOT read. */
    const char* base = material_datafile;
    const char* sl1 = strrchr (material_datafile, '/');
    const char* sl2 = strrchr (material_datafile, '\\');
    int n = 0;
    if (sl1) base = sl1 + 1;
    if (sl2 && sl2 + 1 > base) base = sl2 + 1;
    if (isdigit ((unsigned char)base[0])) {
      while (isdigit ((unsigned char)base[n]) && n < (int)sizeof (mat_name) - 1) {
        mat_name[n] = base[n];
        n++;
      }
    } else {
      while (isalpha ((unsigned char)base[n]) && n < (int)sizeof (mat_name) - 1) {
        mat_name[n] = (n == 0) ? toupper ((unsigned char)base[n]) : tolower ((unsigned char)base[n]);
        n++;
      }
    }
    mat_name[n] = '\0';
    if (!n) {
      fprintf (stderr, "Error (%s): cannot derive an element from material_datafile '%s'\n", NAME_CURRENT_COMP, material_datafile);
      exit (-1);
    }
    if (material && strlen (material) && strcmp (material, mat_name))
      fprintf (stderr, "Warning (%s): material_datafile '%s' overrides material='%s' (using '%s')\n", NAME_CURRENT_COMP, material_datafile, material, mat_name);
  } else if (material && strlen (material)) {
    strncpy (mat_name, material, sizeof (mat_name) - 1);
    mat_name[sizeof (mat_name) - 1] = '\0';
  } else {
    fprintf (stderr, "Error (%s): set 'material' (element symbol or atomic number) or 'material_datafile'\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  /* ---- material data from xraylib ---- */
  Z = atoi (mat_name);
  if (Z <= 0) {
    Z = SymbolToAtomicNumber (mat_name, &err);
    if (!slx_ok (&err) || Z <= 0) {
      fprintf (stderr, "Error (%s): unknown element '%s'\n", NAME_CURRENT_COMP, mat_name);
      exit (-1);
    }
  }
  rho = ElementDensity (Z, &err); /* g/cm3 */
  if (!slx_ok (&err) || rho <= 0) {
    fprintf (stderr, "Error (%s): xraylib has no density for Z=%d (mono-atomic anodes only)\n", NAME_CURRENT_COMP, Z);
    exit (-1);
  }
  Ek = EdgeEnergy (Z, K_SHELL, &err);
  if (!slx_ok (&err) || Ek <= 0) {
    fprintf (stderr, "Error (%s): xraylib has no K edge for Z=%d\n", NAME_CURRENT_COMP, Z);
    exit (-1);
  }

  /*Integrate the continuous spectrum and the characteristic so as to get the relative intensities right*/
  Icont = tube_current / CELE * BKRAMER * Z * (E0 * log (Emax) - E0 * log (Emin) - Emax + Emin);

  nlines = 0;
  p_continous = 1;
  /*check if E0 > Ek. If not, no characteristic emission can take place*/
  if (E0 > Ek) {
    const int lines[4]  = { KL2_LINE, KL3_LINE, KM2_LINE, KM3_LINE };    /* Ka2, Ka1, Kb3, Kb1 */
    const int fshell[4] = { L2_SHELL, L3_SHELL, M2_SHELL, M3_SHELL };    /* final-state level */
    double Bk = 1.2e-5 * pow (Ek, 1.67) * exp (-0.077 * Z);
    double Ichar_tot = 0;
    double iref = RadRate (Z, KL3_LINE, &err);
    double wK = AtomicLevelWidth (Z, K_SHELL, &err);
    if (!slx_ok (&err) || iref <= 0) {
      fprintf (stderr, "Error (%s): xraylib has no K-line data for Z=%d\n", NAME_CURRENT_COMP, Z);
      exit (-1);
    }
    Ichar = tube_current / CELE * 4 * M_PI * (E0 / Ek - 1) * Bk;

    for (ii = 0; ii < 4 && nlines < SLX_MAXLINES; ii++) {
      double e, r, wf, w, fw, umin, umax, sig;
      e = LineEnergy (Z, lines[ii], &err);
      if (!slx_ok (&err) || e <= 0) continue;
      r = RadRate (Z, lines[ii], &err);
      if (!slx_ok (&err) || r <= 0) continue;
      wf = AtomicLevelWidth (Z, fshell[ii], &err);
      if (!slx_ok (&err)) wf = 0;
      w = wK + wf; /* keV, FWHM */
      if (w <= 0) w = 1e-3;
      sig = w / (2 * sqrt (2 * log (2.0)));
      umin = atan (2 * (Emin - e) / w) / M_PI;
      umax = atan (2 * (Emax - e) / w) / M_PI;
      if (lorentzian) {
        fw = umax - umin;
      } else {
        fw = 0.5 * (erf ((Emax - e) / (sig * M_SQRT2)) - erf ((Emin - e) / (sig * M_SQRT2)));
      }
      if (fw < 1e-3) continue; /* line (essentially) outside the energy window - do not use */
      l_e[nlines] = e;
      l_w[nlines] = w;
      l_sig[nlines] = sig;
      l_umin[nlines] = umin;
      l_umax[nlines] = umax;
      l_wgt[nlines] = (r / iref) * fw;
      Ichar_tot += l_wgt[nlines];
      nlines++;
    }
    if (nlines > 0) {
      if (frac <= 0 || frac >= 1) {
        fprintf (stderr, "Error (%s): frac must be in ]0,1[ when characteristic lines are emitted (was %g)\n", NAME_CURRENT_COMP, frac);
        exit (-1);
      }
      p_continous = Icont / (Ichar * Ichar_tot + Icont);
    }
  }
  if (nlines == 0) {
    /*characteristic K-emission is not possible (or outside window)*/
    p_continous = 1;
    frac = 1;
  }

  /* ---- tabulate mass attenuation (converted to m^-1) on a log grid + both sides of every edge ---- */
  {
    int nmax = SLX_NGRID + 2 * 9;
    double* Eg = (double*)malloc (nmax * sizeof (double));
    mu_lE = (double*)malloc (nmax * sizeof (double));
    mu_lmu = (double*)malloc (nmax * sizeof (double));
    if (!Eg || !mu_lE || !mu_lmu) {
      fprintf (stderr, "Error (%s): out of memory\n", NAME_CURRENT_COMP);
      exit (-1);
    }
    nmu = 0;
    for (ii = 0; ii < SLX_NGRID; ii++) {
      Eg[nmu++] = Emin * pow (Emax / Emin, ii / (double)(SLX_NGRID - 1));
    }
    for (s = K_SHELL; s <= M5_SHELL; s++) {
      double Ee = EdgeEnergy (Z, s, &err);
      if (!slx_ok (&err) || Ee <= 0) continue;
      if (Ee * (1 - 1e-6) > Emin && Ee * (1 + 1e-6) < Emax) {
        Eg[nmu++] = Ee * (1 - 1e-6);
        Eg[nmu++] = Ee * (1 + 1e-6);
      }
    }
    qsort (Eg, nmu, sizeof (double), slx_cmp);
    for (jj = 0; jj < nmu; jj++) {
      double mu = CS_Total (Z, Eg[jj], &err) * rho * 1e2; /* cm2/g * g/cm3 -> cm^-1 -> m^-1 */
      if (!slx_ok (&err) || mu <= 0) {
        fprintf (stderr, "Error (%s): xraylib has no cross section for Z=%d at E=%g keV\n", NAME_CURRENT_COMP, Z, Eg[jj]);
        exit (-1);
      }
      mu_lE[jj] = log (Eg[jj]);
      mu_lmu[jj] = log (mu);
    }
    free (Eg);
  }

  O_xray_gen = coords_set (0, 0, 0);
  rot_set_rotation (R_xray_gen, -take_off * DEG2RAD, 0, 0);
  rot_set_rotation (R_xray_geni, take_off * DEG2RAD, 0, 0);

  pmul_c = 1.0 / (mcget_ncount ());

  mu_electron = 0;
%}

TRACE
%{
  double x1, y1, z1, r, e, k, pdir, pmul;
  /* pick a point in the generating volume*/
  x1 = rand01 () * width - width / 2.0;
  z1 = rand01 () * height - height / 2.0;
  /* y is the absorption depth of the electron getting converted to an xray*/
  y1 = (mu_electron > 0) ? log (rand01 () + 1e-300) * mu_electron : 0;

  double px, py, pz;
  Coords P;

  /* transform initial coords to ones in a frame with origin at the center of e-beam with optical axis pointing towards exit window*/
  P = coords_set (x1, y1, z1);
  P = coords_add (rot_apply (R_xray_gen, P), O_xray_gen);
  coords_get (P, &x, &y, &z);

  /*randvec_target_rect_real computes a target point and a solid angle correction factor, hence the k-vector has to be computed from
    generation point and target point. The (0,0,1) location of the target is due to a silent assumption in randvec() that
    the target cannot be situated in the origin.*/
  randvec_target_rect_real (&px, &py, &pz, &pdir, 0, 0, dist, focus_xw, focus_yh, R_xray_gen, x1, y1, z1, 2);
  /*k is parallell to the line between generation and target points*/
  kx = px - x1;
  ky = py - y1;
  kz = pz - z1;

  /*Now for wavelength selection*/
  r = rand01 ();
  if (r < frac) {
    /*bremsstrahlung*/
    e = rand01 () * (Emax - Emin) + Emin;
    k = e * E2K;
    pmul = tube_current / CELE * BKRAMER * Z * (E0 / e - 1);
    /*correct for not having the full E-window*/
    pmul *= (Emax - Emin) / E0;
    /*correct for monte-carlo statistics*/
    pmul *= p_continous / frac;
  } else {
    /*characteristic radiation: first pick one of the active lines (uniformly)*/
    int lineno = (int)floor (rand01 () * nlines);
    if (lineno >= nlines) lineno = nlines - 1; /*we might get overflow*/

    /* l_wgt already contains the fraction of the line inside [Emin,Emax];
       the factor nlines compensates for the uniform line choice */
    pmul = l_wgt[lineno] * Ichar * nlines;
    if (!lorentzian) {
      /*truncated gaussian by rejection*/
      e = randnorm () * l_sig[lineno] + l_e[lineno];
      while (e < Emin || e > Emax) {
        e = randnorm () * l_sig[lineno] + l_e[lineno];
      }
    } else { /* tan((rand-0.5)/pi) is Lorentzian; map the random range onto [Emin,Emax] */
      e = tan (((l_umax[lineno] - l_umin[lineno]) * rand01 () + l_umin[lineno]) * M_PI) * l_w[lineno] / 2 + l_e[lineno];
      if (e < Emin) e = Emin;
      if (e > Emax) e = Emax;
    }
    k = E2K * e;
    pmul *= (1 - p_continous) / (1 - frac);
  }

  /*scale k accordingly*/
  NORM (kx, ky, kz);
  kx *= k;
  ky *= k;
  kz *= k;

  /*set the x-ray weight to whatever we computed just before and correct for only sampling the exit window, and correct for number of issued photons*/
  p = pmul * pmul_c;

  int ie;
  /*Correct for absorption*/
  double mu_abs, l0, l1, lx, ly, lz, klx, kly, klz, xw, yh;
  l0 = 0;
  l1 = 0;
  /*if dimensions are set the anode has a limited size - otherwise use a
    practically infinite slab*/
  xw = xwidth ? xwidth : FLT_MAX;
  yh = yheight ? yheight : FLT_MAX;
  coords_get (rot_apply (R_xray_geni, coords_set (x, y, z)), &lx, &ly, &lz);
  coords_get (rot_apply (R_xray_geni, coords_set (kx, ky, kz)), &klx, &kly, &klz);
  /*find path length inside anode material*/
  ie = box_intersect (&l0, &l1, lx, ly + thickness / 2.0, lz, klx, kly, klz, xw, thickness, yh);
  if (!ie || l0 > 0) {
    /*photon is somehow outside the anode - this should not happen*/
    ABSORB;
  }

  mu_abs = slx_mu (mu_lE, mu_lmu, nmu, k * K2E); /* m^-1 */
  p *= exp (-l1 * mu_abs);
  /*set a random phase*/
  phi = rand01 () * 2 * M_PI;

  /*Finally, if exit_window_refpt is set revert to legacy behaviour where the centre of the exit window is the
    reference point of the component*/
  if (exit_window_refpt) {
    z = z - dist;
  }
  /*set a scatter pt at the generation pt*/
  SCATTER;
%}

FINALLY
%{
  if (mu_lE) free (mu_lE);
  if (mu_lmu) free (mu_lmu);
%}

MCDISPLAY
%{
  int i, a, b;
  double X[8], Y[8], Zc[8];
  /* in legacy mode the source point sits at z=-dist relative to the exit window (see TRACE) */
  double zoff = exit_window_refpt ? -dist : 0;
  /* anode drawing size: the real slab if given, otherwise a few beam sizes */
  double aw = xwidth ? xwidth : 3 * width;
  double ah = yheight ? yheight : 3 * height;
  Coords C;

  /* illuminated spot on the anode surface (rotated rectangle) */
  for (i = 0; i < 4; i++) {
    double sx = (i == 1 || i == 2) ? width / 2.0 : -width / 2.0;
    double sz = (i >= 2) ? height / 2.0 : -height / 2.0;
    C = coords_add (rot_apply (R_xray_gen, coords_set (sx, 0, sz)), O_xray_gen);
    coords_get (C, &X[i], &Y[i], &Zc[i]);
    Zc[i] += zoff;
  }
  for (i = 0; i < 4; i++) {
    b = (i + 1) % 4;
    line (X[i], Y[i], Zc[i], X[b], Y[b], Zc[b]);
  }

  /* anode slab: spans y in [-thickness,0] of the anode frame (same convention as box_intersect in TRACE).
     It is tilted by take_off, hence 12 edges with line() rather than box(). */
  for (a = 0; a < 8; a++) {
    double sx = (a & 1) ? aw / 2.0 : -aw / 2.0;
    double sy = (a & 2) ? 0 : -thickness;
    double sz = (a & 4) ? ah / 2.0 : -ah / 2.0;
    C = coords_add (rot_apply (R_xray_gen, coords_set (sx, sy, sz)), O_xray_gen);
    coords_get (C, &X[a], &Y[a], &Zc[a]);
    Zc[a] += zoff;
  }
  for (a = 0; a < 8; a++) {
    for (b = 1; b <= 4; b <<= 1) {
      if (!(a & b)) line (X[a], Y[a], Zc[a], X[a | b], Y[a | b], Zc[a | b]);
    }
  }

  /* electron beam (dashed, along the anode normal) and the optical axis to the exit window */
  C = coords_add (rot_apply (R_xray_gen, coords_set (0, 5 * (width > height ? width : height), 0)), O_xray_gen);
  coords_get (C, &X[0], &Y[0], &Zc[0]);
  dashed_line (X[0], Y[0], Zc[0] + zoff, 0, 0, zoff, 5);
  dashed_line (0, 0, zoff, 0, 0, zoff + dist, 5);

  /* exit window */
  rectangle ("xy", 0, 0, exit_window_refpt ? 0 : dist, focus_xw, focus_yh);
%}

END
