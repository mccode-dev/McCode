*         Synchrotron SOLEIL, Saint-Aubin, France
*
* Component: Mirror_elliptic
* 
* %Identification
* Written by: Erik Knudsen
* Date: Feb 11, 2010
* Version: $Revision$
* Origin: Risoe
* Modified by: Bac Stephane, Padovani Antoine, 09th May 2022 : melded Bragg_crystal_bent.comp into here.
*
* Idealized elliptic mirror.
* 
* %Description
* Takes a reflectivity as input and reflects rays in a ideal geometry
* elliptic mirror.
* The mirror is positioned such that the a-axis of the mirror ellipsoid is on the
* x-axis, the b-axis is along the y-axis and the c is along the z-axis.
* The reference point of the mirror is the ellipsoid centre, offset by one 
* half-axis along the y-axis (See the component manual for a drawing). 
* This means that to position the mirror correctly, the user positions the 
* ellipsoid governing the mirror shape, not the mirror itself.
*
* Only the lower half of the ellipsoid (y < y_b) is the mirror surface. Rays are
* reflected from both sides of the surface: from the concave (inner) side, and
* from the convex (back) side, which de-focuses the beam. The reflectivity only
* depends on the grazing angle, and not on the side.
* The complex reflectivity is applied: its modulus scales the ray weight and its
* argument is added to the ray phase.
*
* The foci of the ellipsoid are situated at y = y_b and <span class="latex">$z = \pm\sqrt{z_c^2 - y_b^2}$</span>.
* For a grazing incidence (z_c > y_b) angle theta and collimated incoming beam, 
* the focal lengths are situated downstream at (from ellipse centre):
* - f_t = z_c^2 sin(theta) / (2 y_b)
* - f_s = x_a^2 / (2 y_b sin(theta))
* Typical incidence angle is sin(theta) = y_b/z_c
*
* Limitation: the polarisation (Ex, Ey, Ez) is not transformed by the reflection.
*
* Example: Mirror_elliptic( zdepth=150e-3, xwidth=150e-3, x_a=1.025, y_b=1.025, z_c=1.025)
* 
* %Parameters
* INPUT PARAMETERS
* x_a:     [m]   1st short half axis (along x). Commonly set to zero, which really implies infinite value, so the mirror is an elliptic cylinder.
* y_b:     [m]   2nd short half axis (along y), which is also the presumed near-normal direction, reflection near the y-z plane. Must not be 0.
* z_c:     [m]   long  half axis (along z). Commonly a=0. b=c, which creates a circular cylindrical surface.
* xwidth:  [m]   Width of the mirror along X.
* zdepth:  [m]   Depth (length) of the mirror along Z.
* coating: [str] Datafile containing either mirror material constants or reflectivity numbers. Use "NULL" (or "") for a constant reflectivity R0.
* R0:      [1]   Constant reflectivity of mirror, used when coating is "NULL" or "".
* radius:  [m]   Spherical radius, Sets x_a=y_b=z_c=radius
* length:  [m]   alternate name for zdepth (obsolete). When > 0, it overrides zdepth.
* width:   [m]   alternate name for xwidth (obsolete). When > 0, it overrides xwidth.
*
* %End
*******************************************************************************/

DEFINE COMPONENT Mirror_elliptic
SETTING PARAMETERS (x_a=0, y_b=1.0, z_c=1.0, 
        zdepth=0.2,  xwidth=0.2,  
        R0=1,string coating="NULL",
        length=0,    width=0, radius=0)
DEPENDENCY "-std=c99"

SHARE
%{
  %include "read_table-lib"
  %include "reflectivity-lib"
%}

DECLARE
%{
  double a2inv;
  double b2inv;
  double c2inv; /* 1/r^2 for physical ellipse */
  t_Reflec re;
%}

INITIALIZE
%{
  int status;

  if (radius)
    x_a = y_b = z_c = radius;

  if (!y_b) {
    fprintf (stderr, "ERROR (%s): y_b must not be 0. Aborting.\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  if (coating && strlen (coating) && strcmp (coating, "NULL") && strcmp (coating, "0")) {
    status = reflec_Init (&re, COATING_UNDEFINED, coating, NULL);
  } else {
    /*assume a constant reflectivity*/
    status = reflec_Init (&re, CONSTANT, NULL, &(R0));
  }

  if (status != 0) {
    fprintf (stderr, "ERROR (%s): Could not interpret reflectivity. Aborting.\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  a2inv = (x_a) ? 1 / (x_a * x_a) : 0; /* 0 really means infinity for x direction */
  b2inv = 1 / (y_b * y_b);
  c2inv = (z_c) ? 1 / (z_c * z_c) : 0;

  fflush (NULL); // put diagnostics in order!

  // compatibility with older use
  if (length > 0)
    zdepth = length;
  if (width > 0)
    xwidth = width;
    
  if (xwidth <=0 || zdepth <=0) {
    fprintf (stderr, "ERROR (%s): xwidth and zdepth must be positive. Aborting.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
%}

TRACE
%{
  double K;             // length of k-vector
  double kxu, kyu, kzu; // unit vector in the direction of k-vector.

  /* get the photon's kvector */
  K = sqrt (kx * kx + ky * ky + kz * kz);
  /* make unit vector in the direction of k :*/
  kxu = kx;
  kyu = ky;
  kzu = kz;
  NORM (kxu, kyu, kzu);

  double A, B, C, xt, yt, zt;
  double t0, t1;
  /*an offset to the mirror parameters perhaps*/

  xt = x;
  zt = z;
  yt = y - y_b;

  C = xt * xt * a2inv + yt * yt * b2inv + zt * zt * c2inv - 1;
  B = 2 * (kxu * xt * a2inv + kyu * yt * b2inv + kzu * zt * c2inv);
  A = kxu * kxu * a2inv + kyu * kyu * b2inv + kzu * kzu * c2inv;

  if (solve_2nd_order (&t0, &t1, A, B, C)) {
    double xx0, xx1, yy0, yy1, zz0, zz1; /* we will have to tentatively propagate twice to see which surface we hit */
    xx0 = x + kxu * t0;
    yy0 = y + kyu * t0;
    zz0 = z + kzu * t0;
    xx1 = x + kxu * t1;
    yy1 = y + kyu * t1;
    zz1 = z + kzu * t1;

    /*Check if we hit the mirror and whether the hit it is in front of the ray.
     * Only the lower half of the ellipsoid (y < y_b) is the mirror surface.
     * This does not account for mirror curvature */

    int hit0 = (fabs (xx0) < xwidth / 2.0) && (fabs (zz0) < zdepth / 2.0) && (yy0 < y_b) && t0 > 0;
    int hit1 = (fabs (xx1) < xwidth / 2.0) && (fabs (zz1) < zdepth / 2.0) && (yy1 < y_b) && t1 > 0;
    int doit = hit0 || hit1;

    if (hit0 && !hit1)
      PROP_DL (t0); /* only one intersection actually on mirror */
    else if (hit1 && !hit0)
      PROP_DL (t1);          /* other intersection */
    else if (hit0 && hit1) { /* both, take first strike (which may be back of mirror) */
      PROP_DL (t0 < t1 ? t0 : t1);
    } else {
      RESTORE_XRAY (INDEX_CURRENT_COMP, x, y, z, kx, ky, kz, phi, t, Ex, Ey, Ez, p);
    }

    if (doit) {
      SCATTER;
      xt = x;
      yt = y - y_b;
      zt = z; /* update shifted coordinates to intersection point */
      double nx, ny, nz;
      /* grad is the inner normal to the surface at this point */
      nx = -xt * a2inv;
      ny = -yt * b2inv;
      nz = -zt * c2inv;
      NORM (nx, ny, nz);

      /* kdotn > 0 for hits from the concave (inner) side, < 0 for hits from the back (de-focusing) */
      double kdotn;
      kdotn = -scalar_prod (kx, ky, kz, nx, ny, nz);
      double kfx, kfy, kfz;
      kfx = kx + 2 * kdotn * nx;
      kfy = ky + 2 * kdotn * ny;
      kfz = kz + 2 * kdotn * nz;

      kx = kfx;
      ky = kfy;
      kz = kfz;

      /*adjust weight and phase of ray*/

      /* reflectivity depends on |kdotn| only: same for front and back hits */
      double kdotn_abs = fabs (kdotn);
      double q         = 2.0 * kdotn_abs;
      double theta_g   = asin (fmin (1.0, kdotn_abs / K)) * RAD2DEG; /* grazing angle [deg] */
      cdouble R        = refleccq (re, q, 0, K, theta_g);
      p   *= cabs (R);
      phi += atan2 (cimag (R), creal (R));

      /*catch dead rays*/
      if (p == 0)
        ABSORB;
    }
  }
%}

MCDISPLAY
%{
  int i, j, N = 12;
  double a2, b2, c2;
  a2 = 1.0 / a2inv;
  b2 = 1.0 / b2inv;
  c2 = 1.0 / c2inv;
  if (xwidth && zdepth) {
    double dx = xwidth / (N - 1), dz = zdepth / (N - 1);
    for (i = 0; i < N - 1; i++) {
      for (j = 0; j < N - 1; j++) {
        double x0 = i * dx - xwidth / 2.0, x1 = x0 + dx;
        double z0 = j * dz - zdepth / 2.0, z1 = z0 + dz;
        double y00 = -sqrt (b2 * (1 - x0 * x0 / a2 - z0 * z0 / c2)) + sqrt (b2);
        double y10 = -sqrt (b2 * (1 - x1 * x1 / a2 - z0 * z0 / c2)) + sqrt (b2);
        double y11 = -sqrt (b2 * (1 - x1 * x1 / a2 - z1 * z1 / c2)) + sqrt (b2);
        double y01 = -sqrt (b2 * (1 - x0 * x0 / a2 - z1 * z1 / c2)) + sqrt (b2);
        polygon (4, x0, y00, z0, x1, y10, z0, x1, y11, z1, x0, y01, z1);
      }
    }
  }
%}

END

