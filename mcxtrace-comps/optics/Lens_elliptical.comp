/*******************************************************************************
*
* McXtrace, x-ray tracing package
*         Copyright, All rights reserved
*         DTU Physics, Kgs. Lyngby, Denmark
*         Synchrotron SOLEIL, Saint-Aubin, France
*
* Component: Lens_elliptical
*
* %Identification
* Written by: Jana Baltser and Erik Knudsen
* Date: August 2010
* Version: 1.1
* Origin: NBI
*
* X-ray compound refractive lens (CRL) with an elliptic profile
*
* %Description
* A simple X-ray compound refractive lens (CRL) with an elliptic profile simulates the photons' movement on passing through it.
* Each surface is an elliptic paraboloid  x^2/r1^2 + y^2/r2^2 = (z-z0)/w  limited to the aperture x^2/r1^2 + y^2/r2^2 <= 1.
* Attenuation coefficient mu and f1 are taken from the material datafile (e.g. Be.txt), in the same
* format as used by Lens_parab and Lens_simple.
* Photons that miss the aperture of any surface (or undergo total external reflection) are absorbed.
* 
* %Parameters
* Input parameters:
* r1:                 [m]       Semi-axis of the elliptic aperture along the X axis 
* r2:                 [m]       Semi-axis of the elliptic aperture along the Y axis 
* w:                  [m]       Depth of one parabolic surface along the propagation axis (at the aperture edge)
* d:                  [m]       Distance between two surfaces of the lens along the propagation axis
* N:                  [1]       Number of single lenses in a stack
* Transmission:       [1]       Currently not used by the component
* material_datafile:  [Be.txt]  File where the material parameters for the filter may be found. Format is similar to what may be found off the NIST website.
* 
* %Link
* material datafile obtained from http://physics.nist.gov/cgi-bin/ffast/ffast.pl
*
* %End
*******************************************************************************/


DEFINE COMPONENT Lens_elliptical

SETTING PARAMETERS (string material_datafile="Be.txt",r1=0.42e-3,r2=0.8e-3,w=0.46e-3,d=0.2e-4,Transmission=1,int N=1)

/* X-ray parameters: (x,y,z,kx,ky,kz,phi,t,Ex,Ey,Ez,p) */ 

SHARE
%{
  %include "read_table-lib"
  typedef struct {
    double coord[3];
    double k[3];
    int hit; /* 1 if a valid refraction took place, 0 otherwise */
  } incom_elliptical;
  typedef struct {
    double constants[6]; /* r1, r2, w, d, M, Sign */
  } lens_elliptical;

  /* Intersect ray with the elliptic paraboloid x^2/r1^2 + y^2/r2^2 - Sign*(z-d)/w = 0 inside the elliptic aperture
     (first forward intersection) and refract with M = n_in/n_out (vector Snell's law). */
  #pragma acc routine seq
  incom_elliptical
  intersection_lens_elliptical (incom_elliptical a, lens_elliptical b) {
    incom_elliptical result;
    int i, j, nroots, found;
    double A, B, C, D, qq, tmp;
    double t[2], p[3], knorm[3], k[3], pos[3];
    double Nv[3], Nnorm, Knorm, ci, disc, fac;
    double r1, r2, w, d, M, Sign;

    for (i = 0; i <= 2; i++) {
      result.k[i] = k[i] = a.k[i];
      result.coord[i] = p[i] = a.coord[i];
    }
    result.hit = 0;

    Knorm = sqrt (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]);
    if (Knorm == 0)
      return result;
    for (i = 0; i <= 2; i++)
      knorm[i] = k[i] / Knorm;

    r1 = b.constants[0];
    r2 = b.constants[1];
    w = b.constants[2];
    d = b.constants[3];
    M = b.constants[4];
    Sign = b.constants[5];

    A = knorm[0] * knorm[0] * w * r2 * r2 + knorm[1] * knorm[1] * w * r1 * r1;
    B = 2.0 * p[0] * knorm[0] * w * r2 * r2 + 2.0 * p[1] * knorm[1] * w * r1 * r1 - Sign * r1 * r1 * r2 * r2 * knorm[2];
    C = p[0] * p[0] * w * r2 * r2 + p[1] * p[1] * w * r1 * r1 - Sign * r1 * r1 * r2 * r2 * p[2] + Sign * r1 * r1 * r2 * r2 * d;

    if (A == 0) { /* equation is linear */
      if (B == 0)
        return result;
      t[0] = -C / B;
      nroots = 1;
    } else {
      D = B * B - 4.0 * A * C;
      if (D < 0) /* line does not intersect the paraboloid */
        return result;
      if (B < 0) {
        qq = -0.5 * (B - sqrt (D));
      } else {
        qq = -0.5 * (B + sqrt (D));
      }
      t[0] = qq / A;
      t[1] = (qq != 0) ? C / qq : t[0];
      if (t[1] < t[0]) {
        tmp = t[0];
        t[0] = t[1];
        t[1] = tmp;
      }
      nroots = 2;
    }

    found = 0;
    for (j = 0; j < nroots && !found; j++) {
      if (t[j] < -w) /* more than one sag behind the photon */
        continue;
      for (i = 0; i <= 2; i++)
        pos[i] = p[i] + t[j] * knorm[i];
      if ((pos[0] * pos[0]) / (r1 * r1) + (pos[1] * pos[1]) / (r2 * r2) <= 1.0)
        found = 1;
    }
    if (!found)
      return result;
    for (i = 0; i <= 2; i++)
      result.coord[i] = pos[i];

    /* surface normal (gradient) */
    Nv[0] = 2.0 * pos[0] / (r1 * r1);
    Nv[1] = 2.0 * pos[1] / (r2 * r2);
    Nv[2] = -Sign / w;
    Nnorm = sqrt (Nv[0] * Nv[0] + Nv[1] * Nv[1] + Nv[2] * Nv[2]);
    for (i = 0; i <= 2; i++)
      Nv[i] /= Nnorm;
    ci = -(Nv[0] * knorm[0] + Nv[1] * knorm[1] + Nv[2] * knorm[2]);
    if (ci < 0) {
      ci = -ci;
      for (i = 0; i <= 2; i++)
        Nv[i] = -Nv[i];
    }

    /* vector Snell's law: kn' = M*kn + (M*ci - sqrt(1-M^2(1-ci^2)))*N ; |k'| = |k|/M */
    disc = 1.0 - M * M * (1.0 - ci * ci);
    if (disc < 0) /* total external reflection */
      return result;
    fac = M * ci - sqrt (disc);
    for (i = 0; i <= 2; i++)
      result.k[i] = (Knorm / M) * (M * knorm[i] + fac * Nv[i]);
    result.hit = 1;
    return result;
  }
%}

DECLARE
%{
  int Z;
  double Ar;
  double rho;
  t_Table matT;
%} 


INITIALIZE 
%{
  if (r1 <= 0 || r2 <= 0 || w <= 0) {
    fprintf (stderr, "Error (%s): r1, r2 and w must be positive.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if (Table_Read (&(matT), material_datafile, 0) == -1)
    exit (fprintf (stderr, "Error (%s): Could not read %s. Aborting.\n", NAME_CURRENT_COMP, material_datafile));
  char** header_parsed;
  header_parsed = Table_ParseHeader (matT.header, "Z", "A[r]", "rho", NULL);
  if (!Z)
    Z = strtol (header_parsed[0], NULL, 10);
  if (!Ar)
    Ar = strtod (header_parsed[1], NULL);
  if (!rho)
    rho = strtod (header_parsed[2], NULL);
%}


TRACE
%{
  incom_elliptical incid, refr, outg;
  lens_elliptical ellip;
  double k, n, delta, dl, e, mu, f1, rhoel, d_total;
  int nr;

  ellip.constants[0] = r1;
  ellip.constants[1] = r2;
  ellip.constants[2] = w;

  k = sqrt (kx * kx + ky * ky + kz * kz);
  e = K2E * k; /* energy in keV, same unit as datafile */

  /* same table convention as Lens_parab: column 1 = f1, column 5 = mu/rho [cm^2/g] */
  mu = Table_Value (matT, e, 5) * rho * 1e2; /* [m^-1] */
  f1 = Table_Value (matT, e, 1);
  rhoel = f1 * NA * (rho * 1e-24) / Ar; /* electron density [e/A^3] incl. f' */
  delta = 2.0 * M_PI * RE * rhoel / (k * k);
  n = 1.0 - delta;

  incid.k[0] = kx;
  incid.k[1] = ky;
  incid.k[2] = kz;
  incid.coord[0] = x;
  incid.coord[1] = y;
  incid.coord[2] = z;

  d_total = 0;
  for (nr = 0; nr <= (N - 1); nr++) {
    ellip.constants[3] = nr * d + nr * 2 * w;
    ellip.constants[4] = 1.0 / n;
    ellip.constants[5] = -1.0;

    refr = intersection_lens_elliptical (incid, ellip);
    if (!refr.hit) {
      ABSORB; /* missed the aperture (or total external reflection) */
    }
    dl = sqrt ((refr.coord[0] - x) * (refr.coord[0] - x) + (refr.coord[1] - y) * (refr.coord[1] - y) + (refr.coord[2] - z) * (refr.coord[2] - z));
    if ((refr.coord[2] - z) * kz < 0) { /* surface slightly behind the photon */
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    SCATTER;

    /* photon now travels in the lens material: use the refracted direction */
    kx = refr.k[0];
    ky = refr.k[1];
    kz = refr.k[2];

    // second surface of the lens
    ellip.constants[3] = (nr + 1) * d + nr * 2 * w;
    ellip.constants[4] = n;
    ellip.constants[5] = 1.0;
    outg = intersection_lens_elliptical (refr, ellip);
    if (!outg.hit) {
      ABSORB;
    }
    dl = sqrt ((outg.coord[0] - x) * (outg.coord[0] - x) + (outg.coord[1] - y) * (outg.coord[1] - y) + (outg.coord[2] - z) * (outg.coord[2] - z));
    if ((outg.coord[2] - z) * kz < 0) {
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    d_total += dl;
    SCATTER;

    kx = outg.k[0];
    ky = outg.k[1];
    kz = outg.k[2];
    incid = outg;
  }
  /* absorption according to the path length inside the lens material */
  p *= exp (-mu * d_total);
%}

FINALLY
%{
  Table_Free (&(matT));
%}

MCDISPLAY
%{
  /* draw the elliptic rims of the first (up to 20) lenses */
  int nr_d, j_d, nseg = 32;
  for (nr_d = 0; nr_d < (N < 20 ? N : 20); nr_d++) {
    double z1 = nr_d * (d + 2 * w) - w;
    double z2 = nr_d * (d + 2 * w) + d + w;
    for (j_d = 0; j_d < nseg; j_d++) {
      double a0 = 2 * M_PI * j_d / nseg, a1 = 2 * M_PI * (j_d + 1) / nseg;
      line (r1 * cos (a0), r2 * sin (a0), z1, r1 * cos (a1), r2 * sin (a1), z1);
      line (r1 * cos (a0), r2 * sin (a0), z2, r1 * cos (a1), r2 * sin (a1), z2);
    }
  }
%}

END
