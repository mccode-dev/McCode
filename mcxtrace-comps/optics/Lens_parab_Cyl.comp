*         Synchrotron SOLEIL, Saint-Aubin, France
*
* Component: Lens_parab_Cyl
*
* %Identification
* Written by: Jana Baltser and Erik Knudsen
* Date: April 2011
* Version: 1.1
* Release: McXtrace 0.1
* Origin: NBI
*
* X-ray compound refractive lens (CRL) with a parabolic cylinder shape
*
* %Description
* An X-ray compound refractive lens (CRL) with a parabolic cylinder profile focusing in 1D, i.e. onto a line
* 
* The lens is invariant along the x-axis and has a parabolic profile along the y-axis defined as z = y^2/(2r).
* Thus, i.e. it focuses onto a line along the x-axis.
* N>1 means that a stack of lenses is to be simulated. Each lens consists of a pair of two opposing parabolic surfaces
* with a distance d between them. The reference point of the component is at the bottom of the first parabolic
* surface.
* Photons that miss the aperture of any surface (or undergo total external reflection) are absorbed.
*
* Example: Lens_parab_Cyl(r=.5e-3,yheight=1.3e-3,xwidth=1.3e-3,d=.1e-3,N=21,
*     material_datafile="Be.txt")
*
* %Parameters
* Input parameters:
* r:        [m] Radius of curvature (circular approximation at the tip of the profile).
* yheight:  [m] The CRL's aperture along Y.
* xwidth:   [m] The width of the CRL in the invariant direction x.
* d:        [m] Distance between two surfaces of the lens along the propagation axis.
* N:        [1] Number of single lenses in a stack.
* material_datafile: [str]   Datafile containing f1 constants
*
* %End
*******************************************************************************/

DEFINE COMPONENT Lens_parab_Cyl

SETTING PARAMETERS (string material_datafile="Be.txt",r=.5e-3,yheight=1.2e-3,xwidth=1.2e-3,d=.1e-3, int N=1)

/* X-ray parameters: (x,y,z,kx,ky,kz,phi,t,Ex,Ey,Ez,p) */ 

SHARE
%{
  %include "read_table-lib"
  typedef struct {
    double coord[3];
    double k[3];
    int hit; /* 1 if a valid refraction took place, 0 otherwise */
  } data_lens_parab_Cyl;

  // intersect_parab_Cyl calculates the intersection of the photon's trajectory with a parabolic cylinder surface
  // y^2 - Sign*2*rr*(z-dd) = 0, takes the first forward intersection inside (|y|<=yh/2 && |x|<=xw/2), and
  // refracts the photon there (vector Snell's law, M = n_in/n_out).
  // b = {rr, yh, xw, dd, M, Sign}
  #pragma acc routine
  data_lens_parab_Cyl
  intersect_parab_Cyl (data_lens_parab_Cyl a, double* b) {
    data_lens_parab_Cyl result;
    int i, j, nroots, found;
    double A, B, C, D, qq, rr, yh, xw, dd, M, Sign;
    double t[2], tmp, p[3], k[3], knorm[3], Knorm, pos[3];
    double Nv[3], Nnorm, ci, disc, fac;

    for (i = 0; i <= 2; i++) {
      result.k[i] = k[i] = a.k[i];
      result.coord[i] = p[i] = a.coord[i];
    }
    result.hit = 0;

    Knorm = sqrt (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]);
    if (Knorm == 0)
      return result;
    for (i = 0; i <= 2; i++)
      knorm[i] = k[i] / Knorm;

    rr = b[0];
    yh = b[1];
    xw = b[2];
    dd = b[3];
    M = b[4];
    Sign = b[5];

    A = knorm[1] * knorm[1];
    B = 2 * (p[1] * knorm[1] - Sign * rr * knorm[2]);
    C = p[1] * p[1] - Sign * 2 * rr * p[2] + Sign * dd * 2 * rr;

    if (A == 0) { /*k has no y-component. Thus, the eq. becomes linear*/
      if (B == 0)
        return result;
      t[0] = -C / B;
      nroots = 1;
    } else {
      D = B * B - 4.0 * A * C;
      if (D < 0) /*ray does not intersect the parabola*/
        return result;
      if (B < 0) {
        qq = -0.5 * (B - sqrt (D));
      } else {
        qq = -0.5 * (B + sqrt (D));
      }
      t[0] = qq / A;
      t[1] = (qq != 0) ? C / qq : t[0];
      if (t[1] < t[0]) {
        tmp = t[0];
        t[0] = t[1];
        t[1] = tmp;
      }
      nroots = 2;
    }

    /* first forward intersection inside the aperture (also checked in the linear case) */
    found = 0;
    for (j = 0; j < nroots && !found; j++) {
      if (t[j] < -yh * yh / (8.0 * rr)) /* more than one sag behind the photon */
        continue;
      for (i = 0; i <= 2; i++)
        pos[i] = p[i] + t[j] * knorm[i];
      if (fabs (pos[1]) <= fabs (yh / 2) && fabs (pos[0]) <= fabs (xw / 2))
        found = 1;
    }
    if (!found)
      return result;
    for (i = 0; i <= 2; i++)
      result.coord[i] = pos[i];

    /*surface normal (gradient of the parabolic cylinder)*/
    Nv[0] = 0;
    Nv[1] = -Sign * pos[1] / rr;
    Nv[2] = 1;
    Nnorm = sqrt (Nv[1] * Nv[1] + Nv[2] * Nv[2]);
    Nv[1] /= Nnorm;
    Nv[2] /= Nnorm;
    ci = -(Nv[0] * knorm[0] + Nv[1] * knorm[1] + Nv[2] * knorm[2]);
    if (ci < 0) {
      ci = -ci;
      for (i = 0; i <= 2; i++)
        Nv[i] = -Nv[i];
    }

    /* vector Snell's law: kn' = M*kn + (M*ci - sqrt(1-M^2(1-ci^2)))*N ; |k'| = |k|/M */
    disc = 1.0 - M * M * (1.0 - ci * ci);
    if (disc < 0) /* total external reflection */
      return result;
    fac = M * ci - sqrt (disc);
    for (i = 0; i <= 2; i++)
      result.k[i] = (Knorm / M) * (M * knorm[i] + fac * Nv[i]);
    result.hit = 1;
    return result;
  }
%}

DECLARE
%{
  int Z;
  double Ar;
  double rho;
  t_Table matT;
%}


INITIALIZE
%{
  int status = 0;

  if (r <= 0 || yheight <= 0 || xwidth <= 0) {
    fprintf (stderr, "Error (%s): r, yheight and xwidth must be positive.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if ((status = Table_Read (&(matT), material_datafile, 0)) == -1) {
    fprintf (stderr, "Error: Could not parse file \"%s\" in COMP %s\n", material_datafile, NAME_CURRENT_COMP);
    exit (-1);
  }
  char** header_parsed;
  header_parsed = Table_ParseHeader (matT.header, "Z", "A[r]", "rho", NULL);
  if (!Z)
    Z = strtol (header_parsed[0], NULL, 10);
  if (!Ar)
    Ar = strtod (header_parsed[1], NULL);
  if (!rho)
    rho = strtod (header_parsed[2], NULL);
%}

TRACE
%{
  // calculation of the parabolic parameters
  double parab_Cyl[6];
  data_lens_parab_Cyl incid, refr, outg;

  int nr;
  double w;
  double mu, f, rhoel, dl, d_total, e, k, delta, Refractive_Index_Re;

  w = (yheight * yheight) / (8.0 * r); // calculation of the "depth" of the profile

  parab_Cyl[0] = r;
  parab_Cyl[1] = yheight;
  parab_Cyl[2] = xwidth;

  k = sqrt (kx * kx + ky * ky + kz * kz);
  e = K2E * k; /*Energy in KeV, same unit as datafile */

  /*Interpolation of Table Values*/
  mu = Table_Value (matT, e, 5) * rho * 1e2; /*mu is now in SI, [m^-1]*/
  f = Table_Value (matT, e, 1);

  /*Calculation of Refractive Index */
  rhoel = f * NA * (rho * 1e-24) / Ar; /*Material's Number Density of Electrons [e/A^3] incl f' scattering length correction*/
  delta = 2.0 * M_PI * RE * rhoel / (k * k);

  Refractive_Index_Re = 1.0 - delta;

  incid.k[0] = kx;
  incid.k[1] = ky;
  incid.k[2] = kz;

  incid.coord[0] = x;
  incid.coord[1] = y;
  incid.coord[2] = z;

  d_total = 0;
  for (nr = 0; nr <= (N - 1); nr++) {
    parab_Cyl[3] = nr * d + nr * 2 * w;       // d constant
    parab_Cyl[4] = 1.0 / Refractive_Index_Re; // M constant
    parab_Cyl[5] = -1.0;                      // Sign constant

    refr = intersect_parab_Cyl (incid, parab_Cyl);
    if (!refr.hit) {
      ABSORB; /* missed the aperture (or total external reflection) */
    }

    dl = sqrt ((refr.coord[0] - x) * (refr.coord[0] - x) + (refr.coord[1] - y) * (refr.coord[1] - y) + (refr.coord[2] - z) * (refr.coord[2] - z));
    if ((refr.coord[2] - z) * kz < 0) { /* surface slightly behind the photon */
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    SCATTER;

    kx = refr.k[0];
    ky = refr.k[1];
    kz = refr.k[2];

    // alter parabolic input to match second parabola
    parab_Cyl[3] = (nr + 1) * d + nr * 2 * w;
    parab_Cyl[4] = Refractive_Index_Re;
    parab_Cyl[5] = 1.0;

    outg = intersect_parab_Cyl (refr, parab_Cyl);
    if (!outg.hit) {
      ABSORB;
    }

    dl = sqrt ((outg.coord[0] - x) * (outg.coord[0] - x) + (outg.coord[1] - y) * (outg.coord[1] - y) + (outg.coord[2] - z) * (outg.coord[2] - z));
    if ((outg.coord[2] - z) * kz < 0) {
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    d_total += dl;
    SCATTER;

    kx = outg.k[0];
    ky = outg.k[1];
    kz = outg.k[2];
    incid = outg;
  }
  /*Add absorption according to the path length inside the lens material*/
  p *= exp (-mu * d_total);
%}

FINALLY
%{
  Table_Free (&(matT));
%}

MCDISPLAY
%{

  double z_c, zdepth, w;
  w = (yheight * yheight) / (8 * r);
  zdepth = N * (2 * w + d);
  z_c = (zdepth / 2.0) - w;
  box (0, 0, z_c, xwidth, yheight, zdepth, 0, 0, 1, 0);
%}

END
