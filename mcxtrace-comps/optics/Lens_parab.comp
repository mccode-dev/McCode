* Written by: Jana Baltser and Erik Knudsen
* Date: August 2010, modified July 2011
* Version: 1.1
* Release: McXtrace 0.1
* Origin: NBI
*
* X-ray compound refractive lens (CRL) with a profile of the parabola
*
* %Description
* A simple X-ray compound refractive lens (CRL) with a profile of the parabola in rotation simulates the photons' movement on passing through it. The CRL focuses in 2D
* Photons that miss the circular aperture of any surface (or undergo total external reflection) are absorbed.
*
* Example: Lens_parab(material_datafile = "Be.txt", r=200e-6, r_ap=0.5e-3, d=50e-6, N=16)
*
* %Parameters
* Input parameters:
* r:        [m] Radius of curvature (circular approximation at the tip of the profile).
* r_ap:     [m] Radius of circular aperture, which also defines the depth of the lens profile.
* d:        [m] Distance between two surfaces of the lens along the propagation axis.
* N:        [1] Number of single lenses in a stack.
* material_datafile: [str]   Datafile containing f1 constants
*
* %End
*******************************************************************************/

DEFINE COMPONENT Lens_parab

SETTING PARAMETERS (string material_datafile="Be.txt", r=0.5e-3, r_ap=1.4e-3, d=.1e-3, int N=1)

/* X-ray parameters: (x,y,z,kx,ky,kz,phi,t,Ex,Ey,Ez,p) */ 

SHARE
%{
  %include "read_table-lib"
  struct incom_parab {
    double coord[3];
    double k[3];
    int hit; /* 1 if a valid refraction took place, 0 otherwise */
  };

  /* Intersect a ray with the paraboloid  x^2+y^2 - Sign*2*rr*(z-dd) = 0, restricted to x^2+y^2 <= (b[1]/2)^2,
     and refract (Snell's law in vector form) with relative index ratio M = n_in/n_out.
     b = {rr, 2*r_ap, (unused), dd, M, Sign} */
  #pragma acc routine seq
  struct incom_parab
  intersection_lens_parab (struct incom_parab a, double* b) {
    struct incom_parab result;
    int i, j, nroots, found;
    double A, B, C, D, qq, rr, ap2, M, Sign, dd;
    double t[2], tmp, p[3], k[3], knorm[3], Knorm, pos[3];
    double Nv[3], Nnorm, ci, disc, fac;

    for (i = 0; i <= 2; i++) {
      result.k[i] = k[i] = a.k[i];
      result.coord[i] = p[i] = a.coord[i];
    }
    result.hit = 0;

    Knorm = sqrt (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]);
    if (Knorm == 0)
      return result;
    for (i = 0; i <= 2; i++)
      knorm[i] = k[i] / Knorm;

    rr = b[0];
    ap2 = (b[1] / 2.0) * (b[1] / 2.0);
    dd = b[3];
    M = b[4];
    Sign = b[5];

    A = knorm[0] * knorm[0] + knorm[1] * knorm[1];
    B = 2.0 * (p[0] * knorm[0] + p[1] * knorm[1] - Sign * rr * knorm[2]);
    C = p[0] * p[0] + p[1] * p[1] - Sign * 2 * rr * p[2] + Sign * 2 * rr * dd;

    if (A == 0) { /*incident k-vector is parallel (exactly) to the z-axis. Thus, the eq. becomes linear*/
      if (B == 0)
        return result;
      t[0] = -C / B;
      nroots = 1;
    } else {
      D = B * B - 4.0 * A * C;
      if (D < 0) /*ray does not intersect the parabola*/
        return result;
      if (B < 0) {
        qq = -0.5 * (B - sqrt (D));
      } else {
        qq = -0.5 * (B + sqrt (D));
      }
      t[0] = qq / A;
      t[1] = (qq != 0) ? C / qq : t[0];
      if (t[1] < t[0]) {
        tmp = t[0];
        t[0] = t[1];
        t[1] = tmp;
      }
      nroots = 2;
    }

    /* take the first forward intersection that lies inside the circular aperture */
    found = 0;
    for (j = 0; j < nroots && !found; j++) {
      if (t[j] < -ap2 / (2.0 * rr)) /* more than one sag behind the photon */
        continue;
      for (i = 0; i <= 2; i++)
        pos[i] = p[i] + t[j] * knorm[i];
      if (pos[0] * pos[0] + pos[1] * pos[1] <= ap2)
        found = 1;
    }
    if (!found)
      return result;
    for (i = 0; i <= 2; i++)
      result.coord[i] = pos[i];

    /* surface normal (gradient of the paraboloid) */
    Nv[0] = -Sign * pos[0] / rr;
    Nv[1] = -Sign * pos[1] / rr;
    Nv[2] = 1;
    Nnorm = sqrt (Nv[0] * Nv[0] + Nv[1] * Nv[1] + Nv[2] * Nv[2]);
    for (i = 0; i <= 2; i++)
      Nv[i] /= Nnorm;
    /* orient the normal against the propagation direction */
    ci = -(Nv[0] * knorm[0] + Nv[1] * knorm[1] + Nv[2] * knorm[2]);
    if (ci < 0) {
      ci = -ci;
      for (i = 0; i <= 2; i++)
        Nv[i] = -Nv[i];
    }

    /* vector Snell's law: kn' = M*kn + (M*ci - sqrt(1-M^2(1-ci^2)))*N ; |k'| = |k|/M */
    disc = 1.0 - M * M * (1.0 - ci * ci);
    if (disc < 0) /* total external reflection */
      return result;
    fac = M * ci - sqrt (disc);
    for (i = 0; i <= 2; i++)
      result.k[i] = (Knorm / M) * (M * knorm[i] + fac * Nv[i]);
    result.hit = 1;
    return result;
  }
%}

DECLARE
%{
  int Z;
  double Ar;
  double rho;
  t_Table matT;
%}

INITIALIZE
%{
  int status = 0;

  if (r <= 0 || r_ap <= 0) {
    fprintf (stderr, "Error (%s): r and r_ap must be positive.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if ((status = Table_Read (&(matT), material_datafile, 0)) == -1) {
    fprintf (stderr, "Error: Could not parse file \"%s\" in COMP %s\n", material_datafile, NAME_CURRENT_COMP);
    exit (-1);
  }
  char** header_parsed;
  header_parsed = Table_ParseHeader (matT.header, "Z", "A[r]", "rho", NULL);
  if (!Z)
    Z = strtol (header_parsed[0], NULL, 10);
  if (!Ar)
    Ar = strtod (header_parsed[1], NULL);
  if (!rho)
    rho = strtod (header_parsed[2], NULL);
%}

TRACE
%{
  double parab[6];
  double mu, f, rhoel, dl, d_total, e, k, delta, Refractive_Index_Re, w;
  struct incom_parab incid, refr, outg;

  int nr;

  parab[0] = r;
  parab[1] = r_ap * 2;
  parab[2] = r_ap * 2;

  w = (r_ap * r_ap) / (2.0 * r);
  k = sqrt (kx * kx + ky * ky + kz * kz);
  e = K2E * k; /*Energy in KeV, same unit as datafile */

  /*Interpolation of Table Values*/
  mu = Table_Value (matT, e, 5) * rho * 1e2; /*mu is now in SI, [m^-1]*/
  f = Table_Value (matT, e, 1);

  /*Calculation of Refractive Index */
  rhoel = f * NA * (rho * 1e-24) / Ar; /*Material's Number Density of Electrons [e/A^3] incl f' scattering length correction*/
  delta = 2.0 * M_PI * RE * rhoel / (k * k);

  Refractive_Index_Re = 1.0 - delta;

  incid.k[0] = kx;
  incid.k[1] = ky;
  incid.k[2] = kz;

  incid.coord[0] = x;
  incid.coord[1] = y;
  incid.coord[2] = z;

  d_total = 0;
  for (nr = 0; nr <= (N - 1); nr++) {
    parab[3] = nr * d + nr * 2 * w;       // d constant
    parab[4] = 1.0 / Refractive_Index_Re; // M constant
    parab[5] = -1.0;                      // Sign constant

    refr = intersection_lens_parab (incid, parab);
    if (!refr.hit) {
      ABSORB; /* missed the aperture (or total external reflection) */
    }

    dl = sqrt ((refr.coord[0] - x) * (refr.coord[0] - x) + (refr.coord[1] - y) * (refr.coord[1] - y) + (refr.coord[2] - z) * (refr.coord[2] - z));
    if ((refr.coord[2] - z) * kz < 0) { /* surface slightly behind the photon */
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    SCATTER;

    kx = refr.k[0];
    ky = refr.k[1];
    kz = refr.k[2];

    // alter parabolic input to match second parabola
    parab[3] = (nr + 1) * d + nr * 2 * w;
    parab[4] = Refractive_Index_Re;
    parab[5] = 1.0;

    outg = intersection_lens_parab (refr, parab);
    if (!outg.hit) {
      ABSORB;
    }

    dl = sqrt ((outg.coord[0] - x) * (outg.coord[0] - x) + (outg.coord[1] - y) * (outg.coord[1] - y) + (outg.coord[2] - z) * (outg.coord[2] - z));
    if ((outg.coord[2] - z) * kz < 0) {
      dl = -dl;
      ALLOW_BACKPROP;
    }
    PROP_DL (dl);
    d_total += dl;
    SCATTER;

    kx = outg.k[0];
    ky = outg.k[1];
    kz = outg.k[2];
    incid = outg;
  }
  /*Add absorption according to the path length inside the lens material*/
  p *= exp (-mu * d_total);
%}

FINALLY
%{
  Table_Free (&(matT));
%}

MCDISPLAY
%{
  double z_c, zdepth, w;
  w = (r_ap * r_ap) / (2 * r);
  zdepth = N * (2 * w + d);
  z_c = zdepth / 2.0 - w;
  /*draw individiual lenses*/
  /*draw a circle at the maximal aperture and a parabola along x and y*/
  int i, j = 0;
  for (j = 0; j < (N < 20 ? N : 20); j++) {
    circle ("xy", 0, 0, -w + j * (d + 2 * w), r_ap);
    circle ("xy", 0, 0, d + w + j * (d + 2 * w), r_ap);
    double zz0, zz1, yy0, yy1, dz, s;
    yy0 = r_ap;
    zz0 = zz1 = -w;
    dz = w / (64.0 - 1.0);
    s = j * (d + 2 * w);
    /*first parabola*/
    while (zz1 <= 0) {
      zz1 += dz;
      yy1 = sqrt (2 * r * fabs (zz1));
      line (0, yy0, s + zz0, 0, yy1, s + zz1);
      line (0, -yy0, s + zz0, 0, -yy1, s + zz1);
      line (yy0, 0, s + zz0, yy1, 0, s + zz1);
      line (-yy0, 0, s + zz0, -yy1, 0, s + zz1);
      zz0 = zz1;
      yy0 = yy1;
    }
    zz0 = 0;
    zz1 = 0;
    yy0 = 0;
    /*2nd parabola*/
    while (zz1 <= w) {
      zz1 += dz;
      yy1 = sqrt (2 * r * fabs (zz1));
      line (0, yy0, d + s + zz0, 0, yy1, d + s + zz1);
      line (0, -yy0, d + s + zz0, 0, -yy1, d + s + zz1);
      line (yy0, 0, d + s + zz0, yy1, 0, d + s + zz1);
      line (-yy0, 0, d + s + zz0, -yy1, 0, d + s + zz1);
      zz0 = zz1;
      yy0 = yy1;
    }
  }
  /*draw a circle at the last aperture of the lens*/
  circle ("xy", 0, 0, zdepth - w, r_ap);
%}

END
