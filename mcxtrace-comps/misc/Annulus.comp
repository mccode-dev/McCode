DEFINE COMPONENT Annulus

SETTING PARAMETERS (outer_radius=0,inner_radius=0,radius=0, thickness=0)

/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */

SHARE
%{
%}

DECLARE
%{
%}

INITIALIZE
%{
  // radius=outer_radius=80, inner_radius=thickness=10
%}


TRACE %{
  /* component Annulus does nothing */
%}

MCDISPLAY
%{
  // Draws a annulus with center at (x,y,z) with extent (outer radius) and remove inner thickness.
  mcdis_annulus (0, 0, 0, outer_radius, inner_radius, 0, 1, 0);
%}

END
