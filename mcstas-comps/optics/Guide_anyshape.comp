* McStas, neutron ray-tracing package
*         Copyright (C) 1997-2010, All rights reserved
*         Risoe National Laboratory, Roskilde, Denmark
*         Institut Laue Langevin, Grenoble, France
*
* Component: Guide
*
* %I
* Written by: Emmanuel Farhi
* Date: August 4th 2010
* Origin: ILL
* Modified by: Peter Link / Gaetano Mangiapia (MLZ/Hereon), 2017/2022: per-face m, alpha, W (as Guide_anyshape_r)
* Modified by: Peter Willendrup (DTU), 2026: merged Guide_anyshape_r into Guide_anyshape (file_coatings)
*
* Reflecting surface (guide and mirror) with any shape, defined from an OFF file,
* optionally with m, alpha, W (R0, Qc) given per face in the file.
*
* %D
*
* This is a reflecting object component. Its shape is defined from an OFF file,
* given with its file name. The object size is set as given from the file, where
* dimensions should be in meters. The bounding box may be re-scaled by specifying
* xwidth,yheight,zdepth parameters. The object may optionally be centered when
* using 'center=1'.
*
* The reflectivity is specified either from the usual parametric description
* R0,Qc,alpha,W,m, or from a reflectivity file 'reflect' with a 2 column
* format [q(Angs-1) R(0-1)], or per face from the geometry file (file_coatings=1).
*
* Per-face coatings (file_coatings=1, replaces the former Guide_anyshape_r):
*   the numbers following the vertex indices of each face in the OFF/PLY file
*   are read as m, alpha, W (IN THIS ORDER), optionally followed by R0 and Qc:
*     nv  i1 i2 ... inv   m alpha W [R0 [Qc]]
*   e.g.  4 0 5 6 4   3.0 6.07 0.003
*   Values that are not given in the file are taken from the component
*   parameters. See the example file Guide_r.off.
*   Former Guide_anyshape_r(m=0, alpha=0, W=0, ...) corresponds to
*   Guide_anyshape(file_coatings=1, ...).
*
* The complex OFF/PLY geometry option handles any closed non-convex polyhedra,
*   with polygons of any number of vertices.
*   It supports the OFF, NOFF, COFF, PLY and STL file formats (colours are ignored, but
*   face colours would be interpreted as coatings when file_coatings=1).
*   Such files may be generated from XYZ data using:
*     qhull < coordinates.xyz Qx Qv Tv o > geomview.off
*   or
*     powercrust coordinates.xyz
*   and viewed with geomview or java -jar jroff.jar (see below).
*   The default size of the object depends of the OFF file data, but its
*   bounding box may be resized using xwidth,yheight and zdepth.
*   PLY geometry files are also supported.
*
* %P
* INPUT PARAMETERS:
*
* geometry: [str]              Name of the OFF, PLY or STL file describing the guide geometry
* xwidth: [m]                  Redimension the object bounding box on X axis is non-zero
* yheight: [m]                 Redimension the object bounding box on Y axis is non-zero
* zdepth: [m]                  Redimension the object bounding box on Z axis is non-zero
* center: [1]                  When set to 1, the object will be centered w.r.t. the local coordinate frame
* R0: [1]                      Low-angle reflectivity
* Qc: [AA^-1]                   Critical scattering vector
* alpha: [AA]                  Slope of reflectivity
* m: [1]                       m-value of material. Zero means completely absorbing.
* W: [AA^-1]                    Width of supermirror cut-off
* reflect: [q(AA^-1) R(0-1)]  (str)  Reflectivity file name. Format 
* transmit: [1]                When true, non reflected neutrons are transmitted through the surfaces, instead of being absorbed. No material absorption is taken into account though
* file_coatings: [1]           When 1, use m, alpha, W [R0, Qc] given per face in the geometry file instead of the parameters (which then serve as defaults for values missing in the file).
*
* CALCULATED PARAMETERS:
* SCATTERED: []                number of reflected events
*
* %D
* Example values: m=4 Qc=0.0219 W=1/300 alpha=6.49 R0=1
*
* %L
* <a href="http://www.geomview.org">Geomview and Object File Format (OFF)</a>
* %L
* Java version of Geomview (display only) <a href="http://www.holmes3d.net/graphics/roffview/">jroff.jar</a>
* %L
* <a href="http://qhull.org">qhull</a>
* %L
* <a href="http://www.cs.ucdavis.edu/~amenta/powercrust.html">powercrust</a>
*
* %E
*******************************************************************************/

DEFINE COMPONENT Guide_anyshape

SETTING PARAMETERS (xwidth=0, yheight=0, zdepth=0, center=0, transmit=0,
  R0=0.99, Qc=0.0219, alpha=3, m=2, W=0.003, string reflect=0, string geometry=0,
  int file_coatings=0)

DEPENDENCY " -DUSE_OFF "
/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */

SHARE
%{
%include "read_table-lib"
%include "geometry-mesh-lib"
%include "ref-lib"
%}

DECLARE
%{
  gmesh_struct mesh;
  t_Table pTable;
  int use_table;
%}

INITIALIZE
%{
  /* initialize the mesh from the file, with the per-face coatings when used */
  if (!gmesh_init_fit (geometry, xwidth, yheight, zdepth, center, file_coatings ? GMESH_PROPS_OPTIONAL : GMESH_PROPS_IGNORE, &mesh))
    exit (-1);

  /* optionally initialize reflectivity curves */
  use_table = (reflect && strlen (reflect) && strcmp (reflect, "NULL") && strcmp (reflect, "0"));
  if (use_table) {
    if (Table_Read (&pTable, reflect, 1) <= 0) /* read 1st block data from file into pTable */
      exit (fprintf (stderr, "Guide_anyshape: %s: can not read file %s. Aborting.\n", NAME_CURRENT_COMP, reflect));
    else
      Table_Rebin (&pTable); /* rebin as evenly, increasing array */
  }

  /* optionally use per-face coatings from the geometry file */
  if (file_coatings) {
    if (use_table)
      exit (fprintf (stderr, "Guide_anyshape: %s: file_coatings=1 and reflect=%s can not be used together. Aborting.\n", NAME_CURRENT_COMP, reflect));
    if (mesh.nfaceprops < 3)
      exit (fprintf (stderr,
                     "Guide_anyshape: %s: file_coatings=1 but %s does not give m, alpha, W for each face\n"
                     "  (expected lines 'nv i1 ... inv m alpha W [R0 [Qc]]'). Aborting.\n",
                     NAME_CURRENT_COMP, geometry));
    MPI_MASTER (printf ("Guide_anyshape: %s: using per-face m, alpha, W%s%s from %s\n", NAME_CURRENT_COMP, mesh.nfaceprops > 3 ? ", R0" : "",
                        mesh.nfaceprops > 4 ? ", Qc" : "", geometry););
  }
%}

TRACE
%{
  int intersect = 0;
  int counter = 0;
  /* main loop for multiple reflections */
  #ifdef OPENACC
  gmesh_struct thread_mesh = mesh;
  #else
  #define thread_mesh mesh
  #endif
  do {
    double dt = 0;
    int fi = 0;
    Coords n = { 0, 0, 0 };
    gmesh_hit hits[GMESH_MAX_HITS];
    Coords acceleration = coords_set (0, 0, 0);
    if (mcgravitation)
      acceleration = rot_apply (_comp->_rotation_absolute, coords_set (0, -GRAVITY, 0));

    /* next intersection with the object, along the parabola under gravity */
    intersect = gmesh_intersect_gravity (&thread_mesh, coords_set (x, y, z), coords_set (vx, vy, vz), acceleration, 0, hits);

    /* exit loop when no intersection forward */
    if (!intersect)
      break;
    dt = hits[0].time;
    n = hits[0].normal;
    fi = hits[0].face;

    double nx, ny, nz;
    coords_get (n, &nx, &ny, &nz);

    /* propagate neutron to reflection point, must be before n_dot_v with gravity */
    PROP_DT (dt);

    /* test if the angle is large in case the object has an internal coating */
    double n2 = nx * nx + ny * ny + nz * nz;
    double n_dot_v = scalar_prod (vx, vy, vz, nx, ny, nz);
    double q = 2 * fabs (n_dot_v) * V2K / sqrt (n2);

    /* handle surface intersection */
    double R = 0;
    /* Reflectivity (see component Guide). */
    if (use_table)
      TableReflecFunc (q, &pTable, &R);
    else {
      double par[] = { R0, Qc, alpha, m, W };
      if (file_coatings) { /* per-face values m, alpha, W, R0, Qc (properties 0-4), parameters as defaults */
        par[0] = gmesh_face_prop (&thread_mesh, fi, 3, R0);
        par[1] = gmesh_face_prop (&thread_mesh, fi, 4, Qc);
        par[2] = gmesh_face_prop (&thread_mesh, fi, 1, alpha);
        par[3] = gmesh_face_prop (&thread_mesh, fi, 0, m);
        par[4] = gmesh_face_prop (&thread_mesh, fi, 2, W);
      }
      StdReflecFunc (q, par, &R);
    }

    if (R > 1) {
      fprintf (stderr, "Guide_anyshape: %s: Warning: Reflectivity R=%g > 1 lowered to R=1.\n", NAME_CURRENT_COMP, R);
      R = 1;
    }
    /* now handle either probability when transmit or reflect */
    if (R > 0) {
      /* when allowing transmission, we should check if indeed we reflect */
      if (!transmit || (transmit && rand01 () < R)) {
        /* reflect velocity: -q -> -2*n*n.v/|n|^2 */
        if (!transmit)
          p *= R;
        n_dot_v *= 2 / n2;
        vx -= nx * n_dot_v;
        vy -= ny * n_dot_v;
        vz -= nz * n_dot_v;
        SCATTER;
      } else {
        if (transmit) {
          p *= (1 - R); /* transmitted beam has non reflected weight */
        } else
          ABSORB;
      }
    } else {
      /* R=0: no reflection: absorb or transmit through when allowed */
      if (!transmit)
        ABSORB;
    }

    /* leave surface by a small amount so that next intersection is not the same one */
    PROP_DT (1e-9);
  } while (intersect && counter++ < CHAR_BUF_LENGTH);
  /* end of main loop */
%}

MCDISPLAY
%{
  /* display the object */
  gmesh_display (&mesh);
%}

END
