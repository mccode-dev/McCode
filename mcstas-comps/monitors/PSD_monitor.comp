/*******************************************************************************
*
* McStas, neutron ray-tracing package
*         Copyright 1997-2002, All rights reserved
*         Risoe National Laboratory, Roskilde, Denmark
*         Institut Laue Langevin, Grenoble, France
*
* Component: PSD_monitor
*
* %I
* Written by: Kim Lefmann
* Date: Feb 3, 1998
* Origin: Risoe
*
* Position-sensitive monitor.
*
* %D
* An (n times m) pixel PSD monitor. This component may also be used as a beam
* detector.
*
* Example: PSD_monitor(xmin=-0.1, xmax=0.1, ymin=-0.1, ymax=0.1, nx=90, ny=90, filename="Output.psd")
*
* %P
* INPUT PARAMETERS:
*
* xmin: [m]             Lower x bound of detector opening
* xmax: [m]             Upper x bound of detector opening
* ymin: [m]             Lower y bound of detector opening
* ymax: [m]             Upper y bound of detector opening
* xwidth: [m]           Width of detector. Overrides xmin, xmax
* yheight: [m]          Height of detector. Overrides ymin, ymax
* nx: [1]               Number of pixel columns
* ny: [1]               Number of pixel rows
* filename: [string]    Name of file in which to store the detector image
* restore_neutron: [1]  If set, the monitor does not influence the neutron state
* nowritefile: [1]      If set, monitor will skip writing to disk
*
* CALCULATED PARAMETERS:
*
* PSD_N: []             Array of neutron counts
* PSD_p: []             Array of neutron weight counts
* PSD_p2: []            Array of second moments
*
* %E
*******************************************************************************/
DEFINE COMPONENT PSD_monitor

SETTING PARAMETERS (int nx=90, int ny=90, string filename=0,
  xmin=-0.05, xmax=0.05, ymin=-0.05, ymax=0.05, xwidth=0, yheight=0,
  int restore_neutron=0, int nowritefile=0)


/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */

SHARE
%{
  #define MCGPU_PORTED_PSD_monitor
%}

DECLARE
%{
  DArray2d PSD_N;
  DArray2d PSD_p;
  DArray2d PSD_p2;
  double* PSD_N_d;
  double* PSD_p_d;
  double* PSD_p2_d;
%}
INITIALIZE
%{
  if (xwidth > 0) {
    xmax = xwidth / 2;
    xmin = -xmax;
  }
  if (yheight > 0) {
    ymax = yheight / 2;
    ymin = -ymax;
  }

  if ((xmin >= xmax) || (ymin >= ymax)) {
    printf ("PSD_monitor: %s: Null detection area !\n"
            "ERROR        (xwidth,yheight,xmin,xmax,ymin,ymax). Exiting",
            NAME_CURRENT_COMP);
    exit (0);
  }

  PSD_N = create_darr2d (nx, ny);
  PSD_p = create_darr2d (nx, ny);
  PSD_p2 = create_darr2d (nx, ny);

  // Use instance name for monitor output if no input was given
  if (!strcmp (filename, "\0"))
    sprintf (filename, "%s", NAME_CURRENT_COMP);

  #ifdef OMPTARGET
  PSD_N_d = mcgpu_to_device (NAME_CURRENT_COMP, "PSD_N", PSD_N[0], (size_t)nx * ny * sizeof (double));
  PSD_p_d = mcgpu_to_device (NAME_CURRENT_COMP, "PSD_p", PSD_p[0], (size_t)nx * ny * sizeof (double));
  PSD_p2_d = mcgpu_to_device (NAME_CURRENT_COMP, "PSD_p2", PSD_p2[0], (size_t)nx * ny * sizeof (double));
  #endif
%}

TRACE
%{
  int backprop = allow_backprop; /* set by caller: also count backward hits */
  double t0 = t;
  ALLOW_BACKPROP;
  PROP_Z0;
  if ((backprop || t >= t0) && z == 0.0 && x > xmin && x < xmax && y > ymin && y < ymax) {
    int i = floor ((x - xmin) * nx / (xmax - xmin));
    int j = floor ((y - ymin) * ny / (ymax - ymin));

    double p2 = p * p;
    #pragma acc atomic
    MC2D (PSD_N, i, j, ny) = MC2D (PSD_N, i, j, ny) + 1;

    #pragma acc atomic
    MC2D (PSD_p, i, j, ny) = MC2D (PSD_p, i, j, ny) + p;

    #pragma acc atomic
    MC2D (PSD_p2, i, j, ny) = MC2D (PSD_p2, i, j, ny) + p2;

    SCATTER;
  }
  if (restore_neutron || !SCATTERED) {
    RESTORE_NEUTRON (INDEX_CURRENT_COMP, x, y, z, vx, vy, vz, t, sx, sy, sz, p);
  }
%}

SAVE
%{
  #ifdef OMPTARGET
  mcgpu_from_device (NAME_CURRENT_COMP, "PSD_N", PSD_N[0], PSD_N_d, (size_t)nx * ny * sizeof (double));
  mcgpu_from_device (NAME_CURRENT_COMP, "PSD_p", PSD_p[0], PSD_p_d, (size_t)nx * ny * sizeof (double));
  mcgpu_from_device (NAME_CURRENT_COMP, "PSD_p2", PSD_p2[0], PSD_p2_d, (size_t)nx * ny * sizeof (double));
  #endif
  if (!nowritefile) {
    DETECTOR_OUT_2D ("PSD monitor", "X position [cm]", "Y position [cm]", xmin * 100.0, xmax * 100.0, ymin * 100.0, ymax * 100.0, nx, ny, &PSD_N[0][0],
                     &PSD_p[0][0], &PSD_p2[0][0], filename);
  }
  %}

FINALLY %{
  #ifdef OMPTARGET
  mcgpu_free (PSD_N_d);
  mcgpu_free (PSD_p_d);
  mcgpu_free (PSD_p2_d);
  #endif
  destroy_darr2d(PSD_N);
  destroy_darr2d(PSD_p);
  destroy_darr2d(PSD_p2);
%}

MCDISPLAY
%{

  multiline (5, (double)xmin, (double)ymin, 0.0, (double)xmax, (double)ymin, 0.0, (double)xmax, (double)ymax, 0.0, (double)xmin, (double)ymax, 0.0, (double)xmin,
             (double)ymin, 0.0);
%}

END
