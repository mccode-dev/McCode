# orighdr :
# orighdr : #
# orighdr : # Pyrolytic Graphite (HOPG if used as single crystal, suitable to model large
# orighdr : # mosaicity graphite monochromators or analysers).
# orighdr : #
# orighdr : # Crystal structure was converted from the cif file of the entry 0014675 in the AMCSD.
# orighdr : # Additional reference: Trucano P, Chen R, Nature, vol. 258, p. 136-137, 1975.
# orighdr : #                       https://www.crystallography.net/cod/9011577.html
# orighdr : #
# orighdr : # The VDOS is the same as used to generate the scattering kernels shipped with
# orighdr : # the ENDF/B-VIII release (extracted from the file tsl-crystalline-graphite.leapr).
# orighdr : #
# orighdr : # With the addition of a VDOS curve in NCrystal v2.0.0 and atomic displacements
# orighdr : # based on VDOS in v2.6.0, the performance is in general very good. However, the
# orighdr : # resulting inelastic cross sections at long wavelengths seems to still be too
# orighdr : # low when comparing with (some) measurements, which one can speculate as being
# orighdr : # a sign that the incoherent approximation is not very good for this strongly
# orighdr : # coherently scattering material, and that there are strong coherent effects in
# orighdr : # single-phonon scattering. This might be solved in the future by adding support
# orighdr : # for coherent scattering kernels. The experimental data used for comparison was
# orighdr : # R.B.Walton, et al. (1960, EXFOR id 11359002) and P.A.Egelstaff (1957, EXFOR id
# orighdr : # 21149003). Additionally, part of the remaining discrepancy might also be
# orighdr : # attributed to density fluctuations in the experimentally studied materials,
# orighdr : # leading to a SANS contribution to the measured cross section at long
# orighdr : # wavelengths.
# orighdr : #
# orighdr : # Finally here is "magic comment" which ensures that NCrystal will model this as
# orighdr : # an anisotropic layered crystal, rotated around the third lattice axis:
# orighdr : # NCRYSTAL<disable>MATCFG[lcaxis=0,0,1]
# orighdr : #
