/*******************************************************************************
*
* McStas, neutron ray-tracing package
*         Copyright (C) 1997-2026, All rights reserved
*         DTU Physics, Kgs. Lyngby, Denmark
*
* Component: UB_matrix
*
* %I
* Written by: Peter Willendrup
* Date: October 2026
* Origin: DTU
*
* Import a UB matrix, inject it into a crystal component, and export it
*
* %D
* Reads a UB matrix and writes the corresponding crystal orientation into the
* SETTING parameters of the crystal component named by 'target', before that
* component initialises. The UB matrix is also written to a text file and is
* stored in the NeXus output as the run-time value of the 'UB' parameter.
*
* Convention: Q = 2*pi*R*UB*(h,k,l), with UB in the frame of the target
* component (z along the beam, y up at zero goniometer angles), no 2*pi in UB
* (|UB*(h,k,l)| = 1/d), B in the Busing-Levy frame (a* along x), and
* R the active rotation of the 'goniometer' component (default: the target).
*
* The UB matrix comes from exactly one of:
* - file: 3 rows of 3 numbers. format="mccode" reads UB in the convention above;
*   format="isaw" reads a Mantid SaveIsawUB file (UB transposed, IPNS frame
*   with x along the beam and z up).
* - UBin: 9 numbers, row-major, e.g. from Mantid getUB().
* - lattice_a..lattice_cc with hkl1/dir1 and hkl2/dir2: two reflections whose
*   directions in the target frame are given (dir1 is kept exactly, dir2 only
*   fixes the plane), as for the NCrystal dir1/dir2 options.
* When a UB is read and lattice_a is also given, the cell of the UB is checked
* against the given cell.
*
* Supported targets (the type is looked up from the instance name):
* Single_crystal, Single_crystal_process, Single_magnetic_crystal,
* Single_crystal_inelastic, Dispersion_relation: the direct lattice vectors ax..cz.
* NCrystal_sample, NCrystal_process, Union_NCrystal_material: dir1/dir2
* appended to cfg.
* The component must be placed BEFORE its target in the instrument, and the
* target must not already define an orientation. For Union processes, place
* the process AT (0,0,0) ABSOLUTE without rotation and set 'goniometer' to the
* Union volume.
*
* Example: UB_matrix(target="Sample", file="sample.mat", format="isaw")
*
* %P
* INPUT PARAMETERS:
* target: [str]           Name of the crystal component to inject into
* file: [str]             UB matrix file to read, 0 for none
* format: [str]           File format, "mccode" or "isaw"
* UBin: [AA^-1]           UB matrix, 9 numbers row-major, used when no file is given
* lattice_a: [AA]         Lattice parameter a; with hkl1..dir2 defines the UB, or checks a read UB
* lattice_b: [AA]         Lattice parameter b
* lattice_c: [AA]         Lattice parameter c
* lattice_aa: [deg]       Lattice angle alpha
* lattice_bb: [deg]       Lattice angle beta
* lattice_cc: [deg]       Lattice angle gamma
* hkl1: [1]               Miller indices of the first reflection
* dir1: [1]               Direction of hkl1 in the target frame
* hkl2: [1]               Miller indices of the second reflection
* dir2: [1]               Direction in the target frame fixing the plane of hkl2
* tol: [rad]              Tolerance on the hkl1-hkl2 opening angle
* goniometer: [str]       Component whose rotation is R, 0 for the target
* filename: [str]         Output file name, 0 for none
*
* OUTPUT PARAMETERS:
* UB: [AA^-1]             The UB matrix, 9 numbers row-major (stored in NeXus)
*
* %E
*******************************************************************************/

DEFINE COMPONENT UB_matrix

SETTING PARAMETERS (string target="Sample", string file=0, string format="mccode",
  vector UBin={0,0,0,0,0,0,0,0,0},
  lattice_a=0, lattice_b=0, lattice_c=0, lattice_aa=90, lattice_bb=90, lattice_cc=90,
  vector hkl1={1,0,0}, vector dir1={0,0,1}, vector hkl2={0,1,0}, vector dir2={1,0,0},
  tol=1e-4, string goniometer=0, string filename="UB.txt",
  vector UB={0,0,0,0,0,0,0,0,0})

SHARE
%{
%include "read_table-lib"
#ifndef UB_MATRIX_DECL
#define UB_MATRIX_DECL
  /* 3x3 matrices are row-major double[9] */
  void ub_mul(double *A, double *B, double *C) { /* C = A*B */
    double T[9];
    for (int i = 0; i < 3; i++)
      for (int j = 0; j < 3; j++)
        T[3*i+j] = A[3*i]*B[j] + A[3*i+1]*B[3+j] + A[3*i+2]*B[6+j];
    for (int i = 0; i < 9; i++) C[i] = T[i];
  }
  void ub_transpose(double *A, double *T) {
    for (int i = 0; i < 3; i++)
      for (int j = 0; j < 3; j++) T[3*j+i] = A[3*i+j];
  }
  double ub_det(double *A) {
    return A[0]*(A[4]*A[8]-A[5]*A[7]) - A[1]*(A[3]*A[8]-A[5]*A[6]) + A[2]*(A[3]*A[7]-A[4]*A[6]);
  }
  int ub_inv(double *A, double *I) { /* returns 0 when singular */
    double d = ub_det(A);
    if (fabs(d) < 1e-300) return 0;
    I[0] = (A[4]*A[8]-A[5]*A[7])/d; I[1] = (A[2]*A[7]-A[1]*A[8])/d; I[2] = (A[1]*A[5]-A[2]*A[4])/d;
    I[3] = (A[5]*A[6]-A[3]*A[8])/d; I[4] = (A[0]*A[8]-A[2]*A[6])/d; I[5] = (A[2]*A[3]-A[0]*A[5])/d;
    I[6] = (A[3]*A[7]-A[4]*A[6])/d; I[7] = (A[1]*A[6]-A[0]*A[7])/d; I[8] = (A[0]*A[4]-A[1]*A[3])/d;
    return 1;
  }
  /* B from the cell (Savici eq. 52, Busing-Levy), no 2pi; returns 0 for an impossible cell */
  int ub_B(double a, double b, double c, double al, double be, double ga, double *B) {
    double G[9], Gs[9];
    al *= DEG2RAD; be *= DEG2RAD; ga *= DEG2RAD;
    G[0] = a*a;            G[1] = a*b*cos(ga);    G[2] = a*c*cos(be);
    G[3] = G[1];           G[4] = b*b;            G[5] = b*c*cos(al);
    G[6] = G[2];           G[7] = G[5];           G[8] = c*c;
    if (a <= 0 || b <= 0 || c <= 0 || ub_det(G) <= 0 || !ub_inv(G, Gs)) return 0;
    double as = sqrt(Gs[0]), bs = sqrt(Gs[4]), cs = sqrt(Gs[8]);
    double cbs = Gs[2]/(as*cs), cgs = Gs[1]/(as*bs);
    B[0] = as; B[1] = bs*cgs;               B[2] = cs*cbs;
    B[3] = 0;  B[4] = bs*sqrt(1 - cgs*cgs); B[5] = -cs*sqrt(1 - cbs*cbs)*cos(al);
    B[6] = 0;  B[7] = 0;                    B[8] = 1/c;
    return 1;
  }
  /* orthonormal triad as columns of T: t1 along v1, t3 along v1 x v2; returns 0 if degenerate */
  int ub_triad(double *v1, double *v2, double *T) {
    double t1[3], t2[3], t3[3];
    double n1 = sqrt(v1[0]*v1[0] + v1[1]*v1[1] + v1[2]*v1[2]);
    vec_prod(t3[0], t3[1], t3[2], v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
    double n3 = sqrt(t3[0]*t3[0] + t3[1]*t3[1] + t3[2]*t3[2]);
    if (n1 <= 0 || n3 <= 1e-12*n1*sqrt(v2[0]*v2[0] + v2[1]*v2[1] + v2[2]*v2[2])) return 0;
    for (int i = 0; i < 3; i++) { t1[i] = v1[i]/n1; t3[i] /= n3; }
    vec_prod(t2[0], t2[1], t2[2], t3[0], t3[1], t3[2], t1[0], t1[1], t1[2]);
    for (int i = 0; i < 3; i++) { T[3*i] = t1[i]; T[3*i+1] = t2[i]; T[3*i+2] = t3[i]; }
    return 1;
  }
  double ub_angle(double *u, double *v) {
    double d = u[0]*v[0] + u[1]*v[1] + u[2]*v[2];
    double n = sqrt((u[0]*u[0] + u[1]*u[1] + u[2]*u[2])*(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]));
    return acos(fmax(-1, fmin(1, d/n)));
  }
  /* U from two reflections (Savici eqs. 76-81); returns 0 on failure */
  int ub_U2(double *B, double *h1, double *d1, double *h2, double *d2, double tol, double *U) {
    double v1[3], v2[3], Tc[9], Tn[9], TcT[9];
    for (int i = 0; i < 3; i++) {
      v1[i] = B[3*i]*h1[0] + B[3*i+1]*h1[1] + B[3*i+2]*h1[2];
      v2[i] = B[3*i]*h2[0] + B[3*i+1]*h2[1] + B[3*i+2]*h2[2];
    }
    if (!ub_triad(v1, v2, Tc) || !ub_triad(d1, d2, Tn)) return 0;
    if (fabs(ub_angle(v1, v2) - ub_angle(d1, d2)) > tol) return 0;
    ub_transpose(Tc, TcT);
    ub_mul(Tn, TcT, U);
    return 1;
  }
  /* B by Cholesky of (UB)^T(UB) (Savici eq. 88), then U = UB*B^-1; returns 0 if not positive definite */
  int ub_split(double *UB, double *U, double *B) {
    double UBT[9], M[9], Bi[9];
    ub_transpose(UB, UBT);
    ub_mul(UBT, UB, M);
    if (M[0] <= 0) return 0;
    B[0] = sqrt(M[0]); B[1] = M[1]/B[0]; B[2] = M[2]/B[0];
    double r = M[4] - B[1]*B[1];
    if (r <= 0) return 0;
    B[4] = sqrt(r); B[5] = (M[5] - B[1]*B[2])/B[4];
    r = M[8] - B[2]*B[2] - B[5]*B[5];
    if (r <= 0) return 0;
    B[8] = sqrt(r); B[3] = B[6] = B[7] = 0;
    if (!ub_inv(B, Bi)) return 0;
    ub_mul(UB, Bi, U);
    return 1;
  }
  void ub_fprint(FILE *f, char *title, double *M) {
    fprintf(f, "# %s\n", title);
    for (int i = 0; i < 3; i++) fprintf(f, "%.12g %.12g %.12g\n", M[3*i], M[3*i+1], M[3*i+2]);
  }
#endif
%}

DECLARE
%{
  double U_out[9];
  double B_out[9];
  double R_out[9];
  double cell[6];
%}

INITIALIZE
%{
#ifndef MCCODE_HAS_GETCOMP_TYPE
#error "UB_matrix needs a code generator that provides _getcomp_type() and MCCODE_COMP_TYPE_<type> (the C code generator in this McCode release does; mccode-antlr may not yet)."
#endif
  double M[9], Bc[9], Uc[9], Ainv[9], A[9];
  int have_file = strlen(file) && strcmp(file, "0") && strcmp(file, "NULL");
  int have_ubin = 0;
  for (int i = 0; i < 9; i++) if (UBin[i]) have_ubin = 1;

  if (have_file + have_ubin + (!have_file && !have_ubin && lattice_a > 0) != 1) {
    fprintf(stderr, "UB_matrix: %s: ERROR: give exactly one of file, UBin, or lattice_a..lattice_cc with hkl1/dir1/hkl2/dir2.\n", NAME_CURRENT_COMP);
    exit(-1);
  }

  if (have_file) {
    /* the first 3 lines that are not blank or '#' comments; ISAW files carry more lines after them */
    FILE *fp = Open_File(file, "r", NULL);
    char line[1024];
    int rows = 0;
    while (fp && rows < 3 && fgets(line, sizeof(line), fp)) {
      char *s = line + strspn(line, " \t");
      if (*s == '#' || *s == '\n' || *s == '\r' || *s == '\0') continue;
      if (sscanf(s, "%lf %lf %lf", &M[3*rows], &M[3*rows+1], &M[3*rows+2]) != 3) break;
      rows++;
    }
    if (fp) fclose(fp);
    if (rows < 3) {
      fprintf(stderr, "UB_matrix: %s: ERROR: could not read 3 rows of 3 numbers from %s.\n", NAME_CURRENT_COMP, file);
      exit(-1);
    }
    if (!strcmp(format, "isaw")) {
      /* file holds UB^T in the IPNS frame: (x,y,z)_McStas = (y,z,x)_IPNS */
      double P[9] = {0,1,0, 0,0,1, 1,0,0}, MT[9];
      ub_transpose(M, MT);
      ub_mul(P, MT, UB);
    } else if (!strcmp(format, "mccode")) {
      for (int i = 0; i < 9; i++) UB[i] = M[i];
    } else {
      fprintf(stderr, "UB_matrix: %s: ERROR: unknown format \"%s\" (use \"mccode\" or \"isaw\").\n", NAME_CURRENT_COMP, format);
      exit(-1);
    }
  } else if (have_ubin) {
    for (int i = 0; i < 9; i++) UB[i] = UBin[i];
  } else {
    if (!ub_B(lattice_a, lattice_b, lattice_c, lattice_aa, lattice_bb, lattice_cc, Bc)) {
      fprintf(stderr, "UB_matrix: %s: ERROR: impossible lattice parameters.\n", NAME_CURRENT_COMP);
      exit(-1);
    }
    if (!ub_U2(Bc, hkl1, dir1, hkl2, dir2, tol, Uc)) {
      fprintf(stderr, "UB_matrix: %s: ERROR: hkl1/hkl2 or dir1/dir2 are parallel, or their opening angles differ by more than tol=%g rad.\n",
              NAME_CURRENT_COMP, tol);
      exit(-1);
    }
    ub_mul(Uc, Bc, UB);
  }

  /* every UB passes the same checks */
  if (!ub_split(UB, U_out, B_out)) {
    fprintf(stderr, "UB_matrix: %s: ERROR: the UB matrix does not describe a crystal ((UB)^T(UB) not positive definite).\n", NAME_CURRENT_COMP);
    exit(-1);
  }
  if (ub_det(UB) < 0) {
    fprintf(stderr, "UB_matrix: %s: ERROR: the UB matrix has a negative determinant (improper U). "
            "It was probably written with the opposite Q sign convention; negate it.\n", NAME_CURRENT_COMP);
    exit(-1);
  }
  { /* cell from B^T B = G*, G = (G*)^-1 */
    double BT[9], Gs[9], G[9];
    ub_transpose(B_out, BT); ub_mul(BT, B_out, Gs); ub_inv(Gs, G);
    cell[0] = sqrt(G[0]); cell[1] = sqrt(G[4]); cell[2] = sqrt(G[8]);
    cell[3] = acos(G[5]/(cell[1]*cell[2]))*RAD2DEG;
    cell[4] = acos(G[2]/(cell[0]*cell[2]))*RAD2DEG;
    cell[5] = acos(G[1]/(cell[0]*cell[1]))*RAD2DEG;
  }
  if ((have_file || have_ubin) && lattice_a > 0) {
    double given[6] = {lattice_a, lattice_b, lattice_c, lattice_aa, lattice_bb, lattice_cc};
    for (int i = 0; i < 6; i++)
      if (fabs(cell[i] - given[i]) > 1e-4*fabs(given[i])) {
        fprintf(stderr, "UB_matrix: %s: ERROR: the UB cell (%g %g %g %g %g %g) does not match the given lattice parameters.\n",
                NAME_CURRENT_COMP, cell[0], cell[1], cell[2], cell[3], cell[4], cell[5]);
        exit(-1);
      }
  }

  /* goniometer rotation: McStas rotations are passive, R is their transpose */
  char *gonio = (strlen(goniometer) && strcmp(goniometer, "0") && strcmp(goniometer, "NULL")) ? goniometer : target;
  Rotation Rp;
  if (!_getcomp_rotation(gonio, Rp)) {
    fprintf(stderr, "UB_matrix: %s: ERROR: no component named \"%s\".\n", NAME_CURRENT_COMP, gonio);
    exit(-1);
  }
  for (int i = 0; i < 3; i++)
    for (int j = 0; j < 3; j++) R_out[3*i+j] = Rp[j][i];

  /* inject into the target */
  char *type = _getcomp_type(target);
  if (!type) {
    fprintf(stderr, "UB_matrix: %s: ERROR: no component named \"%s\".\n", NAME_CURRENT_COMP, target);
    exit(-1);
  }
  if (_getcomp_index(target) <= _getcomp_index(NAME_CURRENT_COMP)) {
    fprintf(stderr, "UB_matrix: %s: ERROR: must be placed before its target \"%s\", which would otherwise already be initialised.\n",
            NAME_CURRENT_COMP, target);
    exit(-1);
  }
  /* direct lattice vectors a, b, c are the rows of UB^-1 (A^T UB = I) */
  ub_inv(UB, Ainv);
  ub_transpose(Ainv, A); /* columns a, b, c */
  int injected = 0;

  /* direct lattice vectors, as COMP_GETPAR3(type, target, ax) etc. */
  #define UB_INJECT_ABC(T, EXTRA) \
    if (!strcmp(type, #T)) { \
      _class_##T##_parameters *p = (_class_##T##_parameters *) _getvar_parameters(target); \
      if (p->ax || p->ay || p->az || p->bx || p->by || p->bz || p->cx || p->cy || p->cz) { \
        fprintf(stderr, "UB_matrix: %s: ERROR: %s \"%s\" already has lattice vectors ax..cz; remove them.\n", NAME_CURRENT_COMP, type, target); \
        exit(-1); \
      } \
      p->ax = A[0]; p->ay = A[3]; p->az = A[6]; \
      p->bx = A[1]; p->by = A[4]; p->bz = A[7]; \
      p->cx = A[2]; p->cy = A[5]; p->cz = A[8]; \
      EXTRA \
      injected = 1; \
    }
  /* NCrystal orientation, appended to cfg: lab directions of (100) and (010) */
  #define UB_INJECT_CFG(T) \
    if (!strcmp(type, #T)) { \
      char *cfgp = ((_class_##T##_parameters *) _getvar_parameters(target))->cfg; \
      if (strstr(cfgp, "dir1") || strstr(cfgp, "dir2")) { \
        fprintf(stderr, "UB_matrix: %s: ERROR: %s \"%s\" cfg already has dir1/dir2; remove them.\n", NAME_CURRENT_COMP, type, target); \
        exit(-1); \
      } \
      char dirs[512]; \
      snprintf(dirs, sizeof(dirs), ";dir1=@crys_hkl:1,0,0@lab:%.17g,%.17g,%.17g;dir2=@crys_hkl:0,1,0@lab:%.17g,%.17g,%.17g", \
               UB[0], UB[3], UB[6], UB[1], UB[4], UB[7]); \
      if (strlen(cfgp) + strlen(dirs) >= 16384) { \
        fprintf(stderr, "UB_matrix: %s: ERROR: cfg of \"%s\" too long to append dir1/dir2.\n", NAME_CURRENT_COMP, target); \
        exit(-1); \
      } \
      strcat(cfgp, dirs); \
      injected = 1; \
    }

  #ifdef MCCODE_COMP_TYPE_Single_crystal
  UB_INJECT_ABC(Single_crystal, p->recip_cell = 0;)
  #endif
  #ifdef MCCODE_COMP_TYPE_Single_crystal_process
  UB_INJECT_ABC(Single_crystal_process, p->recip_cell = 0;)
  #endif
  #ifdef MCCODE_COMP_TYPE_Single_magnetic_crystal
  UB_INJECT_ABC(Single_magnetic_crystal, p->recip_cell = 0;)
  #endif
  #ifdef MCCODE_COMP_TYPE_Single_crystal_inelastic
  UB_INJECT_ABC(Single_crystal_inelastic, p->recip_cell = 0;)
  #endif
  #ifdef MCCODE_COMP_TYPE_FluoCrystal
  UB_INJECT_ABC(FluoCrystal, p->recip_cell = 0;)
  #endif
  #ifdef MCCODE_COMP_TYPE_Dispersion_relation
  UB_INJECT_ABC(Dispersion_relation, )
  #endif
  #ifdef MCCODE_COMP_TYPE_NCrystal_sample
  UB_INJECT_CFG(NCrystal_sample)
  #endif
  #ifdef MCCODE_COMP_TYPE_NCrystal_process
  UB_INJECT_CFG(NCrystal_process)
  #endif
  #ifdef MCCODE_COMP_TYPE_Union_NCrystal_material
  UB_INJECT_CFG(Union_NCrystal_material)
  #endif
  #undef UB_INJECT_ABC
  #undef UB_INJECT_CFG

  if (!injected) {
    fprintf(stderr, "UB_matrix: %s: ERROR: target \"%s\" is a %s, which UB_matrix does not support.\n", NAME_CURRENT_COMP, target, type);
    exit(-1);
  }

  MPI_MASTER(
    printf("UB_matrix: %s: injected into %s \"%s\"; cell %g %g %g AA, %g %g %g deg\n", NAME_CURRENT_COMP, type, target,
           cell[0], cell[1], cell[2], cell[3], cell[4], cell[5]);
    printf("UB_matrix: %s: UB = [%g %g %g; %g %g %g; %g %g %g] 1/AA (no 2pi)\n", NAME_CURRENT_COMP,
           UB[0], UB[1], UB[2], UB[3], UB[4], UB[5], UB[6], UB[7], UB[8]);
  );
%}

SAVE
%{
  if (strlen(filename) && strcmp(filename, "0") && strcmp(filename, "NULL") && !mcdisable_output_files) {
    MPI_MASTER(
      char *path = mcfull_file(filename, NULL);
      FILE *f = fopen(path, "w");
      if (!f) fprintf(stderr, "UB_matrix: %s: WARNING: could not write %s\n", NAME_CURRENT_COMP, path);
      else {
        double RUB[9];
        ub_mul(R_out, UB, RUB);
        fprintf(f, "# UB matrix written by McCode UB_matrix component %s\n", NAME_CURRENT_COMP);
        fprintf(f, "# target: %s\n", target);
        fprintf(f, "# convention: Q = 2*pi*R*UB*(h,k,l); frame: z along beam, y up; no 2*pi in UB; Q = kf - ki; B Busing-Levy (a* along x)\n");
        fprintf(f, "# cell: %.10g %.10g %.10g %.10g %.10g %.10g\n", cell[0], cell[1], cell[2], cell[3], cell[4], cell[5]);
        ub_fprint(f, "UB [1/AA] (read back with format=\"mccode\")", UB);
        ub_fprint(f, "U", U_out);
        ub_fprint(f, "B [1/AA]", B_out);
        ub_fprint(f, "R (goniometer, active)", R_out);
        ub_fprint(f, "R*UB [1/AA] (lab frame)", RUB);
        fclose(f);
      }
      free(path);
    );
  }
%}

END
