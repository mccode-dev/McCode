begin instrument:
  Creator: mcstas 3.99.99
  Source: ODIN_MCPL_baseline.instr
  Parameters:  filter
  Trace_enabled: no
  Default_main: yes
  Embedded_runtime: yes
end instrument

begin simulation
Date: Sun Mar 01 17 29 2026
Ncount: 1000000
Numpoints: 2
Param: filter = 0, filter = 1
end simulation

begin data
type: multiarray_1d(2)
title: Scan of filter
xvars: filter
yvars: (Sphere1_I,Sphere1_ERR (Sphere0_I,Sphere0_ERR (PSD_cut_I,PSD_cut_ERR (PSD_Backtrace_I,PSD_Backtrace_ERR (sample_PSD_I,sample_PSD_ERR (profile_x_I,profile_x_ERR (profile_y_I,profile_y_ERR (wavelength_I,wavelength_ERR (tof_I,tof_ERR (wavelength_tof_I,wavelength_tof_ERR
xlabel: 'filter'
ylabel: 'Intensity'
xlimits: 0 1
filename: mccode.dat
variables: filterSphere1_I Sphere1_ERR Sphere0_I Sphere0_ERR PSD_cut_I PSD_cut_ERR PSD_Backtrace_I PSD_Backtrace_ERR sample_PSD_I sample_PSD_ERR profile_x_I profile_x_ERR profile_y_I profile_y_ERR wavelength_I wavelength_ERR tof_I tof_ERR wavelength_tof_I wavelength_tof_ERR
end data
