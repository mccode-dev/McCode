/* Must FAIL code generation, see README.md and
   docs/GRAMMAR/ADR-records/ADR_20261007_GRAMMAR_FIXES.md
   JUMP NEXT(2) from the 2nd of 3 components (before: jumped to component 2) */
DEFINE INSTRUMENT Err_JUMP_out_of_range()
TRACE
COMPONENT a = Arm() AT (0,0,0) ABSOLUTE
COMPONENT b = Arm() AT (0,0,1) RELATIVE a
  JUMP NEXT(2) WHEN (0)
COMPONENT c = Arm() AT (0,0,1) RELATIVE b
END
