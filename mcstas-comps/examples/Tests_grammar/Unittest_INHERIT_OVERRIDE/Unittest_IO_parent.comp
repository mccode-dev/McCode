DEFINE COMPONENT Unittest_IO_parent
SETTING PARAMETERS ()

USERVARS
%{
  double io_tag;
%}

DECLARE
%{
  double io_val;
%}

INITIALIZE
%{
  io_val = 1;
%}

TRACE
%{
  if (x > 0) ABSORB;
  if (!io_val) p *= 0.5;
%}

END
