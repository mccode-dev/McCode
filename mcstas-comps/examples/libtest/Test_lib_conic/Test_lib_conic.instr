/*******************************************************************************
* Instrument: Test_lib_conic
*
* %I
* %INSTRUMENT_SITE: libtest
*
* Smoke test: builds and runs with the library(ies) in the DECLARE block.
*
* %Test: Ncount=10 Detector: PSD_I=10
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT Test_lib_conic(Ncount=10)

DECLARE
%{
%include "ref-lib"
%include "conic.h"
%}

INITIALIZE
%{
  mcset_ncount(Ncount);
%}

TRACE

COMPONENT Arm = Arm()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  x = rand01()-0.5;
  y = rand01()-0.5;
  p = 1;
  vz = 1000;
%}


COMPONENT PSD = PSD_monitor(xwidth=2.0, yheight=2.0, filename="Test_lib_conic", nx=10, ny=10)
  AT (0,0,0) ABSOLUTE

END
