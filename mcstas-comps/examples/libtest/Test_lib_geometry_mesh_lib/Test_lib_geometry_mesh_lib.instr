/*******************************************************************************
* Instrument: Test_lib_geometry_mesh_lib
*
* %I
* %INSTRUMENT_SITE: libtest
*
* Smoke test: builds and runs with the library geometry-mesh-lib in the instrument.
* Fails to compile or link if the library does not build with the runtime.
* INITIALIZE also checks gmesh_intersect_gravity, and exits with an error
* when a check fails:
* - with zero acceleration it gives the hits of gmesh_intersect, to rounding
* - parabolas through cube.off give the analytic hit times and in_out
* - random parabolas through socket.off give the hits of a fine polyline of
*   straight gmesh_intersect pieces
*
* %Test: Ncount=10 Detector: PSD_I=10
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT Test_lib_geometry_mesh_lib(Ncount=10)

DECLARE
%{
%include "geometry-mesh-lib"

// counts a failed check and prints what failed
void gravity_check (int ok, const char* what, int* failures) {
  if (!ok) {
    fprintf (stderr, "Test_lib_geometry_mesh_lib: FAILED: %s\n", what);
    (*failures)++;
  }
}

// point of the parabola position + time*velocity + time^2/2*acceleration
Coords gravity_parabola (Coords position, Coords velocity, Coords acceleration, double time) {
  return coords_add (position, coords_add (coords_scale (velocity, time), coords_scale (acceleration, 0.5 * time * time)));
}

// uniform number in [low, high] from a fixed sequence, independent of the seed
double gravity_uniform (unsigned long* state, double low, double high) {
  *state = (*state * 6364136223846793005UL + 1442695040888963407UL) & 0xFFFFFFFFFFFFFFFFUL;
  return low + (high - low) * (double)(*state >> 11) / 9007199254740992.0;
}

// checks of gmesh_intersect_gravity; returns the number of failed checks
int gravity_tests (void) {
  gmesh_struct cube;
  gmesh_struct socket;
  gmesh_hit hits[GMESH_MAX_HITS];
  gmesh_hit line_hits[GMESH_MAX_HITS];
  unsigned long state = 1234;
  int failures = 0;
  int nhits;
  int i_ray;
  int mismatches = 0;
  double worst = 0;

  if (!gmesh_init ("cube.off", 1, GMESH_PROPS_IGNORE, &cube) || !gmesh_init_fit ("socket.off", 0.1, 0, 0, 1, GMESH_PROPS_IGNORE, &socket)) {
    fprintf (stderr, "Test_lib_geometry_mesh_lib: FAILED: can not read cube.off or socket.off\n");
    return 1;
  }

  // falling from rest above the unit cube: top at time sqrt(2), bottom at 2
  nhits = gmesh_intersect_gravity (&cube, coords_set (0.5, 2, 0.5), coords_set (0, 0, 0), coords_set (0, -1, 0), 0, hits);
  gravity_check (nhits == 2 && fabs (hits[0].time - sqrt (2)) < 1e-12 && hits[0].in_out == 1 && fabs (hits[1].time - 2) < 1e-12 && hits[1].in_out == -1,
                 "fall from rest through cube.off", &failures);

  // entering through the front face, leaving through the bottom at time sqrt(2)
  nhits = gmesh_intersect_gravity (&cube, coords_set (0.5, 0.5, -1), coords_set (0, 0, 1), coords_set (0, -0.5, 0), 0, hits);
  gravity_check (nhits == 2 && fabs (hits[0].time - 1) < 1e-12 && hits[0].in_out == 1 && fabs (hits[1].time - sqrt (2)) < 1e-12 && hits[1].in_out == -1,
                 "front face in, bottom out of cube.off", &failures);

  // thrown up into the cube from below, falling out through the same face
  nhits = gmesh_intersect_gravity (&cube, coords_set (0.5, -1, 0.5), coords_set (0, 2, 0), coords_set (0, -1.2, 0), 0, hits);
  gravity_check (nhits == 2 && fabs (hits[0].time - (2 - sqrt (1.6)) / 1.2) < 1e-12 && hits[0].in_out == 1
                   && fabs (hits[1].time - (2 + sqrt (1.6)) / 1.2) < 1e-12 && hits[1].in_out == -1 && hits[0].face == hits[1].face,
                 "in and out through the bottom of cube.off", &failures);

  // t_min skips the hits before it
  nhits = gmesh_intersect_gravity (&cube, coords_set (0.5, -1, 0.5), coords_set (0, 2, 0), coords_set (0, -1.2, 0), 1, hits);
  gravity_check (nhits == 1 && hits[0].in_out == -1, "t_min", &failures);

  // the arc passes above the cube
  nhits = gmesh_intersect_gravity (&cube, coords_set (-1, 1.5, 0.5), coords_set (1, 0, 0), coords_set (0, -0.1, 0), 0, hits);
  gravity_check (nhits == 0, "arc above cube.off", &failures);

  for (i_ray = 0; i_ray < 2000; i_ray++) {
    Coords position = coords_set (gravity_uniform (&state, -0.1, 0.1), gravity_uniform (&state, -0.1, 0.1), gravity_uniform (&state, -0.1, 0.1));
    Coords velocity = coords_set (gravity_uniform (&state, -1, 1), gravity_uniform (&state, -1, 1), gravity_uniform (&state, -1, 1));
    Coords acceleration = coords_set (gravity_uniform (&state, -5, 5), gravity_uniform (&state, -5, 5), gravity_uniform (&state, -5, 5));
    double time_end = 0.2;
    int nsteps = 4000;
    double step = time_end / nsteps;
    double line_times[GMESH_MAX_HITS];
    int nline = 0;
    int nstraight;
    int i_step;
    int i_hit;

    // zero acceleration: the hits of the straight line, to rounding
    nstraight = gmesh_intersect (&socket, position, velocity, -FLT_MAX, line_hits);
    nhits = gmesh_intersect_gravity (&socket, position, velocity, coords_set (0, 0, 0), -FLT_MAX, hits);
    if (nhits != nstraight) {
      mismatches++;
      continue;
    }
    for (i_hit = 0; i_hit < nhits; i_hit++) {
      if (fabs (hits[i_hit].time - line_hits[i_hit].time) > 1e-12 * (1 + fabs (line_hits[i_hit].time)) || hits[i_hit].in_out != line_hits[i_hit].in_out)
        mismatches++;
    }

    // the parabola against a polyline of nsteps straight pieces up to time_end
    for (i_step = 0; i_step < nsteps; i_step++) {
      Coords start = gravity_parabola (position, velocity, acceleration, i_step * step);
      Coords chord = coords_sub (gravity_parabola (position, velocity, acceleration, (i_step + 1) * step), start);
      int npiece = gmesh_intersect (&socket, start, chord, 0, line_hits);
      int i_piece;
      for (i_piece = 0; i_piece < npiece && line_hits[i_piece].time <= 1 && nline < GMESH_MAX_HITS; i_piece++) {
        line_times[nline] = (i_step + line_hits[i_piece].time) * step;
        nline++;
      }
    }
    nhits = gmesh_intersect_gravity (&socket, position, velocity, acceleration, 0, hits);
    while (nhits > 0 && hits[nhits - 1].time > time_end)
      nhits--;
    if (nhits != nline) {
      mismatches++;
      continue;
    }
    for (i_hit = 0; i_hit < nhits; i_hit++) {
      if (fabs (hits[i_hit].time - line_times[i_hit]) > worst)
        worst = fabs (hits[i_hit].time - line_times[i_hit]);
    }
  }
  printf ("Test_lib_geometry_mesh_lib: socket.off: %d of 2000 random rays differ from the line or polyline, worst time difference %g s\n", mismatches,
          worst);
  gravity_check (mismatches == 0 && worst < 1e-6, "random parabolas through socket.off", &failures);

  gmesh_free (&cube);
  gmesh_free (&socket);
  return failures;
}
%}

INITIALIZE
%{
  mcset_ncount(Ncount);
  if (gravity_tests ())
    exit (fprintf (stderr, "Test_lib_geometry_mesh_lib: gmesh_intersect_gravity checks failed\n"));
%}

TRACE

COMPONENT Arm = Arm()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  x = rand01()-0.5;
  y = rand01()-0.5;
  p = 1;
  vz = 1000;
%}

COMPONENT PSD = PSD_monitor(xwidth=2.0, yheight=2.0, filename="geometry-mesh-lib", nx=10, ny=10)
  AT (0,0,0) ABSOLUTE

END
