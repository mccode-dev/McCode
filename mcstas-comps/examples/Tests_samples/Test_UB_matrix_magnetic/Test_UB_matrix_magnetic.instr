/*******************************************************************************
* Instrument: Test_UB_matrix_magnetic
*
* %I
* Written by: Peter Willendrup
* Date: November 2026
* Origin: DTU
* %INSTRUMENT_SITE: Tests_samples
*
* Test of the UB_matrix component injecting a UB matrix into Single_magnetic_crystal
*
* %D
* A La2CuO4 crystal with the same orientation as in Test_UB_matrix, illuminated
* by a white beam. Single_magnetic_crystal can not be combined with
* Single_crystal in one instrument, hence this separate test.
* SAMPLE=0: Single_magnetic_crystal reference, direct lattice vectors given
* SAMPLE=1: Single_magnetic_crystal, UB_matrix with UBin
* Both give the same Laue pattern and intensity.
*
* %Example: SAMPLE=0 Detector: Laue_I=1.9399e-08
* %Example: SAMPLE=1 Detector: Laue_I=1.9399e-08
*
* %P
* SAMPLE: [1]  Orientation input: 0 reference, 1 UBin
* A3: [deg]    Goniometer rotation about the vertical axis
*
* %L
* A. T. Savici, Introduction to the use of the UB matrix (ORNL, 2011)
*
* %E
*******************************************************************************/
DEFINE INSTRUMENT Test_UB_matrix_magnetic(int SAMPLE=1, A3=0)

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

COMPONENT Source = Source_simple(radius=0.001, dist=1, focus_xw=0.002, focus_yh=0.002, lambda0=3, dlambda=2.5)
  AT (0,0,0) RELATIVE Origin

COMPONENT Polariser = Set_pol(py=1)
  AT (0,0,0.5) RELATIVE Origin

COMPONENT gonio = Arm()
  AT (0,0,1) RELATIVE Origin
  ROTATED (0,A3,0) RELATIVE Origin

COMPONENT UB_mag = UB_matrix(target="Sample", filename="UB_mag.txt",
    UBin={-0.132021430393, 0.130897219768, 0, 0, 0, 0.0760456273764, 0.132021430393, 0.130897219768, 0})
  AT (0,0,0) RELATIVE gonio

COMPONENT Sample_ref = Single_magnetic_crystal(
    atom_sites="La2CuO4_rial_yzdirect_rel_all_nolabel.txt", xwidth=0.005, yheight=0.005, zdepth=0.005,
    delta_d_d=1e-4, mosaic=100, q_min=0.1, q_max=5, na=1, nb=1, nc=1, sigma_abs=0.086883, sigma_inc=0.011368, mx=0, my=1, mz=0,
    ax=-3.78726392004, ay=0, az=3.78726392004, bx=3.81979083197, by=0, bz=3.81979083197, cx=0, cy=13.15, cz=0)
  WHEN (SAMPLE==0) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Sample = Single_magnetic_crystal(
    atom_sites="La2CuO4_rial_yzdirect_rel_all_nolabel.txt", xwidth=0.005, yheight=0.005, zdepth=0.005,
    delta_d_d=1e-4, mosaic=100, q_min=0.1, q_max=5, na=1, nb=1, nc=1, sigma_abs=0.086883, sigma_inc=0.011368, mx=0, my=1, mz=0)
  WHEN (SAMPLE==1) AT (0,0,0) RELATIVE gonio
EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Laue = PSD_monitor_4PI(radius=0.5, nx=180, ny=90, filename="Laue")
  AT (0,0,0) RELATIVE gonio

END
