/*******************************************************************************
*
* McStas, neutron ray-tracing package
*         Copyright (C) 1997-2026, All rights reserved
*         DTU Physics, Kgs. Lyngby, Denmark
*
* Component: PowderN_porous
*
* %I
* Written by: Peter Willendrup
* Date: Nov 2026
* Origin: DTU
*
* Porous PowderN: powder matrix with mesh pores, partly filled by a liquid
*
* %D
* PowderN (INHERIT) with a pore mesh inside the matrix. All PowderN parameters
* describe the matrix material and its outer shape (box, cylinder, sphere or
* geometry= mesh file; hollow shapes/concentric are not supported).
*
* pores: closed mesh file (OFF/PLY/STL, coordinates in m in the component frame)
*   with one closed, outward oriented shell per pore. Shells may overlap and
*   stick out of the outer shape (open channels); see make_pores.py in
*   examples/Tests_samples/Test_PowderN_porous.
* Pores are void above y = fill_y and filled with an incoherent, absorbing
*   liquid below (e.g. water sucked up through the pores). The liquid is set by
*   fill_Vc, fill_sigma_inc, fill_sigma_abs; fill_Vc=0 leaves all pores void.
*
* Single scattering as PowderN: each ray is transmitted, or scattered once
* (matrix coherent/incoherent or liquid incoherent), attenuated along the full
* in- and outgoing paths through matrix and liquid.
* Rays crossing more than GMESH_MAX_HITS (50) pore surfaces lose the farther
* pores; raise it with DEPENDENCY " -DGMESH_MAX_HITS=200 " in the instrument.
* The limit is printed at start, and FINALLY reports how many rays reached it.
*
* Example: PowderN_porous(reflections="Al.laz", radius=0.005, yheight=0.02,
*   pores="pores.off", fill_y=0, fill_Vc=29.9, fill_sigma_inc=160.5, fill_sigma_abs=0.665)
*
* %P
* pores: [str]             Closed mesh file with the pores. "NULL": no pores.
* fill_y: [m]              Pores below this height (local y) hold the liquid.
* fill_Vc: [AA^3]          Volume per formula unit of the liquid. 0: no liquid.
* fill_sigma_inc: [barns]  Incoherent cross section per formula unit of the liquid.
* fill_sigma_abs: [barns]  Absorption cross section per formula unit of the liquid at 2200 m/s.
* p_fill: [1]              Fraction of rays scattered incoherently in the liquid.
* (all others):            See PowderN.
*
* %L
* See also: PowderN
*
* %E
*******************************************************************************/
DEFINE COMPONENT PowderN_porous INHERIT PowderN

SETTING PARAMETERS (string pores="NULL", fill_y=0, fill_Vc=0, fill_sigma_inc=0, fill_sigma_abs=0, p_fill=0.1)

SHARE INHERIT PowderN EXTEND
%{
  #ifndef POWDERN_POROUS_DECL
  #define POWDERN_POROUS_DECL
  #define PPOR_MAX (GMESH_MAX_HITS + 3)

  /* Path of the line (x,y,z)+t*(vx,vy,vz) through the outer shape, cut into
     segments ts[k]..ts[k+1] of material mat[k]: 0 matrix, 1 liquid, 2 void.
     Returns the number of segments, 0 when the shape is not ahead. */
  #pragma acc routine seq
  int
  ppor_path (int shape, gmesh_struct* om, gmesh_struct* pm, double r, double xw, double yh, double zd, double yfill,
             double x, double y, double z, double vx, double vy, double vz, double* ts, int* mat, int* nhits) {
    gmesh_hit hits[GMESH_MAX_HITS];
    double t0 = 0, t3 = 0, tb, tf;
    int hit = 0, nh = 0, i, n = 0, depth = 0;
    if (shape == 0)
      hit = cylinder_intersect (&t0, &t3, x, y, z, vx, vy, vz, r, yh);
    else if (shape == 1)
      hit = box_intersect (&t0, &t3, x, y, z, vx, vy, vz, xw, yh, zd);
    else if (shape == 2)
      hit = sphere_intersect (&t0, &t3, x, y, z, vx, vy, vz, r);
    else if (shape == 3)
      hit = gmesh_entry_exit (om, coords_set (x, y, z), coords_set (vx, vy, vz), &t0, &t3, NULL);
    *nhits = 0;
    if (!hit || t3 <= 0)
      return 0;
    if (pm->ntris) /* whole line: pores sticking out before t0 set the depth there */
      nh = gmesh_intersect (pm, coords_set (x, y, z), coords_set (vx, vy, vz), -FLT_MAX, hits);
    *nhits = nh;
    for (i = 0; i < nh && hits[i].time <= t0; i++)
      depth += hits[i].in_out;
    tf = vy ? (yfill - y) / vy : -FLT_MAX;
    ts[0] = t0;
    for (; i <= nh; i++) {
      tb = (i < nh && hits[i].time < t3) ? hits[i].time : t3;
      if (tf > ts[n] && tf < tb) { /* fill level cuts this stretch */
        mat[n] = depth > 0 ? (y + vy * 0.5 * (ts[n] + tf) < yfill ? 1 : 2) : 0;
        ts[++n] = tf;
      }
      mat[n] = depth > 0 ? (y + vy * 0.5 * (ts[n] + tb) < yfill ? 1 : 2) : 0;
      ts[++n] = tb;
      if (tb >= t3)
        break;
      depth += hits[i].in_out; /* +1 entering a pore, -1 leaving */
    }
    return n;
  }

  /* sum of (segment length in [ta,tb]) * mu[material], length in m */
  #pragma acc routine seq
  double
  ppor_tau (double* ts, int* mat, int n, double ta, double tb, double v, double* mu) {
    double tau = 0, lo, hi;
    int k;
    for (k = 0; k < n; k++) {
      lo = ts[k] > ta ? ts[k] : ta;
      hi = ts[k + 1] < tb ? ts[k + 1] : tb;
      if (hi > lo)
        tau += (hi - lo) * v * mu[mat[k]];
    }
    return tau;
  }

  /* time (>=0) after path length s inside material m */
  #pragma acc routine seq
  double
  ppor_locate (double* ts, int* mat, int n, int m, double s, double v) {
    double lo, d;
    int k;
    for (k = 0; k < n; k++) {
      lo = ts[k] > 0 ? ts[k] : 0;
      if (mat[k] != m || ts[k + 1] <= lo)
        continue;
      d = (ts[k + 1] - lo) * v;
      if (s <= d)
        return lo + s / v;
      s -= d;
    }
    return ts[n];
  }
  #endif
%}

DECLARE INHERIT PowderN EXTEND
%{
  gmesh_struct pmesh;
  double fill_my_a;
  double fill_my_inc;
  double ppor_nnear; /* rays with >= 80 % of GMESH_MAX_HITS pore crossings */
  double ppor_nfull; /* rays with GMESH_MAX_HITS crossings, farther pores possibly dropped */
%}

INITIALIZE INHERIT PowderN EXTEND
%{
  if (thickness || concentric) {
    fprintf (stderr, "PowderN_porous: %s: hollow shapes (thickness, concentric) are not supported.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if (fill_Vc < 0 || fill_sigma_inc < 0 || fill_sigma_abs < 0) {
    fprintf (stderr, "PowderN_porous: %s: fill_Vc, fill_sigma_inc and fill_sigma_abs must be >= 0.\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if (p_fill < 0 || p_fill > 1) {
    fprintf (stderr, "PowderN_porous: %s: p_fill=%g must be in [0,1].\n", NAME_CURRENT_COMP, p_fill);
    exit (-1);
  }
  if (fill_Vc > 0 && !fill_sigma_inc && !fill_sigma_abs)
    printf ("PowderN_porous: %s: WARNING: fill_Vc > 0 but the liquid has no cross sections, pores stay void.\n", NAME_CURRENT_COMP);
  if (!fill_Vc && (fill_sigma_inc || fill_sigma_abs))
    printf ("PowderN_porous: %s: WARNING: fill_Vc=0, the liquid cross sections are ignored.\n", NAME_CURRENT_COMP);
  memset (&pmesh, 0, sizeof (pmesh));
  ppor_nnear = ppor_nfull = 0;
  if (pores && strlen (pores) && strcmp (pores, "NULL") && strcmp (pores, "0")) {
    if (!gmesh_init (pores, 1, GMESH_PROPS_IGNORE, &pmesh) || !gmesh_check_closed (&pmesh)) {
      fprintf (stderr, "PowderN_porous: %s: can not use the pore mesh %s.\n", NAME_CURRENT_COMP, pores);
      exit (-1);
    }
    MPI_MASTER (printf ("PowderN_porous: %s: %ld pore triangles, up to GMESH_MAX_HITS=%d pore surface crossings per ray\n"
                        "  (raise with DEPENDENCY \" -DGMESH_MAX_HITS=... \" in the instrument).\n",
                        NAME_CURRENT_COMP, (long)pmesh.ntris, GMESH_MAX_HITS););
  } else if (fill_Vc > 0)
    printf ("PowderN_porous: %s: WARNING: no pore mesh, the liquid is not used.\n", NAME_CURRENT_COMP);
  fill_my_a = fill_Vc > 0 ? fill_sigma_abs / fill_Vc * 2200 * 100 : 0; /* barn/AA^3 -> 1/m */
  fill_my_inc = fill_Vc > 0 ? fill_sigma_inc / fill_Vc * 100 : 0;
%}

TRACE
%{
  double ts[PPOR_MAX], mu[3], L[3], q[4], u0[3] = { 1, 0, 0 }, u1[3] = { 0, 1, 0 };
  double v, w, tsc, my_s = 0, Nq = 0, sum, r, solid_angle, arg, theta, alpha = 0, alpha0, sg, vnorm;
  double tmp_vx, tmp_vy, tmp_vz, vout_x, vout_y, vout_z, nx, ny, nz, v1;
  double d_phi_thread = d_phi;
  int mat[PPOR_MAX], n, ev, m, line, nh;
  gmesh_struct om = mesh, pm = pmesh; /* per-thread copies, as PowderN on GPU */

  n = ppor_path (line_info.shape, &om, &pm, radius, xwidth, yheight, zdepth, fill_y, x, y, z, vx, vy, vz, ts, mat, &nh);
  if (nh >= 0.8 * GMESH_MAX_HITS) { /* rare: atomics only here */
    #pragma acc atomic
    ppor_nnear += 1;
    if (nh >= GMESH_MAX_HITS) {
      #pragma acc atomic
      ppor_nfull += 1;
    }
  }
  if (n) {
    v = sqrt (vx * vx + vy * vy + vz * vz);
    if (line_info.V_0 > 0 && line_info.count) {
      Nq = calc_xsect (v, line_info.q_v, line_info.my_s_v2, line_info.count, &line_info.my_s_v2_sum, &line_info);
      my_s = line_info.my_s_v2_sum / (v * v);
    }
    mu[0] = line_info.V_0 > 0 ? line_info.my_a_v / v + my_s + line_info.my_inc : 0;
    mu[1] = fill_my_a / v + fill_my_inc;
    mu[2] = 0;
    L[0] = ppor_tau (ts, mat, n, 0, ts[n], 1, u0);
    L[1] = ppor_tau (ts, mat, n, 0, ts[n], 1, u1);

    /* event: 0 transmit, 1 matrix incoherent, 2 matrix coherent, 3 liquid incoherent */
    q[0] = p_transmit;
    q[1] = (L[0] > 0 && mu[0] > 0 && line_info.my_inc > 0) ? p_inc : 0;
    q[2] = (L[0] > 0 && mu[0] > 0 && Nq > 0) ? p_interact : 0;
    q[3] = (L[1] > 0 && fill_my_inc > 0) ? p_fill : 0;
    sum = q[0] + q[1] + q[2] + q[3];
    r = rand01 () * sum;
    for (ev = 0; ev < 3 && r >= q[ev]; ev++)
      r -= q[ev];
    if (!q[ev])
      ev = 0; /* rand01() == 1.0 edge */

    if (ev == 0) {
      p *= exp (-ppor_tau (ts, mat, n, 0, ts[n], v, mu)) * sum / q[0];
    } else {
      m = (ev == 3);
      tsc = ppor_locate (ts, mat, n, m, rand01 () * L[m] * v, v);
      w = L[m] * v * exp (-ppor_tau (ts, mat, n, 0, tsc, v, mu)) * sum / q[ev];
      PROP_DT (tsc);
      SCATTER;
      if (ev == 2) { /* Bragg, as PowderN */
        line = Nq > 1 ? floor (Nq * rand01 ()) : 0;
        if (line >= Nq)
          line = Nq - 1;
        arg = line_info.q_v[line] * (1 + (line_info.w_v[line] ? line_info.w_v[line] * randnorm () : 0)) / (2.0 * v);
        if (fabs (arg) > 1)
          ABSORB;
        sg = tth_sign ? tth_sign / fabs (tth_sign) : (randpm1 () > 0 ? 1 : -1);
        theta = asin (arg);
        if (d_phi_thread) {
          arg = sin (d_phi_thread * DEG2RAD / 2) / sin (2 * theta);
          if (arg < -1 || arg > 1)
            d_phi_thread = 0;
          else
            alpha = 2 * asin (arg);
        }
        if (d_phi_thread) {
          alpha0 = 0.5 * randpm1 () * fabs (alpha) + (focus_flip ? M_PI_2 : 0);
        } else
          alpha0 = PI * randpm1 ();
        vnorm = 0;
        if (target_index) {
          vec_prod (tmp_vx, tmp_vy, tmp_vz, vx, vy, vz, tgt_x, tgt_y, tgt_z);
          vnorm = sqrt (tmp_vx * tmp_vx + tmp_vy * tmp_vy + tmp_vz * tmp_vz) / v;
        }
        if (vnorm < 0.01) {
          if (fabs (vx) < fabs (vz)) {
            nx = 1; ny = 0; nz = 0;
          } else {
            nx = 0; ny = 0; nz = 1;
          }
          vec_prod (tmp_vx, tmp_vy, tmp_vz, vx, vy, vz, nx, ny, nz);
        }
        rotate (vout_x, vout_y, vout_z, vx, vy, vz, 2 * sg * theta, tmp_vx, tmp_vy, tmp_vz);
        rotate (tmp_vx, tmp_vy, tmp_vz, vout_x, vout_y, vout_z, alpha0, vx, vy, vz);
        vx = tmp_vx;
        vy = tmp_vy;
        vz = tmp_vz;
        w *= Nq * line_info.my_s_v2[line] / (v * v);
        if (d_phi_thread) {
          w *= fabs (alpha) / PI;
          if (tth_sign)
            w *= 0.5;
        }
      } else { /* incoherent, matrix or liquid, as PowderN */
        if (d_omega && d_phi_thread)
          randvec_target_rect_angular (&vx, &vy, &vz, &solid_angle, tgt_x, tgt_y, tgt_z, d_omega * DEG2RAD, d_phi_thread * DEG2RAD, ROT_A_CURRENT_COMP);
        else if (d_phi_thread)
          randvec_target_rect_angular (&vx, &vy, &vz, &solid_angle, tgt_x, tgt_y, tgt_z, 2 * PI, d_phi_thread * DEG2RAD, ROT_A_CURRENT_COMP);
        else
          randvec_target_circle (&vx, &vy, &vz, &solid_angle, 0, 0, 1, 0);
        v1 = sqrt (vx * vx + vy * vy + vz * vz);
        vx *= v / v1;
        vy *= v / v1;
        vz *= v / v1;
        w *= (m ? fill_my_inc : line_info.my_inc) * solid_angle / (4 * PI);
      }
      n = ppor_path (line_info.shape, &om, &pm, radius, xwidth, yheight, zdepth, fill_y, x, y, z, vx, vy, vz, ts, mat, &nh);
      if (!n)
        ABSORB; /* rounding at the surface */
      p *= w * exp (-ppor_tau (ts, mat, n, 0, ts[n], v, mu));
    }
  }
%}

FINALLY INHERIT PowderN EXTEND
%{
  #ifdef USE_MPI
  if (mpi_node_count > 1) {
    mc_MPI_Sum (&ppor_nnear, 1);
    mc_MPI_Sum (&ppor_nfull, 1);
  }
  #endif
  MPI_MASTER (if (ppor_nnear > 0)
    printf ("PowderN_porous: %s: WARNING: %g rays crossed >= 80 %% and %g rays 100 %% of GMESH_MAX_HITS=%d pore surfaces\n"
            "  (at 100 %%, farther pores may be dropped). Raise with DEPENDENCY \" -DGMESH_MAX_HITS=... \".\n",
            NAME_CURRENT_COMP, ppor_nnear, ppor_nfull, GMESH_MAX_HITS););
  gmesh_free (&pmesh);
%}

MCDISPLAY INHERIT PowderN EXTEND
%{
  gmesh_display (&pmesh);
%}

END
