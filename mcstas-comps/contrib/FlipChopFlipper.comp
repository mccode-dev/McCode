* Release: McStas 3.7.9
* Origin: ORNL
*
* Resonant RF Spin Flipper for FlipChop at SNS
*
* %D
* This component calculates the polarization of a neutron beam interacting with an idealized
* resonant RF flipper. A perfect match between the RF and Larmor frequency is assumed. The
* component assumes a time of flight source and adjusts the RF amplitude by 1/t to ensure A
* high flipping probability over the entire wavelength band
*
* %P
* nx:     [1] x-component of the normalized RF field direction.
* ny:     [1] y-component of the normalized RF field direction.
* nz:     [1] z-component of the normalized RF field direction.
* xwidth: [m] Width of the spin flipper.
* yheight:[m] Height of the spin flipper.
* zdepth: [m] Thickness of the spin flipper along the beam direction.
* TOFOn:  [1] Use TOF operation (1) or continuous-source operation (0).
* tbit:   [s] Duration of one bit in the modulation sequence.
* L:      [m] Distance from the source to the flipper.
* tdelay: [s] Time offset of the modulation sequence.
* SEQ:    [string] Binary modulation sequence containing 0 and 1 characters.
*
* %E
*******************************************************************************/

DEFINE COMPONENT FlipChopFlipper

SETTING PARAMETERS (nx=1, ny=0, nz=0, xwidth=0.05, yheight=0.05, zdepth=0.005, TOFOn=1, tbit = 1e-5, L=30, tdelay = 0.015, string SEQ="0110100110010110100101100110101")

/* Neutron parameters: (x,y,z,vx,vy,vz,t,sx,sy,sz,p) */
TRACE
%{
  int hit;
  int NSEQ = strlen (SEQ);
  long EntryBit, ExitBit;
  double t0, t1, tentry, texit, phi, v_assumed, ta, tb;

  hit = box_intersect (&t0, &t1, x, y, z, vx, vy, vz, xwidth, yheight, zdepth);
  if (hit) {

    tentry = t + t0 - tdelay;
    texit = t + t1 - tdelay;

    PROP_DT (t0);
    if (fabs (z - -zdepth * 0.5) > DBL_EPSILON) {
      /*neutron must have hit the side walls*/
      ABSORB;
    }

    /*move to center of box and flip*/
    PROP_Z0;
    SCATTER;

    if (TOFOn == 1) {
      v_assumed = L / t;
    } else {
      v_assumed = vz;
    }

    double omega = PI * v_assumed / zdepth;

    EntryBit = floor (tentry / tbit);
    ExitBit = floor (texit / tbit);

    phi = 0;

    for (long k = EntryBit; k <= ExitBit; k++) {
      int j = ((k % NSEQ) + NSEQ) % NSEQ;
      ta = fmax (k * tbit, tentry);
      tb = fmin ((k + 1) * tbit, texit);
      phi += omega * (SEQ[j] - 48) * (tb - ta);
    }

    double sx0 = sx;
    double sy0 = sy;
    double sz0 = sz;

    rotate (sx, sy, sz, sx0, sy0, sz0, phi, nx, ny, nz);

    PROP_DT ((t1 - t0) / 2); /*propagate the remaining distance to the box exit*/
    if (fabs (z - zdepth * 0.5) > DBL_EPSILON) {
      ABSORB;
    }
  }
%}

MCDISPLAY
%{
  double dx = xwidth / 16;
  double dy = yheight / 8;

  box (0, 0, 0, xwidth, yheight, zdepth, 0, 0, 1, 0);

  line (dx, -dy, 0, dx, -dy + yheight / 2.0, 0);
  line (-dx, dy, 0, -dx, dy - yheight / 2.0, 0);
  line (dx, -dy + yheight / 2.0, 0, dx + xwidth / 16, -dy + yheight - yheight / 16, 0);
  line (dx, -dy + yheight / 2.0, 0, dx - xwidth / 16, -dy + yheight - yheight / 16, 0);

  line (-dx, dy - yheight / 2.0, 0, -dx + xwidth / 16, dy - yheight + yheight / 16, 0);
  line (-dx, dy - yheight / 2.0, 0, -dx - xwidth / 16, dy - yheight + yheight / 16, 0);
%}

END
