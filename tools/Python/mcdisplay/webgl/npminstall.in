#!/usr/bin/env bash
@MCCODE_BASH_STANDARD_PREAMBLE@

set -e

# Build the static webgl app directly next to this script - no per-user
# folder, no copying: this dir already holds App.tsx, package.json etc.
FILE=${0}
TOOLDIR=$(cd "$(dirname "$FILE")" && pwd)
cd "${TOOLDIR}"

npm install
npm run build
