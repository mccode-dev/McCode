#!/usr/bin/env python3
# Compile and run the C library unit tests in tools/libcheck.
# Usage: mccode-libcheck [test.c ...]   (default: tools/libcheck/*-test.c; $CC, $AR)
import os, pathlib, subprocess, sys, tempfile

# a plain McStas developer build (3.99.999) of mccode-r.h.in (no MPI, no OPENACC)
SUBS = {'MCCODE_STRING': ' 3.99.999, git', 'MCCODE_DATE': 'git', 'MCCODE_VERSION': '3.99.999',
        'MCCODE_VERSION_MACRO': '399999', 'MCCODE_NAME': 'mcstas', 'MCCODE_PARTICLE': 'neutron',
        'MCCODE_PARTICLE_CODE': '2112', 'MCCODE_LIBENV': 'MCSTAS'}
CFLAGS = ['-O0', '-g', '-ffunction-sections', '-fdata-sections']
MACOS = sys.platform == 'darwin'
DEAD_STRIP = '-Wl,-dead_strip' if MACOS else '-Wl,--gc-sections'

root = pathlib.Path(__file__).resolve().parents[2]
share, check = root / 'common' / 'lib' / 'share', root / 'tools' / 'libcheck'
cc, ar = os.environ.get('CC', 'cc'), os.environ.get('AR', 'ar')
tests = [pathlib.Path(f) for f in sys.argv[1:]] or sorted(check.glob('*-test.c'))

def run(cmd, **kw):
    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True, **kw)

failed = []
def report(name, r):
    print('%-40s %s' % (name, 'OK' if r.returncode == 0 else 'FAIL'))
    if r.returncode:
        failed.append(name)
        print(r.stderr)

with tempfile.TemporaryDirectory() as d:
    d = pathlib.Path(d)
    # share libs as plain C: configured mccode-r.h, and the McStas DSL
    # %include "x" as #include "x.h"
    h = (share / 'mccode-r.h.in').read_text()
    for k, v in SUBS.items():
        h = h.replace('@%s@' % k, v)
    (d / 'mccode-r.h').write_text(h)
    for f in share.glob('*.[ch]'):
        lines = ['#include "%s.h"' % l.split('"')[1] if l.startswith('%include') else l
                 for l in f.read_text().splitlines()]
        (d / f.name).write_text('\n'.join(lines) + '\n')

    inc = ['-I', d, '-I', check]
    # every library compiled once into libmccode-share.a, preceded like in a
    # generated instrument by mcstas-basics.h (the fake instrument) and mccode-r.h;
    # a test link pulls only the members it uses
    objs = []
    for src in sorted(d.glob('*.c')):
        if src.name == 'mccode_main.c':  # the instrument's main(), not a library
            continue
        objs.append(d / (src.stem + '.o'))
        r = run([cc] + CFLAGS + inc + ['-include', 'mcstas-basics.h', '-include', 'mccode-r.h',
                                       '-c', '-o', objs[-1], src])
        if r.returncode:
            sys.exit('%s does not compile:\n%s' % (src.name, r.stderr))
    archive, basics = d / 'libmccode-share.a', d / 'mcstas-basics.o'
    for r in (run([ar, 'rcs', archive] + objs),
              run([cc] + CFLAGS + inc + ['-c', '-o', basics, check / 'mcstas-basics.c'])):
        if r.returncode:
            sys.exit(r.stderr)

    # guard: every library linked in, no dead stripping, so an unresolved
    # symbol or duplicate global fails even where no test pulls it in
    (d / 'empty.c').write_text('int main(void) { return 0; }\n')
    whole = ['-Wl,-force_load,%s' % archive] if MACOS else \
            ['-Wl,--whole-archive', archive, '-Wl,--no-whole-archive']
    report('(link every library)', run([cc, '-o', d / 'empty', d / 'empty.c', basics] + whole + ['-lm']))

    for test in tests:
        with tempfile.TemporaryDirectory() as t:  # tests may write scratch files
            exe = pathlib.Path(t) / 'a.out'
            r = run([cc] + CFLAGS + inc + ['-DMCCODE_DATA_DIR="%s"' % (root / 'mcstas-comps' / 'data'),
                    '-o', exe, test, basics, '-L', d, '-lmccode-share', DEAD_STRIP, '-lm'])
            report(test.name, r if r.returncode else run([exe], cwd=t))

if failed:
    sys.exit('FAILED: %s' % ', '.join(failed))
