#!/usr/bin/env python3
'''
Compare McStas/McXtrace simulation speed for a component or instrument
between two commits/branches, each built into its own conda environment.

For every instrument matching --comp/--instr, this builds each ref, then runs
the existing mctest/mxtest tool against it (which compiles and runs each
instrument's own %Test line(s)), and reads the Init/Trace/Finally wall-clock
timing block that siminfo_close() writes to each run's mccode.sim. No source
patching is involved: the timing comes straight from mccode.sim.

By default both refs are built/tested directly in the conda/mamba/micromamba
environment that is already active. Pass --fresh-env to instead create (and
download packages into) a new environment per ref.

Usage: mccode-commit-speed-diff REF1 REF2 (--comp COMP | --instr PATTERN) [options]
'''
import argparse
import os
import pathlib
import re
import shutil
import statistics
import subprocess
import sys
import tempfile

if os.name == 'nt':
    try:
        import mslex as lexer
    except ImportError:
        import shlex as lexer
else:
    import shlex as lexer


def run(cmd, cwd=None, check=True, capture_output=False, timeout=None):
    print()
    print('LAUNCHING>>> %s' % lexer.join(str(c) for c in cmd))
    print()
    return subprocess.run(cmd, cwd=cwd, check=check, timeout=timeout,
                          capture_output=capture_output, text=capture_output)


def detect_reporoot():
    reporoot = pathlib.Path(__file__).parent.parent.parent
    if not reporoot.joinpath('CHANGES_McStas').is_file():
        return None
    return reporoot.absolute()


def autodetect_platform():
    import platform
    return {'Windows': 'win', 'Darwin': 'mac', 'Linux': 'linux'}[platform.system()]


def list_remotes(reporoot):
    out = run(['git', '-C', str(reporoot), 'remote'], capture_output=True).stdout
    return out.split()


def try_rev_parse(reporoot, ref):
    ''' returns the short sha for ref, or None if ref does not resolve '''
    r = run(['git', '-C', str(reporoot), 'rev-parse', '--short', ref],
           check=False, capture_output=True)
    return r.stdout.strip() if r.returncode == 0 else None


def resolve_sha(reporoot, ref):
    ''' resolves ref as given (sha/tag/already-qualified branch), or else as a
    bare branch name on one of the configured remotes (e.g. "main" -> the one
    remote - of lomholy/origin/upstream here - whose "main" branch exists) '''
    sha = try_rev_parse(reporoot, ref)
    if sha:
        return sha

    found = {}
    for remote in list_remotes(reporoot):
        candidate = '%s/%s' % (remote, ref)
        sha = try_rev_parse(reporoot, candidate)
        if sha:
            found.setdefault(sha, []).append(candidate)
    if not found:
        raise SystemExit('ERROR: Could not resolve ref %r, tried it as-is and as '
                         '<remote>/%s for remotes: %s' % (ref, ref, ', '.join(list_remotes(reporoot))))
    if len(found) > 1:
        detail = '; '.join('%s: %s' % (sha, ', '.join(names)) for sha, names in found.items())
        raise SystemExit('ERROR: Ambiguous ref %r resolves to different commits on different '
                         'remotes (%s) - qualify it, e.g. upstream/%s' % (ref, detail, ref))
    return next(iter(found))


def create_env_cmd(conda_exe, root_args, yml, envname):
    # micromamba has no "env" subcommand group for creation, only a flat 'create'
    if 'micromamba' in pathlib.Path(conda_exe).name.lower():
        return [conda_exe] + root_args + ['create', '-y', '-n', envname, '-f', str(yml)]
    return [conda_exe] + root_args + ['env', 'create', '-f', str(yml), '-n', envname]


def remove_env_cmd(conda_exe, root_args, envname):
    return [conda_exe] + root_args + ['env', 'remove', '-y', '-n', envname]


def run_in_env(conda_exe, root_args, envname, cmd, check=True, cwd=None, capture_output=False, timeout=None):
    return run([conda_exe] + root_args + ['run', '-n', envname] + cmd,
              check=check, cwd=cwd, capture_output=capture_output, timeout=timeout)


def require_active_conda_env():
    if not os.environ.get('CONDA_PREFIX'):
        raise SystemExit('ERROR: Building in the active environment requires a conda/mamba/'
                         'micromamba environment to already be activated ($CONDA_PREFIX is '
                         'unset). Pass --fresh-env to create one per ref instead.')


def run_cmd(cfg, envname, cmd, check=True, cwd=None, capture_output=False, timeout=None):
    # default: build/test directly in the environment this script itself runs
    # in, instead of spinning up (and downloading packages into) a fresh one
    if not cfg.fresh_env:
        return run(cmd, check=check, cwd=cwd, capture_output=capture_output, timeout=timeout)
    return run_in_env(cfg.conda_exe, cfg.root_args, envname, cmd,
                      check=check, cwd=cwd, capture_output=capture_output, timeout=timeout)


def build_ref(sha, reporoot, cfg, worktrees, envs):
    # worktrees/envs are appended to immediately after each resource is
    # created, not after this function returns, so a later failure in here
    # (e.g. the build itself) still leaves them registered for cleanup
    envname = 'mccode-commit-speed-diff-%s' % sha
    worktree = cfg.workdir / ('src_%s' % sha)

    run(['git', '-C', str(reporoot), 'worktree', 'add', '--detach', str(worktree), sha])
    worktrees.append(worktree)

    if cfg.fresh_env:
        yml = cfg.workdir / ('%s.yml' % sha)
        run([sys.executable, str(reporoot / 'devel' / 'bin' / 'mccode-create-conda-yml'),
             '-m', cfg.mode, '-p', cfg.platform, '-n', envname, '-o', str(yml), '-f'])
        run(remove_env_cmd(cfg.conda_exe, cfg.root_args, envname), check=False)
        run(create_env_cmd(cfg.conda_exe, cfg.root_args, yml, envname))
        envs.append(envname)

    run_cmd(cfg, envname,
           [sys.executable, str(worktree / 'devel' / 'bin' / 'mccode-build-conda'),
            '-m', cfg.mode, '-s', str(worktree)],
           timeout=cfg.timeout)

    return envname


# siminfo_close() in mccode-r.c writes this block to mccode.sim only when a run
# reached its normal end (see docs/GRAMMAR/ADR-records/ADR_20261105_RUNTIME_TIMING.md):
#
#   begin timing
#     Init: 0.01 [s]
#     Trace: 9.88 [s]
#     Finally: 0.02 [s]
#   end timing
TIMING_BLOCK_RE = re.compile(
    r'begin timing\s*\n'
    r'\s*Init:\s*([0-9.eE+-]+)\s*\[s\]\s*\n'
    r'\s*Trace:\s*([0-9.eE+-]+)\s*\[s\]\s*\n'
    r'\s*Finally:\s*([0-9.eE+-]+)\s*\[s\]\s*\n'
    r'\s*end timing')


def parse_timing(simfile):
    ''' returns {'INIT', 'TRACE', 'FINALLY'} in seconds, or None if simfile has no timing block '''
    text = simfile.read_text(encoding='utf-8', errors='replace')
    m = TIMING_BLOCK_RE.search(text)
    if not m:
        return None
    init, trace, finally_ = (float(g) for g in m.groups())
    return {'INIT': init, 'TRACE': trace, 'FINALLY': finally_}


def clear_test_runs(testdir):
    ''' remove mctest's per-test-number run output dirs, so a rerun does not hit its own cache '''
    for d in testdir.rglob('*'):
        if d.is_dir() and d.name.isdigit():
            shutil.rmtree(d, ignore_errors=True)


def mctest_supports(cfg, envname, testbin, flag):
    ''' each ref builds its own mctest, so its CLI flags can predate this script '''
    helptext = run_cmd(cfg, envname, [testbin, '--help'], capture_output=True).stdout
    return flag in helptext


def measure_ref(cfg, envname, sha):
    testbin = 'mctest' if cfg.mode == 'mcstas' else 'mxtest'
    testdir = cfg.workdir / ('%s_%s' % (cfg.label, sha))
    # no --no-mpi: omitting --mpi already means a single-node run, on every
    # mctest version this script supports
    cmd = [testbin, '--testdir', str(testdir), '--ncount', cfg.ncount, '--seed', cfg.seed,
           '--skipnontest', '--permissive']
    if mctest_supports(cfg, envname, testbin, '--uid'):
        # fixed, so mctest reuses the same (otherwise timestamped) label dir
        # and compiled binaries across repeats, instead of rebuilding each time
        cmd += ['--uid', cfg.label]
    cmd += ['--instr', cfg.instr] if cfg.instr else ['--comp', cfg.comp]

    results = {}
    simfiles_seen = 0
    for i in range(cfg.repeats):
        if i > 0:
            # keep the compiled binaries, only clear each test's run output so
            # mctest reruns it instead of treating it as already-done
            clear_test_runs(testdir)
        run_cmd(cfg, envname, cmd, check=False, timeout=cfg.timeout)
        for simfile in sorted(testdir.rglob('mccode.sim')):
            simfiles_seen += 1
            timing = parse_timing(simfile)
            if timing is None:
                continue
            key = (simfile.parent.parent.name, simfile.parent.name)
            entry = results.setdefault(key, {'INIT': [], 'TRACE': [], 'FINALLY': []})
            for metric, value in timing.items():
                entry[metric].append(value)

    if not results:
        if simfiles_seen:
            raise SystemExit('ERROR: %s wrote %d mccode.sim file(s) under %s, but none had a '
                             '"begin timing" block - this ref likely predates that feature in '
                             'mccode-r.c (siminfo_close), so its runs cannot be timed this way'
                             % (sha, simfiles_seen, testdir))
        raise SystemExit('ERROR: mctest produced no run at all for %s under %s '
                         '(check its run_stdout_*.txt files)' % (sha, testdir))
    return results


def display_name(key, results1, results2):
    ''' drop the test number unless this instrument has more than one %Test line '''
    instrname, testnb = key
    testnbs = {k[1] for k in set(results1) | set(results2) if k[0] == instrname}
    return instrname if len(testnbs) <= 1 else '%s (test %s)' % (instrname, testnb)


def print_report(label1, sha1, results1, label2, sha2, results2):
    headers = ['', '%s (%s) [s]' % (label1, sha1), '%s (%s) [s]' % (label2, sha2),
              'delta %% (%s vs %s)' % (label2, label1)]
    widths = [14, max(20, len(headers[1])), max(20, len(headers[2])), max(14, len(headers[3]))]

    def hline():
        print('-+-'.join('-' * w for w in widths))

    def row(cols):
        cells = ['%-*s' % (widths[0], cols[0])] + ['%*s' % (w, c) for w, c in zip(widths[1:], cols[1:])]
        print(' | '.join(cells))

    def datarow(name, v1, v2):
        delta = '%+.1f%%' % ((v2 - v1) / v1 * 100) if v1 else 'n/a'
        row([name, '%.2f' % v1, '%.2f' % v2, delta])

    for key in sorted(set(results1) | set(results2)):
        print()
        print(display_name(key, results1, results2))
        t1, t2 = results1.get(key), results2.get(key)
        if t1 is None or t2 is None:
            print('  only measured for %s' % (headers[2] if t1 is None else headers[1]))
            continue
        hline()
        row(headers)
        hline()
        datarow('init', statistics.mean(t1['INIT']), statistics.mean(t2['INIT']))
        datarow('trace', statistics.mean(t1['TRACE']), statistics.mean(t2['TRACE']))
        datarow('finally', statistics.mean(t1['FINALLY']), statistics.mean(t2['FINALLY']))
        hline()


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog=os.path.basename(argv[0]),
        description=('Measure McStas/McXtrace simulation speed for a component/instrument '
                     'against two commits, each built in its own conda environment.'))
    parser.add_argument('ref1', help='First commit/branch/tag ("before"). A bare branch name '
                                     '(e.g. "main") resolves against whichever configured remote '
                                     'has it, as its tip; ambiguous across remotes needs <remote>/<branch>')
    parser.add_argument('ref2', help='Second commit/branch/tag ("after", compared against ref1); see ref1')
    filt = parser.add_mutually_exclusive_group(required=True)
    filt.add_argument('--comp', help='Measure only instruments using this component')
    filt.add_argument('--instr', help='Measure only instruments matching this filter (regex)')
    parser.add_argument('-m', '--mode', choices=['mcstas', 'mcxtrace'], default='mcstas',
                        help='Choose McStas or McXtrace mode (default: mcstas)')
    reporoot = detect_reporoot()
    parser.add_argument('-s', '--srcdir', required=(not reporoot), default=reporoot,
                        help=('Source dir (required since reporoot not found)' if not reporoot
                              else 'Source dir (default: McCode repo root)'))
    parser.add_argument('--label', default='commit-speed-diff',
                        help="Name for the mctest/mxtest --testdir directory (default: 'commit-speed-diff')")
    parser.add_argument('--repeats', type=int, default=3,
                        help='Number of times to repeat the mctest run per ref (default: 3)')
    parser.add_argument('--ncount', default='1e6', help='ncount for the timed runs (default: 1e6)')
    parser.add_argument('--seed', default='1000', help='seed for the timed runs (default: 1000)')
    parser.add_argument('--timeout', type=int, default=3600,
                        help='Max seconds per build/mctest subprocess (default: 3600)')
    parser.add_argument('--workdir', default=None,
                        help='Where to put checkouts/env files (default: temporary directory)')
    parser.add_argument('--conda-exe', default='conda',
                        help='conda/mamba/micromamba executable to use (default: conda)')
    parser.add_argument('--conda-root', default=None,
                        help='Root prefix, passed as -r (needed by e.g. micromamba)')
    parser.add_argument('--fresh-env', action='store_true',
                        help=('Create a fresh conda environment per ref (the old default), '
                             'instead of building/testing both refs in the currently active '
                             'one. The active-env default skips package downloads, at the '
                             'cost of both refs sharing one environment (built/tested one '
                             'after the other, not in parallel).'))
    parser.add_argument('--keep-envs', action='store_true', help='Do not remove the conda environments afterwards')
    parser.add_argument('--keep-checkouts', action='store_true', help='Do not remove the git worktrees afterwards')

    args = parser.parse_args(argv[1:])
    args.platform = autodetect_platform()
    sd = pathlib.Path(args.srcdir)
    if not sd.is_dir():
        parser.error('Missing source dir: %s' % sd)
    args.srcdir = sd.absolute()
    return args


def create_cfg(args):
    class Cfg:
        mode = args.mode
        platform = args.platform
        conda_exe = args.conda_exe
        root_args = ['-r', args.conda_root] if args.conda_root else []
        fresh_env = args.fresh_env
        comp = args.comp
        instr = args.instr
        label = args.label
        repeats = args.repeats
        ncount = args.ncount
        seed = args.seed
        timeout = args.timeout
    return Cfg()


def main():
    args = parse_args(sys.argv)
    cfg = create_cfg(args)
    reporoot = args.srcdir
    if not cfg.fresh_env:
        require_active_conda_env()

    sha1 = resolve_sha(reporoot, args.ref1)
    sha2 = resolve_sha(reporoot, args.ref2)
    if sha1 == sha2:
        raise SystemExit('ERROR: ref1 and ref2 resolve to the same commit (%s)' % sha1)

    with tempfile.TemporaryDirectory() as tmp:
        cfg.workdir = pathlib.Path(args.workdir) if args.workdir else pathlib.Path(tmp)
        cfg.workdir.mkdir(parents=True, exist_ok=True)

        envs, worktrees = [], []
        try:
            results = {}
            # build then measure one ref at a time, so in the (default) active-env
            # mode each ref is measured against its own build, not whichever ref
            # was built most recently
            for ref, sha in ((args.ref1, sha1), (args.ref2, sha2)):
                envname = build_ref(sha, reporoot, cfg, worktrees, envs)
                results[sha] = measure_ref(cfg, envname, sha)

            print_report(args.ref1, sha1, results[sha1], args.ref2, sha2, results[sha2])
        finally:
            if not args.keep_envs and cfg.fresh_env:
                for envname in envs:
                    run(remove_env_cmd(cfg.conda_exe, cfg.root_args, envname), check=False)
            if not args.keep_checkouts:
                for wt in worktrees:
                    run(['git', '-C', str(reporoot), 'worktree', 'remove', '--force', str(wt)], check=False)


if __name__ == '__main__':
    main()
