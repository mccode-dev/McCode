#!/usr/bin/env python3
'''
Run mctest for a given component or instrument against two commits/branches
of the repo, each built into its own conda environment, then produce an
mcviewtest comparison report between the two runs.

This is the "two (re-)builds and mctest runs wrapped in extra logic" tool
requested on McCode PR #3029: point it at REF1/REF2 and a component or
instrument filter, and it hands back a diff report of REF2 against REF1.

Pass --active-env to build/test both refs directly in the conda/mamba/
micromamba environment that is already active, instead of creating (and
downloading packages into) a fresh one per ref.

Usage: mccode-commit-mctest REF1 REF2 (--comp COMP | --instr PATTERN) [options]
'''
import argparse
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

if os.name == 'nt':
    try:
        import mslex as lexer
    except ImportError:
        import shlex as lexer
else:
    import shlex as lexer


def run(cmd, cwd=None, check=True, capture_output=False):
    print()
    print('LAUNCHING>>> %s' % lexer.join(str(c) for c in cmd))
    print()
    return subprocess.run(cmd, cwd=cwd, check=check,
                          capture_output=capture_output, text=capture_output)


def detect_reporoot():
    reporoot = pathlib.Path(__file__).parent.parent.parent
    if not reporoot.joinpath('CHANGES_McStas').is_file():
        return None
    return reporoot.absolute()


def autodetect_platform():
    import platform
    return {'Windows': 'win', 'Darwin': 'mac', 'Linux': 'linux'}[platform.system()]


def resolve_sha(reporoot, ref):
    out = run(['git', '-C', str(reporoot), 'rev-parse', '--short', ref],
              capture_output=True).stdout.strip()
    if not out:
        raise SystemExit('ERROR: Could not resolve ref: %s' % ref)
    return out


def create_env_cmd(conda_exe, root_args, yml, envname):
    # micromamba has no "env" subcommand group for creation, only a flat 'create'
    if 'micromamba' in pathlib.Path(conda_exe).name.lower():
        return [conda_exe] + root_args + ['create', '-y', '-n', envname, '-f', str(yml)]
    return [conda_exe] + root_args + ['env', 'create', '-f', str(yml), '-n', envname]


def remove_env_cmd(conda_exe, root_args, envname):
    return [conda_exe] + root_args + ['env', 'remove', '-y', '-n', envname]


def run_in_env(conda_exe, root_args, envname, cmd, check=True):
    return run([conda_exe] + root_args + ['run', '-n', envname] + cmd, check=check)


def require_active_conda_env():
    if not os.environ.get('CONDA_PREFIX'):
        raise SystemExit('ERROR: --active-env requires a conda/mamba/micromamba '
                         'environment to already be activated ($CONDA_PREFIX is unset).')


def run_cmd(cfg, envname, cmd, check=True):
    # --active-env: build/test directly in the environment this script itself
    # runs in, instead of spinning up (and downloading packages into) a fresh one
    if cfg.active_env:
        return run(cmd, check=check)
    return run_in_env(cfg.conda_exe, cfg.root_args, envname, cmd, check=check)


def build_and_test(ref, reporoot, cfg):
    sha = resolve_sha(reporoot, ref)
    envname = 'mccode-commit-mctest-%s' % sha
    worktree = cfg.workdir / ('src_%s' % sha)

    run(['git', '-C', str(reporoot), 'worktree', 'add', '--detach', str(worktree), sha])

    if not cfg.active_env:
        yml = cfg.workdir / ('%s.yml' % sha)
        run([sys.executable, str(reporoot / 'devel' / 'bin' / 'mccode-create-conda-yml'),
             '-m', cfg.mode, '-p', cfg.platform, '-n', envname, '-o', str(yml), '-f'])
        run(remove_env_cmd(cfg.conda_exe, cfg.root_args, envname), check=False)
        run(create_env_cmd(cfg.conda_exe, cfg.root_args, yml, envname))

    run_cmd(cfg, envname,
           [sys.executable, str(worktree / 'devel' / 'bin' / 'mccode-build-conda'),
            '-m', cfg.mode, '-s', str(worktree)])

    testbin = 'mctest' if cfg.mode == 'mcstas' else 'mxtest'
    testcmd = [testbin, '--testdir', str(cfg.testdir), '--uid', sha]
    if cfg.comp:
        testcmd += ['--comp', cfg.comp]
    if cfg.instr:
        testcmd += ['--instr', cfg.instr]
    testcmd += cfg.extra_mctest_args
    # mctest exits non-zero on test failures/discrepancies - that is a result
    # to report, not a failure of this wrapper, so don't abort the script on it
    run_cmd(cfg, envname, testcmd, check=False)

    labeldirs = [d.name for d in cfg.testdir.iterdir() if sha in d.name]
    if len(labeldirs) != 1:
        raise SystemExit('ERROR: Expected exactly one mctest result folder for '
                         '%s under %s, found: %s' % (sha, cfg.testdir, labeldirs))

    return sha, envname, worktree, labeldirs[0]


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog=os.path.basename(argv[0]),
        description=('Run mctest for a component/instrument against two commits, '
                     'each built in its own conda environment, and diff the results.'))
    parser.add_argument('ref1', help='First commit/branch/tag (used as mcviewtest reference)')
    parser.add_argument('ref2', help='Second commit/branch/tag (compared against ref1)')
    filt = parser.add_mutually_exclusive_group(required=True)
    filt.add_argument('--comp', help='Test only instruments using this component')
    filt.add_argument('--instr', help='Test only instruments matching this filter (regex)')
    parser.add_argument('-m', '--mode', choices=['mcstas', 'mcxtrace'], default='mcstas',
                        help='Choose McStas or McXtrace mode (default: mcstas)')
    reporoot = detect_reporoot()
    parser.add_argument('-s', '--srcdir', required=(not reporoot), default=reporoot,
                        help=('Source dir (required since reporoot not found)' if not reporoot
                              else 'Source dir (default: McCode repo root)'))
    parser.add_argument('--testdir', default=None,
                        help='Where to put mctest results (default: temporary directory)')
    parser.add_argument('--workdir', default=None,
                        help='Where to put checkouts/env files (default: temporary directory)')
    parser.add_argument('--conda-exe', default='conda',
                        help='conda/mamba/micromamba executable to use (default: conda)')
    parser.add_argument('--conda-root', default=None,
                        help='Root prefix, passed as -r (needed by e.g. micromamba)')
    parser.add_argument('--active-env', action='store_true',
                        help=('Build/test both refs directly in the currently active conda '
                             'environment instead of creating a fresh one per ref. Skips '
                             'package downloads, at the cost of both refs sharing one '
                             'environment (built/tested one after the other, not in parallel).'))
    parser.add_argument('--keep-envs', action='store_true', help='Do not remove the conda environments afterwards')
    parser.add_argument('--keep-checkouts', action='store_true', help='Do not remove the git worktrees afterwards')

    # args after a literal '--' are passed through to mctest verbatim, e.g.
    # mccode-commit-mctest main feature --comp Foo -- --ncount 1e7
    own_argv, extra = argv, []
    if '--' in argv:
        i = argv.index('--')
        own_argv, extra = argv[:i], argv[i + 1:]

    args = parser.parse_args(own_argv[1:])
    args.extra_mctest_args = extra
    args.platform = autodetect_platform()
    sd = pathlib.Path(args.srcdir)
    if not sd.is_dir():
        parser.error('Missing source dir: %s' % sd)
    args.srcdir = sd.absolute()
    return args


def create_cfg(args):
    class Cfg:
        mode = args.mode
        platform = args.platform
        conda_exe = args.conda_exe
        root_args = ['-r', args.conda_root] if args.conda_root else []
        active_env = args.active_env
        extra_mctest_args = args.extra_mctest_args
        comp = args.comp
        instr = args.instr
    return Cfg()


def main():
    args = parse_args(sys.argv)
    cfg = create_cfg(args)
    reporoot = args.srcdir
    if cfg.active_env:
        require_active_conda_env()

    with tempfile.TemporaryDirectory() as tmp:
        cfg.workdir = pathlib.Path(args.workdir) if args.workdir else pathlib.Path(tmp)
        cfg.workdir.mkdir(parents=True, exist_ok=True)
        cfg.testdir = pathlib.Path(args.testdir) if args.testdir else pathlib.Path(tmp) / 'mctest-results'
        cfg.testdir.mkdir(parents=True, exist_ok=True)

        envs, worktrees = [], []
        try:
            sha1, env1, wt1, label1 = build_and_test(args.ref1, reporoot, cfg)
            envs.append(env1)
            worktrees.append(wt1)
            sha2, env2, wt2, label2 = build_and_test(args.ref2, reporoot, cfg)
            envs.append(env2)
            worktrees.append(wt2)

            if sha1 == sha2:
                raise SystemExit('ERROR: ref1 and ref2 resolve to the same commit (%s)' % sha1)

            viewbin = 'mcviewtest' if cfg.mode == 'mcstas' else 'mxviewtest'
            run_cmd(cfg, env2, [viewbin, str(cfg.testdir), '--reflabel', label1, '--nobrowse'])

            ofile = cfg.testdir / ('%s_output.html' % cfg.testdir.name)
            print()
            print('REF1 %s -> label %s' % (args.ref1, label1))
            print('REF2 %s -> label %s' % (args.ref2, label2))
            print('Comparison report: %s' % ofile)
        finally:
            if not args.keep_envs and not cfg.active_env:
                for envname in envs:
                    run(remove_env_cmd(cfg.conda_exe, cfg.root_args, envname), check=False)
            if not args.keep_checkouts:
                for wt in worktrees:
                    run(['git', '-C', str(reporoot), 'worktree', 'remove', '--force', str(wt)], check=False)


if __name__ == '__main__':
    main()
